{
  // The workspace's compiler options and its project list (third-pass audit AR1).
  //
  // This file holds no source files of its own. `pnpm typecheck` is `tsc -b`, which builds the
  // projects below in order and skips any whose inputs have not changed:
  //
  //   tsconfig.core.json    lib/core, lib/contract, lib/shared and four files: imports nothing else
  //   tsconfig.engine.json  the Source-engine port (AR4): imports itself and core
  //   tsconfig.site.json    everything else: imports both through their declarations
  //
  // A bare `tsc --noEmit` here checks nothing, because `files` is empty. Use `pnpm typecheck`.
  // Every other tsconfig extends this one for `compilerOptions`; Vite, esbuild, tsx and the eslint
  // import resolver read `paths` from here. lib/__tests__/tsconfig-projects.test.ts holds that every
  // source file belongs to exactly one project.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@features/*": ["./features/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.engine.json" },
    { "path": "./tsconfig.site.json" }
  ]
}
