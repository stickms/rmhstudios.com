# rmhOS relay hub egress firewall — systemd one-shot.
#
# WHY THIS EXISTS: the rmhos-net container dials the internet for strangers and is
# only safe behind the iptables drops in deploy/rmhos-net/egress-firewall.sh. The CD
# deploy runs sandboxed (NoNewPrivileges, ProtectSystem=strict), so it cannot apply
# them; it only PROBES (deploy/rmhos-net/probe-firewall.sh) and starts the hub when
# the drops are proven to be in place. Without this unit installed the deploy leaves
# the hub stopped and prints a warning. Ordered Before=docker.service so the rules
# exist before any container can, including after a reboot.
#
# ── Install (once, as root) ──────────────────────────────────────────────────
#   1. Edit ExecStart so the path matches where this repo lives on the VPS
#      (the same dir deploy.sh runs from).
#   2. sudo cp deploy/systemd/rmhos-net-firewall.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#   3. sudo systemctl enable --now rmhos-net-firewall.service
#   4. Verify:  systemctl status rmhos-net-firewall.service
#               sudo iptables -S RMHOS-EGRESS
#      Re-run after editing the script:  sudo systemctl restart rmhos-net-firewall.service
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=rmhOS relay hub egress firewall (iptables)
Documentation=file:deploy/rmhos-net/egress-firewall.sh
Before=docker.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /home/rmhstudios/rmhstudios.com/deploy/rmhos-net/egress-firewall.sh
User=root

[Install]
WantedBy=multi-user.target
