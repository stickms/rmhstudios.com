h-[42px] shrink-0 items-center"><button type="button" aria-label="Add emoji" aria-expanded="false" class="p-1.5 transition-colors text-site-text-dim hover:text-site-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-face-slightly-smiling lucide-smile w-5 h-5" aria-hidden="true"><path d="M15 10V9"></path><path d="M16.472 15a6 6 0 01-8.943 0"></path><path d="M9 10V9"></path><circle cx="12" cy="12" r="10"></circle></svg></button></div><div class="relative shrink-0"><button type="button" aria-label="Add to message" aria-haspopup="menu" aria-expanded="false" disabled="" class="h-[42px] rounded-site px-3 text-site-text-dim transition-colors hover:bg-site-surface-hover hover:text-site-accent disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle lucide-loader-2 h-4 w-4 animate-spin" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg></button></div><div data-stub="VoiceComposer" data-props="{&quot;conversationId&quot;:&quot;c1&quot;,&quot;onSent&quot;:&quot;[fn]&quot;,&quot;onActiveChange&quot;:&quot;[fn]&quot;,&quot;disabled&quot;:true}"></div><button data-slot="button" data-variant="accent" data-jelly-rest="flat" data-size="sm" data-fluid-press="" class="relative inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-[var(--site-control-radius)] border border-transparent text-sm tracking-[-0.01em] disabled:pointer-events-none disabled:opacity-45 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 aria-invalid:ring-site-danger/30 aria-invalid:border-site-danger font-semibold text-site-accent hover:text-site-accent-hover gap-1.5 has-[&gt;svg]:px-3.5 