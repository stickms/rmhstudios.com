tive flex h-[42px] shrink-0 items-center"><button type="button" aria-label="Add emoji" aria-expanded="false" class="p-1.5 transition-colors text-site-text-muted hover:text-site-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-face-slightly-smiling lucide-smile w-5 h-5" aria-hidden="true"><path d="M15 10V9"></path><path d="M16.472 15a6 6 0 01-8.943 0"></path><path d="M9 10V9"></path><circle cx="12" cy="12" r="10"></circle></svg></button></div><div class="relative shrink-0"><button type="button" aria-label="Add to message" aria-haspopup="menu" aria-expanded="false" class="h-[42px] rounded-site px-3 text-site-text-muted transition-colors hover:bg-site-surface-hover hover:text-site-accent disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-5 w-5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><div data-stub="VoiceComposer" data-props="{&quot;conversationId&quot;:&quot;c1&quot;,&quot;onSent&quot;:&quot;[fn]&quot;,&quot;onActiveChange&quot;:&quot;[fn]&quot;,&quot;disabled&quot;:true}"></div><button data-slot="button" data-variant="primary" data-size="default" class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-site border border-transparent text-sm font-medium transition-[background-color,border-color,color,opacity] duration-(--m1) ease-[ease] disabled:pointer-events-none disabled:opacity-45 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 aria-invalid:border-site-danger bg-site-accent text-site-accent-fg hover:opacity-88 px-4 pointer-coarse:h-11 has-[&gt;svg]:px-3 h-[42px]" disabled=""><span data-slot="button-label" class="contents">Send</span></button></div></div><div data-stub="ChatPlusHost" data-props="{&quot;viewerId&quot;:&quot;me&quot;}"></div></div>"`;

