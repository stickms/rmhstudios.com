exports[`ConversationView characterization > signed out 1`] = `"<div class="flex flex-col items-center justify-center px-4 pt-4 pb-12 text-center"><p class="text-lg font-medium text-site-text mb-2">Sign in to view messages</p><a href="/login"><button data-slot="button" data-variant="accent" data-jelly-rest="flat" data-size="sm" data-fluid-press="" class="relative inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-[var(--site-control-radius)] border border-transparent text-sm tracking-[-0.01em] disabled:pointer-events-none disabled:opacity-45 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 aria-invalid:ring-site-danger/30 aria-invalid:border-site-danger font-semibold text-site-accent hover:text-site-accent-hover h-9 gap-1.5 px-4.5 has-[&gt;svg]:px-3.5"><span data-slot="button-label" class="contents">Sign in</span></button></a></div>"`;

