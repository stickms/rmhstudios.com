exports[`GroupChatView characterization > a poll draft alone enables sending 1`] = `"<div class="conversation" style="--chat-accent:teal"><header class="conversation__head"><a href="/messages" class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-site border border-transparent text-sm font-medium transition-[background-color,border-color,color,opacity] duration-(--m1) ease-[ease] disabled:pointer-events-none disabled:opacity-45 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 aria-invalid:border-site-danger text-site-text hover:bg-site-bg-subtle size-9 pointer-coarse:size-11"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left rtl:-scale-x-100" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></a><div class="min-w-0 flex-1"><h1 class="t-body truncate font-semibold text-site-text">Crew</h1><p class="t-meta truncate">3 members</p></div><div data-stub="FindATimeLink" data-props="{&quot;groupChatId&quot;:&quot;g1&quot;}"></div><div data-stub="ChatHeaderPlus" data-props="{&quot;chat&quot;:{&quot;kind&quot;:&quot;group&quot;,&quot;id&quot;:&quot;g1&quot;}}"></div><button data-slot="button" data-variant="ghost" data-size="icon" class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-site border border-transparent text-sm font-medium transition-[background-color,border-color,color,opacity] duration-(--m1) ease-[ease] disabled:pointer-events-none disabled:opacity-45 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [&amp;_svg]:shrink-0 aria-invalid:border-site-danger text-site-text hover:bg-site-bg-subtle size-9 pointer-coarse:size-11" title="Leave group" aria-label="Leave group"><svg xmlns="http://www.w3.org/2000/