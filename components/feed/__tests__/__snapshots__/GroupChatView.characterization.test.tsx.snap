utton" class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-site-accent hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> <!-- -->Add option</button></div><div class="conversation__composer"><div class="flex flex-wrap items-end gap-2"><input type="file" accept="image/*" multiple="" class="hidden"/><div class="relative"><button type="button" aria-label="Add to message" aria-haspopup="menu" aria-expanded="false" class="flex h-9 w-9 items-center justify-center rounded-full text-site-text-muted hover:bg-site-accent/10 hover:text-site-accent disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-5 w-5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><div data-stub="EmojiPickerButton" data-props="{&quot;direction&quot;:&quot;up&quot;,&quot;onSelect&quot;:&quot;[fn]&quot;,&quot;className&quot;:&quot;flex h-9 items-center&quot;}"></div><div data-stub="ChecklistComposer" data-props="{&quot;chat&quot;:{&quot;kind&quot;:&quot;group&quot;,&quot;id&quot;:&quot;g1&quot;},&quot;onPosted&quot;:&quot;[fn]&quot;,&quot;disabled&quot;:false}"></div><div class="order-first min-w-full flex-1 sm:order-none sm:min-w-0"><div data-stub="slash-popover"></div><div data-stub="MentionTextarea" data-props="{&quot;value&quot;:&quot;&quot;,&quot;onChange&quot;:&quot;[fn]&quot;,&quot;priorityUsers&quot;:[{&quot;id&quot;:&quot;me&quot;,&quot;name&quot;:&quot;Me Myself&quot;,&quot;image&quot;:&quot;/me.png&quot;,&quot;handle&quot;:&quot;me_m&quot;,&quot;username&quot;:&quot;me_m&quot;},{&quot;id&quot;:&quot;ana&