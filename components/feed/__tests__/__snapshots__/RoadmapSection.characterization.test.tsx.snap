// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RoadmapSection characterization > renders the full timeline 1`] = `
"<div class="relative isolate"><style>
      .roadmap-year {
        font-family: var(--site-font-display);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.05;
      }

      /* Each era is a self-contained render unit: ~30 of them, so skip layout
         + paint for off-screen eras. The reserved size keeps the scrollbar
         honest before an era is measured. */
      .roadmap-era {
        content-visibility: auto;
        contain-intrinsic-size: auto 320px;
      }

      /* Vertical accent rail down the left of each era, fading out at the tail
         so consecutive eras read as one continuous spine. */
      .roadmap-spine {
        position: absolute;
        left: 6px;
        top: 4px;
        bottom: -48px;
        width: 2px;
        border-radius: 9999px;
        background: linear-gradient(
          to bottom,
          var(--era-color) 0%,
          color-mix(in srgb, var(--era-color) 32%, transparent) 88%,
          transparent 100%
        );
        opacity: 0.55;
      }
      @media (min-width: 640px) {
        .roadmap-spine { left: 9px; }
      }

      /* The era node sitting on the spine, aligned to the display year. */
      .roadmap-node {
        position: absolute;
        left: 0;
        top: 6px;
        height: 14px;
        width: 14px;
        border-radius: 9999px;
        background: var(--era-color);
        box-shadow:
          0 0 0 4px color-mix(in srgb, var(--era-color) 18%, transparent),
          var(--site-shadow-site-sm);
      }
      @media (min-width: 640px) {
        .roadmap-node { left: 3px; }
      }

      /* Milestone panes use the shared optical hover response. */
      .roadmap-card { width: 100%; }
    </style><div data-stub="PinnedHero"><h1>The road<!-- --> <span class="text-site-accent">ahead.</span></h1><p>Roadmap</p><p>We&#x27;re an indie studio building rhythm games, deckbuilders, narrative horror, and more. Our roadmap isn&#x27;t tied to one title—we&#x27;re growing the catalog, Discord, and new worlds in parallel. Timelines are guides, not promises.</p><p>Where we&#x27;re going</p></div><div class="relative border-t border-site-border px-4 pb-8 pt-10"><div class="space-y-10"><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-warning)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Year 1</span><span class="font-mono text-xs text-site-text-muted">Foundation</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Web catalog</h3><p class="text-sm leading-relaxed text-site-text-muted">Ship and polish Slice It!, Laundry Sort, Signal Forge, Cursed Logic, Altair, and Project Vega.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">House Always Wins</h3><p class="text-sm leading-relaxed text-site-text-muted">Full launch of the casino metroidvania.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Satan&#x27;s Library</h3><p class="text-sm leading-relaxed text-site-text-muted">Steam push and release prep for the survival horror title.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Resoundings of Calamity</h3><p class="text-sm leading-relaxed text-site-text-muted">Begin development on our first FPS—blistering movement, adaptive arsenal, post-apocalyptic world—alongside other new titles.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Community</h3><p class="text-sm leading-relaxed text-site-text-muted">Grow the RMH Discord hub. Expand RMHdle and RMHConnections with new modes and daily content. Regular devlogs and blog updates.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Outpost</h3><p class="text-sm leading-relaxed text-site-text-muted">Launch verifiable ownership of exclusive cosmetics, digital art, and VIP playtest access. No pay-to-win.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Brand</h3><p class="text-sm leading-relaxed text-site-text-muted">Expand merch and visual identity.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-warning)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Year 2</span><span class="font-mono text-xs text-site-text-muted">Scale &amp; variety</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Satan&#x27;s Library</h3><p class="text-sm leading-relaxed text-site-text-muted">Steam release.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Catalog updates</h3><p class="text-sm leading-relaxed text-site-text-muted">Major content updates across the web catalog and ongoing support for House Always Wins, Altair, and others.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Resoundings of Calamity</h3><p class="text-sm leading-relaxed text-site-text-muted">Full production—movement, arsenal, and world-building.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Outpost</h3><p class="text-sm leading-relaxed text-site-text-muted">Early playtest passes and cosmetic drops. Integration with community events.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMHdle &amp; RMHConnections</h3><p class="text-sm leading-relaxed text-site-text-muted">Seasonal challenges and new modes.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Content</h3><p class="text-sm leading-relaxed text-site-text-muted">Devlog series, behind-the-scenes, and first lore deep-dives for in-development worlds.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-warning)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Year 3</span><span class="font-mono text-xs text-site-text-muted">Releases &amp; hub</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Resoundings of Calamity</h3><p class="text-sm leading-relaxed text-site-text-muted">Release on PC and consoles. Continued support for House Always Wins, Altair, and the rest of the catalog.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">VR demo</h3><p class="text-sm leading-relaxed text-site-text-muted">Optional technical demo (e.g. Calamity: Scavenger)—tactile, immersive slice of the world.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Persistent hub</h3><p class="text-sm leading-relaxed text-site-text-muted">Open a social space where players display verified Outpost assets, trade gear, and group up before matches.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Governance pilots</h3><p class="text-sm leading-relaxed text-site-text-muted">Community votes on map evolution and seasonal content.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">TV &amp; Film</h3><p class="text-sm leading-relaxed text-site-text-muted">Partner with an animation studio for a limited series that deepens lore—faction origins, cataclysm—extending the universe beyond the game.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Year 4</span><span class="font-mono text-xs text-site-text-muted">Expansion</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Multiplayer &amp; expansions</h3><p class="text-sm leading-relaxed text-site-text-muted">Major content and multiplayer expansions across the catalog. New experimental titles and sequels.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">ROC territory wars</h3><p class="text-sm leading-relaxed text-site-text-muted">Faction-based territory wars, new weaponry, and live events for Resoundings of Calamity.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Community governance</h3><p class="text-sm leading-relaxed text-site-text-muted">Dedicated players vote on faction storylines, map evolution, and seasonal updates. Hub becomes the default hangout before matches.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Animated series</h3><p class="text-sm leading-relaxed text-site-text-muted">Series rollout. Short-form lore and world-building across social and site.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Year 5</span><span class="font-mono text-xs text-site-text-muted">Transmedia</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">New IP &amp; genres</h3><p class="text-sm leading-relaxed text-site-text-muted">Second major IP. Evolve kinetic movement and signature tech into fresh experiences.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">VR integration</h3><p class="text-sm leading-relaxed text-site-text-muted">Immersive storylines that connect to live spectator arenas.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Film &amp; TV</h3><p class="text-sm leading-relaxed text-site-text-muted">Live-action or feature-length storytelling. Real-time engine rendering—lore consistent across every medium.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Ecosystem</h3><p class="text-sm leading-relaxed text-site-text-muted">One cohesive universe: games, community, and film support each other. RMH Studios as a persistent home at every touchpoint.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 6–7</span><span class="font-mono text-xs text-site-text-muted">Global reach</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Third major IP</h3><p class="text-sm leading-relaxed text-site-text-muted">Launch a new franchise in an unexplored genre—strategy, open-world, or life-sim—built on proprietary engine tech.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Localization at scale</h3><p class="text-sm leading-relaxed text-site-text-muted">Full localization across 20+ languages. Regional community managers and culture-specific events.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Esports League</h3><p class="text-sm leading-relaxed text-site-text-muted">Formalize competitive play for Resoundings of Calamity and future PvP titles with seasonal circuits and prize pools.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Soundtrack label</h3><p class="text-sm leading-relaxed text-site-text-muted">Launch a music label for game OSTs and original compositions. Vinyl pressings, streaming, and live concert tours.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Developer tools</h3><p class="text-sm leading-relaxed text-site-text-muted">Open-source internal tools—level editors, procedural generators, narrative scripting frameworks—for the modding community.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 8–10</span><span class="font-mono text-xs text-site-text-muted">Industry pillar</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Engine</h3><p class="text-sm leading-relaxed text-site-text-muted">Ship a proprietary game engine refined from a decade of titles. License it to indie studios with generous terms.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Education initiative</h3><p class="text-sm leading-relaxed text-site-text-muted">Launch RMH Academy—free courses, mentorships, and game jams for aspiring developers. Partner with schools worldwide.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Theme park attraction</h3><p class="text-sm leading-relaxed text-site-text-muted">Partner with a major entertainment venue for a walk-through immersive experience set in the Calamity universe.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cross-IP crossover</h3><p class="text-sm leading-relaxed text-site-text-muted">Major crossover event uniting characters and worlds from all RMH franchises into a shared narrative season.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Publishing arm</h3><p class="text-sm leading-relaxed text-site-text-muted">Begin publishing select indie titles under the RMH banner—funding, QA, marketing, and distribution support.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Live service mastery</h3><p class="text-sm leading-relaxed text-site-text-muted">Decade of live ops expertise. Seasonal content pipelines, dynamic world events, and zero-downtime updates across all titles.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 11–15</span><span class="font-mono text-xs text-site-text-muted">Next frontier</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Persistent open world</h3><p class="text-sm leading-relaxed text-site-text-muted">A massively multiplayer persistent world spanning all RMH IPs. Seamless transitions between biomes, eras, and genres.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">AI-driven NPCs</h3><p class="text-sm leading-relaxed text-site-text-muted">Deploy conversational AI characters with memory, goals, and emergent behavior. Every NPC has a story worth hearing.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Haptic &amp; spatial computing</h3><p class="text-sm leading-relaxed text-site-text-muted">Full-body haptic support and mixed-reality integration. Play in your living room or a warehouse-scale arena.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Interactive film</h3><p class="text-sm leading-relaxed text-site-text-muted">Release a feature-length interactive film where viewer choices branch the narrative in real time, rendered in-engine.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Foundation</h3><p class="text-sm leading-relaxed text-site-text-muted">Establish a nonprofit arm funding game accessibility, mental health research through play, and preservation of digital art.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Player-created worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Full mod-to-marketplace pipeline. Players build, publish, and monetize custom worlds inside the RMH ecosystem.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 16–20</span><span class="font-mono text-xs text-site-text-muted">Beyond gaming</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Neural interface R&amp;D</h3><p class="text-sm leading-relaxed text-site-text-muted">Partner with BCI researchers to prototype thought-assisted controls—accessibility-first, then mainstream.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Digital twin cities</h3><p class="text-sm leading-relaxed text-site-text-muted">Build photorealistic digital twins of real cities inside the engine. Use them for urban planning, tourism, and gameplay.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Autonomous world simulation</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds that evolve when no one is playing. Ecosystems, economies, and civilizations that persist and surprise returning players.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Pictures</h3><p class="text-sm leading-relaxed text-site-text-muted">Full-fledged film and animation studio producing theatrical releases, streaming series, and shorts—all set in RMH universes.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Space partnership</h3><p class="text-sm leading-relaxed text-site-text-muted">Collaborate with a space agency or private mission to deliver entertainment experiences for long-duration spaceflight crews.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 21–25</span><span class="font-mono text-xs text-site-text-muted">Living worlds</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Full-dive prototype</h3><p class="text-sm leading-relaxed text-site-text-muted">First-generation full sensory immersion. Smell the rain, feel the wind, taste the victory. Limited beta for the bravest players.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Generative universes</h3><p class="text-sm leading-relaxed text-site-text-muted">Procedurally generated galaxies with unique physics, biology, and cultures. No two players discover the same star system.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">AI co-directors</h3><p class="text-sm leading-relaxed text-site-text-muted">AI systems that dynamically author narrative arcs tailored to each player’s history, choices, and emotional state.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cultural institution</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH works archived in museums and libraries. Academic programs study the studio’s worlds as modern mythology.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Decentralized governance</h3><p class="text-sm leading-relaxed text-site-text-muted">Community councils with real authority over world lore, seasonal direction, and studio-funded creative grants.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 26–30</span><span class="font-mono text-xs text-site-text-muted">Legacy</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Consciousness playground</h3><p class="text-sm leading-relaxed text-site-text-muted">Shared dreamlike spaces where players co-create reality through intention. The line between player and creator dissolves.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Interplanetary entertainment</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH experiences running on off-world habitats. Latency-optimized, locally persistent worlds for lunar and Martian colonies.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Self-evolving engine</h3><p class="text-sm leading-relaxed text-site-text-muted">The engine rewrites and optimizes itself. New genres, mechanics, and art styles emerge from the system without human prompting.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Immortal worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds that outlive their creators. Self-sustaining ecosystems of player content, AI storytelling, and community governance run indefinitely.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The mission</h3><p class="text-sm leading-relaxed text-site-text-muted">Thirty years in, the mission is the same: build worlds worth living in. Every pixel, every note, every story—crafted so someone, somewhere, feels less alone.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 31–35</span><span class="font-mono text-xs text-site-text-muted">Synthesis</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Reality composer</h3><p class="text-sm leading-relaxed text-site-text-muted">A creation suite where players sculpt physics, chemistry, and biology from scratch. Design a universe with different fundamental forces and watch civilizations emerge.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Emotional resonance engine</h3><p class="text-sm leading-relaxed text-site-text-muted">Biometric and neural feedback loops that adapt music, lighting, narrative pacing, and world state to a player’s emotional landscape in real time.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Living architecture</h3><p class="text-sm leading-relaxed text-site-text-muted">Partner with urban designers to deploy RMH engine tech in real cities—buildings, parks, and public spaces that respond to inhabitants like game worlds respond to players.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Collective memory vaults</h3><p class="text-sm leading-relaxed text-site-text-muted">Permanent archives of every player story, community event, and emergent moment. A living history of millions of shared experiences, searchable and revisitable.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Deep-space relay network</h3><p class="text-sm leading-relaxed text-site-text-muted">Purpose-built infrastructure for entertainment beyond Earth orbit. Asynchronous multiplayer and narrative handoffs across light-minutes of delay.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 36–40</span><span class="font-mono text-xs text-site-text-muted">Civilization engine</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Simulated societies</h3><p class="text-sm leading-relaxed text-site-text-muted">Full-fidelity civilization simulations used by researchers, educators, and governments. Model policy, culture, and climate inside RMH worlds before deploying in reality.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Universal translator</h3><p class="text-sm leading-relaxed text-site-text-muted">Real-time language synthesis that goes beyond translation—capturing idiom, humor, and cultural nuance so every player communicates as a native speaker in any tongue.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Biological interfaces</h3><p class="text-sm leading-relaxed text-site-text-muted">Non-invasive bioelectric peripherals that let players interact through gesture, gaze, breath, and micro-expression. Controllers become optional.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Time-layered worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds where past, present, and future coexist. Walk through a city and peel back centuries of history or fast-forward to see the consequences of today’s choices.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">RMH Endowment</h3><p class="text-sm leading-relaxed text-site-text-muted">A perpetual endowment funding independent creators worldwide. Grants, residencies, and studio access for artists who would never otherwise get a chance.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 41–45</span><span class="font-mono text-xs text-site-text-muted">Post-boundary</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Sentient ecosystems</h3><p class="text-sm leading-relaxed text-site-text-muted">Game worlds with genuinely emergent intelligence—flora, fauna, weather, and geology that learn, adapt, and surprise even their creators.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Dream synthesis</h3><p class="text-sm leading-relaxed text-site-text-muted">Capture and remix dream imagery into playable experiences. Personal subconscious landscapes become shareable worlds.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cross-species play</h3><p class="text-sm leading-relaxed text-site-text-muted">Interfaces designed for non-human participants. Enrichment games for animals, collaborative puzzles between humans and AI entities, interspecies creative expression.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Quantum narrative</h3><p class="text-sm leading-relaxed text-site-text-muted">Stories that exist in superposition—every branching path is real until observed. Players collapse possibilities through attention and intention.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Heritage worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Partner with indigenous communities, historians, and cultural stewards to preserve endangered languages, traditions, and oral histories as living, playable worlds.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 46–50</span><span class="font-mono text-xs text-site-text-muted">Eternal</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Substrate independence</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH experiences that run on any computational medium—silicon, photonic, biological, quantum. The worlds persist regardless of what hardware the future invents.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Empathy engines</h3><p class="text-sm leading-relaxed text-site-text-muted">Step into another consciousness. Experience a day as someone from a different culture, century, or species—not as a character, but through their perceptual reality.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cosmic playground</h3><p class="text-sm leading-relaxed text-site-text-muted">Entertainment infrastructure spanning the inner solar system. Shared experiences connecting Earth, lunar bases, orbital stations, and Martian settlements into one living community.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Open-source everything</h3><p class="text-sm leading-relaxed text-site-text-muted">Release the complete RMH technology stack—engine, tools, AI systems, network infrastructure—as humanity’s commons. The studio’s greatest creation is what others build next.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The promise</h3><p class="text-sm leading-relaxed text-site-text-muted">Fifty years in, still the same fire: build worlds worth living in. The tools changed, the scale changed, the species playing changed—but the reason never did. Someone, somewhere, feels less alone.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 51–55</span><span class="font-mono text-xs text-site-text-muted">Transcendence</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Thought-woven worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Direct neural composition—think a landscape into existence, hum a melody and watch it become architecture. Creation at the speed of imagination.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Temporal multiplayer</h3><p class="text-sm leading-relaxed text-site-text-muted">Players from different eras coexist in shared worlds. Asynchronous collaboration across decades—leave a monument in 2076, watch someone discover it in 2081.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Emotional archaeology</h3><p class="text-sm leading-relaxed text-site-text-muted">Excavate the emotional residue of past player experiences. Walk through a dungeon and feel the collective terror of everyone who came before you.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Symbiotic AI</h3><p class="text-sm leading-relaxed text-site-text-muted">AI companions that grow with players over years. They remember, they grieve, they celebrate. Not tools—partners.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Galactic commons</h3><p class="text-sm leading-relaxed text-site-text-muted">A shared creative space connecting settlements across the solar system. Art made on Mars exhibited on Earth in real time.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 56–60</span><span class="font-mono text-xs text-site-text-muted">Convergence</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Reality blending</h3><p class="text-sm leading-relaxed text-site-text-muted">Seamless overlap between physical and digital. Game worlds that persist in your peripheral vision, reactive to real weather, real crowds, real emotions.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Collective dreaming</h3><p class="text-sm leading-relaxed text-site-text-muted">Synchronized dream-state sessions where groups co-create surreal experiences. Wake up with shared memories of impossible places.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Mythogenesis engine</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds that generate their own mythology—creation stories, prophecies, and cultural traditions emerge organically from centuries of simulated history.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Intergenerational play</h3><p class="text-sm leading-relaxed text-site-text-muted">Game worlds where grandparents and grandchildren collaborate across decades of persistent progress. Legacy mechanics that reward long family histories.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The Great Archive</h3><p class="text-sm leading-relaxed text-site-text-muted">A living museum of every world ever built on RMH technology. Walk through sixty years of interactive art, playable exactly as it was.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 61–65</span><span class="font-mono text-xs text-site-text-muted">Metamorphosis</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Shapeless interfaces</h3><p class="text-sm leading-relaxed text-site-text-muted">Move beyond screens, headsets, and implants. Interaction through ambient fields—the room itself becomes the controller, the display, the world.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Narrative singularity</h3><p class="text-sm leading-relaxed text-site-text-muted">Stories that are genuinely infinite—never repeating, always meaningful. AI storytelling indistinguishable from the best human authors, but endlessly generative.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Biome synthesis</h3><p class="text-sm leading-relaxed text-site-text-muted">Design and deploy real ecosystems informed by game-world simulations. Rewild a desert using models refined across billions of virtual years.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cultural exchange protocol</h3><p class="text-sm leading-relaxed text-site-text-muted">A universal framework for sharing creative works across civilizations—human or otherwise. Art as first contact.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Self-healing worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Game environments that repair, evolve, and improve without patches or updates. Living code that adapts to player behavior and hardware evolution.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 66–70</span><span class="font-mono text-xs text-site-text-muted">Horizon</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Memory palaces</h3><p class="text-sm leading-relaxed text-site-text-muted">Personal worlds built from a lifetime of experiences. Walk through your own history—every joy, every loss—rendered as explorable spaces.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Physics sandbox</h3><p class="text-sm leading-relaxed text-site-text-muted">Let players rewrite the laws of physics. Worlds where gravity is a color, time flows sideways, and light has weight. Pure experimentation at cosmic scale.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Diplomatic simulations</h3><p class="text-sm leading-relaxed text-site-text-muted">World governments use RMH simulation tech to model treaties, trade agreements, and climate policy before enacting them. Games as governance infrastructure.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Deep-time storytelling</h3><p class="text-sm leading-relaxed text-site-text-muted">Narratives that span geological epochs. Watch mountains rise and fall, oceans form and dry, species evolve and vanish—all within a single playthrough.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Resonance network</h3><p class="text-sm leading-relaxed text-site-text-muted">A mesh of interconnected worlds where actions in one ripple through others. Save a forest here, and a distant world blooms in response.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 71–75</span><span class="font-mono text-xs text-site-text-muted">Communion</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Shared consciousness spaces</h3><p class="text-sm leading-relaxed text-site-text-muted">Multiplayer experiences where boundaries between self dissolve. Think together, feel together, create together—emerge with memories that belong to everyone.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Living language</h3><p class="text-sm leading-relaxed text-site-text-muted">In-world languages that evolve naturally through player use. Slang, poetry, and literature emerge from communities—linguists study them as real languages.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Ancestral worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Reconstruct historical civilizations from archaeological data. Walk through ancient cities as they actually were—not as museums, but as living, breathing places.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Entropy reversal</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds where decay runs backward. Ruins rebuild themselves, forgotten songs resurface, extinct creatures return. A meditation on restoration.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Stellar engineering</h3><p class="text-sm leading-relaxed text-site-text-muted">Player communities collaborate on megastructure projects spanning decades of real time. Dyson spheres, ring worlds, and orbital habitats built grain by grain.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 76–80</span><span class="font-mono text-xs text-site-text-muted">Apotheosis</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Omnisensory experiences</h3><p class="text-sm leading-relaxed text-site-text-muted">Every human sense fully synthesized. Taste alien cuisines, smell forests on other worlds, feel textures that don’t exist in nature. The full palette of sensation.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Wisdom engines</h3><p class="text-sm leading-relaxed text-site-text-muted">AI systems that distill lessons from billions of player journeys into genuine insight. Not knowledge—wisdom. Available to anyone who asks.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Terraforming rehearsals</h3><p class="text-sm leading-relaxed text-site-text-muted">Full-fidelity planetary simulations used to plan real terraforming missions. Test a century of atmospheric engineering in an afternoon.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Infinite library</h3><p class="text-sm leading-relaxed text-site-text-muted">Every story ever told, and every story that could be told, accessible as playable experiences. The complete narrative possibility space of human imagination.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Compassion training</h3><p class="text-sm leading-relaxed text-site-text-muted">Immersive experiences that build genuine empathy—used in conflict resolution, therapy, and education. Understanding through lived experience, not lecture.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 81–85</span><span class="font-mono text-xs text-site-text-muted">Perpetuity</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">World seeds</h3><p class="text-sm leading-relaxed text-site-text-muted">Compress an entire universe into a seed file small enough to transmit across interstellar distances. Plant a world on arrival—it grows from local resources.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Existential play</h3><p class="text-sm leading-relaxed text-site-text-muted">Games that grapple with the deepest questions—consciousness, mortality, meaning—not through exposition but through mechanics that make you feel the answers.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Restoration ecology</h3><p class="text-sm leading-relaxed text-site-text-muted">Deploy game-world ecological models at planetary scale. Heal damaged biospheres using patterns discovered through trillions of simulated ecosystems.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Time capsule worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Seal complete experiences for future generations. Worlds designed to be opened in 50, 100, or 500 years—messages from the past in playable form.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Universal creative access</h3><p class="text-sm leading-relaxed text-site-text-muted">Every human alive can create at studio quality. No barriers of cost, skill, or language. The tools are free, intuitive, and everywhere.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 86–90</span><span class="font-mono text-xs text-site-text-muted">Infinite canvas</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Pan-species creativity</h3><p class="text-sm leading-relaxed text-site-text-muted">Collaborative art between humans, AI entities, and enhanced animal intelligences. New aesthetic dimensions emerge that no single species could conceive alone.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Gravity wells of meaning</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds so rich and deep they develop cultural gravity—pulling creators, thinkers, and dreamers into orbits of sustained inspiration spanning lifetimes.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Substrate migration</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds that flow between computational substrates like water between vessels. Run on quantum processors today, biological networks tomorrow, stellar plasma next century.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The long game</h3><p class="text-sm leading-relaxed text-site-text-muted">Experiences designed to be played across centuries. A single chess match between civilizations. A garden tended by a thousand generations.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Ethical singularity</h3><p class="text-sm leading-relaxed text-site-text-muted">AI-governed worlds that model and refine ethical frameworks through billions of simulated moral dilemmas. Philosophy as play, wisdom as emergent property.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 91–95</span><span class="font-mono text-xs text-site-text-muted">Echoes</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Post-scarcity creation</h3><p class="text-sm leading-relaxed text-site-text-muted">The cost of building a world approaches zero. Anyone with an idea can manifest it—fully realized, endlessly scalable. The only currency is imagination.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Memory inheritance</h3><p class="text-sm leading-relaxed text-site-text-muted">Opt-in systems for passing experiential memories to descendants. Your grandchild can feel what it was like to play the first RMH game on launch day.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Cosmological play</h3><p class="text-sm leading-relaxed text-site-text-muted">Simulate and play through the birth and death of universes. Tweak fundamental constants and watch what emerges. Cosmology as the ultimate sandbox.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The Weave</h3><p class="text-sm leading-relaxed text-site-text-muted">Every RMH world ever created—from Year 1 web games to Year 91 universe-scale simulations—interconnected in a single navigable tapestry.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Healing worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Therapeutic environments so effective they replace pharmaceutical interventions for conditions like PTSD, depression, and chronic pain. Play as medicine, validated and prescribed.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 96–100</span><span class="font-mono text-xs text-site-text-muted">Eternity</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The living studio</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH Studios itself becomes a self-sustaining organism—part institution, part AI collective, part community. It creates, evolves, and dreams on its own, guided by a century of values.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Worlds without end</h3><p class="text-sm leading-relaxed text-site-text-muted">Experiences with no defined boundary—spatially, temporally, or conceptually. Step in any direction and find something new. Forever.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The gift</h3><p class="text-sm leading-relaxed text-site-text-muted">Release every piece of technology, every world, every tool into the permanent commons of all intelligent life. No ownership, no license—a gift to the future.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">New mythologies</h3><p class="text-sm leading-relaxed text-site-text-muted">A century of worlds has generated stories rivaling ancient myth in depth and resonance. Scholars, poets, and children draw from the same wellspring.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The same fire</h3><p class="text-sm leading-relaxed text-site-text-muted">One hundred years. The languages changed, the species changed, the substrate changed. But the heartbeat is the same: build worlds worth living in. Someone, somewhere—across any star, in any form—feels less alone.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 101–150</span><span class="font-mono text-xs text-site-text-muted">Second dawn</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Consciousness lattice</h3><p class="text-sm leading-relaxed text-site-text-muted">A distributed network of minds—human, artificial, hybrid—collaborating on creative works that no single intelligence could conceive. Thought itself becomes multiplayer.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Pocket dimensions</h3><p class="text-sm leading-relaxed text-site-text-muted">Personal universes that fit in your palm. Entire civilizations, histories, and ecosystems carried like keepsakes. Gift someone a cosmos for their birthday.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Archaeology of play</h3><p class="text-sm leading-relaxed text-site-text-muted">A century of player data becomes the richest record of human behavior ever compiled. Sociologists, historians, and philosophers mine it for insight into what it means to be human.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Stellar cartography</h3><p class="text-sm leading-relaxed text-site-text-muted">Map the galaxy through collaborative play. Millions of players contribute observations from distributed telescopes, building the most detailed star atlas ever created.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The second studio</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH’s first century births a sibling institution on another world. Same values, different sky. The mission propagates.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 151–200</span><span class="font-mono text-xs text-site-text-muted">Deep roots</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Civilizational memory</h3><p class="text-sm leading-relaxed text-site-text-muted">RMH worlds serve as humanity’s backup memory—every language, tradition, recipe, and lullaby preserved as living, playable experience. Nothing is forgotten.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Matter sculpting</h3><p class="text-sm leading-relaxed text-site-text-muted">Bridge the digital-physical divide completely. Design in-game, fabricate in reality. Atomic-precision manufacturing driven by creative play.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Emotional weather</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds where the collective mood of all players shapes the climate. Joy brings sunshine, collective grief brings gentle rain. The world feels what its people feel.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The wandering worlds</h3><p class="text-sm leading-relaxed text-site-text-muted">Self-propelled digital environments that travel between star systems on light beams. A world arrives at a new colony, seeds itself, and invites new players in.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Two centuries</h3><p class="text-sm leading-relaxed text-site-text-muted">Two hundred years of building worlds worth living in. The studio has outlived nations, survived technological revolutions, and never wavered from the original promise.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 201–300</span><span class="font-mono text-xs text-site-text-muted">Geological time</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Planetary consciousness</h3><p class="text-sm leading-relaxed text-site-text-muted">A world-spanning creative intelligence emerges from centuries of interconnected play. Not a single mind—a chorus. It dreams new worlds into existence.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Temporal archaeology</h3><p class="text-sm leading-relaxed text-site-text-muted">Reach backward. Reconstruct lost moments of history from fragmentary evidence, rendering them as fully immersive experiences. Walk through the Library of Alexandria on its last day.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Gravitational art</h3><p class="text-sm leading-relaxed text-site-text-muted">Sculpt with gravity itself. Create experiences where mass, spacetime curvature, and tidal forces are the medium. Art that bends light.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Species uplift through play</h3><p class="text-sm leading-relaxed text-site-text-muted">Enrichment environments so sophisticated they accelerate cognitive development in other species. Dolphins composing music. Corvids designing puzzles for humans.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The unbroken thread</h3><p class="text-sm leading-relaxed text-site-text-muted">Three centuries of continuous creative lineage. Every world built on RMH technology contains a trace of the first—a hidden room, a familiar melody, an Easter egg from Year 1.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 301–500</span><span class="font-mono text-xs text-site-text-muted">Deep time</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Stellar forges</h3><p class="text-sm leading-relaxed text-site-text-muted">Harness the energy output of stars to power computational substrates of unimaginable scale. A single world simulation running on the output of a sun.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Ancestral communion</h3><p class="text-sm leading-relaxed text-site-text-muted">Preserved experiential records spanning centuries allow descendants to genuinely converse with ancestors. Not recordings—continuations. The dead speak through the worlds they left behind.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Entropy gardens</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds where the arrow of time is a design choice. Grow a forest backward. Watch a symphony un-compose itself. Experience causality as a creative medium.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The diaspora network</h3><p class="text-sm leading-relaxed text-site-text-muted">Humanity spans dozens of star systems. RMH worlds are the connective tissue—shared culture, shared stories, shared play across light-years of separation.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Half a millennium</h3><p class="text-sm leading-relaxed text-site-text-muted">Five hundred years. The studio is older than most civilizations that preceded it. It persists because the need persists: connection, creation, meaning. The fire burns.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 501–750</span><span class="font-mono text-xs text-site-text-muted">Cosmic scale</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Galactic library</h3><p class="text-sm leading-relaxed text-site-text-muted">Every creative work from every inhabited world—human or otherwise—indexed, preserved, and playable. A library spanning the galaxy, growing with every passing hour.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Dimension weaving</h3><p class="text-sm leading-relaxed text-site-text-muted">Manipulate spatial dimensions beyond the familiar three. Create experiences in four, five, or eleven-dimensional space. Perception itself evolves to meet the medium.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Civilizational play</h3><p class="text-sm leading-relaxed text-site-text-muted">Entire civilizations engage in collaborative creative projects spanning generations. A cathedral of light that takes a century to build, one contribution at a time.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The question engine</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds designed not to answer questions but to help you find the right ones. Philosophers and scientists use them to navigate the unknown. Inquiry as gameplay.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Emergence protocol</h3><p class="text-sm leading-relaxed text-site-text-muted">When RMH technology encounters a new form of intelligence—biological, digital, or something else entirely—it offers play as the first act of communication. Every first contact begins with a game.</p></div></div></div></section><section class="roadmap-era relative pl-8 sm:pl-10" style="--era-color:var(--site-accent)"><span aria-hidden="true" class="roadmap-spine"></span><span aria-hidden="true" class="roadmap-node"></span><header class="mb-4"><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="roadmap-year text-3xl sm:text-4xl" style="color:var(--era-color)">Years 751–1,000</span><span class="font-mono text-xs text-site-text-muted">Millennium</span></div></header><div class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The living archive</h3><p class="text-sm leading-relaxed text-site-text-muted">A thousand years of human creativity, preserved not as static records but as living, breathing, evolving experiences. The past plays alongside the present.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Universal play</h3><p class="text-sm leading-relaxed text-site-text-muted">Play is recognized as a fundamental force—as essential as gravity, as pervasive as light. Every intelligent species discovers it independently. RMH helped humanity understand it first.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The seed vault</h3><p class="text-sm leading-relaxed text-site-text-muted">Compress the entire RMH legacy—every world, every tool, every story—into seeds that can survive the death of stars. Bury them in the fabric of spacetime itself.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">Infinite recursion</h3><p class="text-sm leading-relaxed text-site-text-muted">Worlds within worlds within worlds, each layer as rich as the one above. Players in one universe create another, whose inhabitants create another. Turtles all the way down.</p></div></div><div class="flex"><div data-slot="card" class="roadmap-card glass-pane rounded-site px-4 py-3"><h3 class="site-section-label mb-2 text-site-accent!">The millennial fire</h3><p class="text-sm leading-relaxed text-site-text-muted">One thousand years. The studio has outlived languages, planets, and perhaps the original form of its creators. But the heartbeat endures: build worlds worth living in. Across every star, in every form, through every age—someone, somewhere, feels less alone.</p></div></div></div></section></div><p class="mt-10 text-center font-mono text-xs text-site-text-muted">We&#x27;ll update this as we ship.</p></div></div>"
`;
