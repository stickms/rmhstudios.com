load("//bazel:defs.bzl", "go_service_image")

# Per-service OCI images. Kept in a dedicated package so the gazelle-managed
# cmd/*/BUILD.bazel files stay untouched. Both services use the distroless
# static base. The Discord bot and supervisor images (and the git base they
# needed) went with the Go bot: it runs in the Node jobs worker now (D3).
# The realtime hubs (gateway/gamehub/rmhbox/rmhmusic/rmhtube) were removed in
# the rewrite (design §5.2): they were an unshipped duplicate of the production
# Node hubs.

# assets: streams /library /music /models /sprites from the S3-compatible
# bucket. The AWS SDK is pure Go, so distroless static is sufficient.
go_service_image(
    name = "assets",
    binary = "//go-services/cmd/assets:assets",
)

# status: dependency-light HTTP service (probes + dashboard, raw pgx for the
# optional DB probe and the pg-boss alarm reads). Pure Go — distroless static.
go_service_image(
    name = "status",
    binary = "//go-services/cmd/status:status",
)
