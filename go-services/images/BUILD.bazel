load("//bazel:defs.bzl", "go_service_image")

# Per-service OCI images. Kept in a dedicated package so the gazelle-managed
# cmd/*/BUILD.bazel files stay untouched. Standard services use the distroless
# static base; discord-bot and the supervisor use the git base (see below).

# ── Standard services (distroless static) ────────────────────────────────────
# The realtime hubs (gateway/gamehub/rmhbox/rmhmusic/rmhtube) were removed in the
# rewrite (design §5.2): they were an unshipped duplicate of the production Node
# hubs. The Node hubs remain the production realtime tier.
# assets: streams /library /music /models /sprites from the S3-compatible
# bucket. The AWS SDK is pure Go, so distroless static is sufficient.
go_service_image(
    name = "assets",
    binary = "//go-services/cmd/assets:assets",
)

# ── Special bases ────────────────────────────────────────────────────────────
# discord-bot needs git/ssh. (The vibe-worker, which needed Chromium, moved to the Node jobs worker.)
go_service_image(
    name = "discord-bot",
    base = "@base_git",
    binary = "//go-services/cmd/discord-bot:discord-bot",
)

# ── Supervisor + status ───────────────────────────────────────────────────────
# status: dependency-light HTTP service (probes + dashboard, raw pgx for the
# optional DB probe). Pure Go — distroless static base is sufficient.
go_service_image(
    name = "status",
    binary = "//go-services/cmd/status:status",
)

# supervisor: runs the discord-bot worker as a goroutine. Its base needs git +
# openssh-client (rmhbot worktree/PR feature); no Chromium any more (D3: the
# vibe-worker's thumbnails render in the Node jobs worker).
go_service_image(
    name = "supervisor",
    base = "@base_git",
    binary = "//go-services/cmd/supervisor:supervisor",
)
