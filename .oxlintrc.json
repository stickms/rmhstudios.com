{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "oxc"
  ],
  "jsPlugins": [
    "./eslint-local-rules/index.js"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    ".cache/**",
    ".output/**",
    ".tanstack/**",
    ".vinxi/**",
    "bazel-*/**",
    "dist-server/**",
    "build/**",
    "**/node_modules/**",
    "public/vibe-packages/**",
    "public/balatro/engine/**",
    "webhook-server.cjs",
    "check_db.js",
    "sync_db.js",
    ".claude/worktrees/**",
    "packages/sdk/src/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "builtin": true,
    "es2022": true
  },
  "rules": {
    "no-useless-assignment": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-require-imports": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "prefer-const": "warn",
    "no-empty": "warn",
    "no-case-declarations": "warn",
    "typescript/ban-ts-comment": "warn",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "warn",
    "react/no-direct-mutation-state": "error",
    "oxc/erasing-op": "warn",
    "oxc/only-used-in-recursion": "warn",
    "oxc/double-comparisons": "warn",
    "local/no-adhoc-user-select": "warn",
    "local/no-lucide-namespace-import": "error",
    "local/no-use-client-directive": "error",
    "local/no-adhoc-spinner": "error",
    "local/no-core-primitive-redefinition": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "framer-motion",
            "importNames": [
              "motion"
            ],
            "message": "Import `m as motion` instead. `motion` ships its own full feature bundle and defeats the <LazyMotion> split in components/Providers.tsx (docs/archive/2026/performance-audit-2026-08-12.md §1.3)."
          },
          {
            "name": "sonner",
            "message": "Import `toast` from `@/lib/toast`. Importing sonner directly puts the library back in the entry closure (scripts/check-entry-composition.ts fails on it)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.mjs"
      ],
      "env": {
        "node": true,
        "browser": true
      }
    },
    {
      "files": [
        "public/sw*.js"
      ],
      "env": {
        "serviceworker": true,
        "browser": false
      }
    },
    {
      "files": [
        "public/**/*.js"
      ],
      "excludeFiles": [
        "public/sw*.js"
      ],
      "env": {
        "browser": true
      }
    },
    {
      "files": [
        "**/*.{jsx,tsx}"
      ],
      "rules": {
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/alt-text": "warn",
        "jsx-a11y/anchor-has-content": "warn",
        "jsx-a11y/anchor-is-valid": "warn",
        "jsx-a11y/aria-role": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/heading-has-content": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "off",
        "jsx-a11y/interactive-supports-focus": "off",
        "jsx-a11y/media-has-caption": "off"
      }
    },
    {
      "files": [
        "app/routes/**/*.tsx"
      ],
      "rules": {
        "local/route-needs-head": "error"
      }
    },
    {
      "files": [
        "**/*.{ts,tsx}"
      ],
      "excludeFiles": [
        "lib/core/**",
        "**/*.test.{ts,tsx}",
        "**/__tests__/**",
        "testing/**"
      ],
      "rules": {
        "local/no-core-primitive-redefinition": "error"
      }
    },
    {
      "files": [
        "lib/core/**",
        "**/*.test.{ts,tsx}",
