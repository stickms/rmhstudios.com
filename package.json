{
  "name": "rmhstudios.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm run images:variants && concurrently \"vite dev\" \"pnpm run socket-server\" \"pnpm run rmhbox-server\" \"pnpm run rmhtube-server\" \"pnpm run ladder-worker:dev\" \"pnpm run homes-worker:dev\" \"pnpm run jobs:dev\"",
    "build-vibe-packages": "pnpm exec tsx scripts/build-vibe-packages.ts",
    "images:variants": "pnpm exec tsx scripts/gen-image-variants.ts",
    "images:variants:check": "pnpm exec tsx scripts/gen-image-variants.ts --check",
    "clean": "rm -rf .output dist-server .tanstack tsconfig.tsbuildinfo dist-server/tsconfig.server.tsbuildinfo",
    "build:frontend": "pnpm run build-vibe-packages && pnpm run images:variants && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:frontend:sourcemap": "pnpm run build-vibe-packages && pnpm run images:variants && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --sourcemap",
    "check:consistency": "bash scripts/check-consistency.sh",
    "check:consistency:full": "bash scripts/check-consistency.sh --full",
    "hooks:install": "git config core.hooksPath .githooks && echo 'commit gate installed (.githooks/pre-commit)'",
    "check:bundle-budget": "pnpm exec tsx scripts/check-bundle-budget.ts",
    "check:entry-composition": "pnpm exec tsx scripts/check-entry-composition.ts",
    "build": "pnpm run build-vibe-packages && pnpm run images:variants && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && pnpm exec esbuild server/socket-server/index.ts server/rmhbox/index.ts server/rmhtube/index.ts server/ladder-worker/index.ts server/homes-worker/index.ts server/jobs/index.ts --bundle --platform=node --target=node24 --outdir=dist-server --outbase=. --format=cjs --out-extension:.js=.cjs --packages=external --tree-shaking=true --tsconfig=tsconfig.server.json",
    "start": "concurrently \"node .output/server/index.mjs\" \"node dist-server/server/socket-server/index.cjs\" \"node dist-server/server/rmhbox/index.cjs\" \"node dist-server/server/rmhtube/index.cjs\" \"node dist-server/server/ladder-worker/index.cjs\" \"node dist-server/server/homes-worker/index.cjs\" \"node dist-server/server/jobs/index.cjs\"",
    "socket-server": "pnpm exec tsx watch --include \"server/socket-server/**/*\" --include \"server/rmhmusic/**/*\" --include \"server/shared/**/*\" server/socket-server/index.ts",
    "rmhbox-server": "pnpm exec tsx watch --include \"server/rmhbox/**/*\" --include \"server/shared/**/*\" server/rmhbox/index.ts",
    "rmhtube-server": "pnpm exec tsx watch --include \"server/rmhtube/**/*\" --include \"server/shared/**/*\" server/rmhtube/index.ts",
    "ladder-worker:dev": "pnpm exec tsx watch --include \"server/ladder-worker/**/*\" --include \"lib/rmhladder/**/*\" server/ladder-worker/index.ts",
    "homes-worker:dev": "pnpm exec tsx watch --include \"server/homes-worker/**/*\" --include \"lib/homes/**/*\" server/homes-worker/index.ts",
    "jobs:dev": "pnpm exec tsx watch --include \"server/jobs/**/*\" --include \"lib/jobs/**/*\" --include \"lib/social/engagement-effects.server.ts\" server/jobs/index.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma db push --force-reset",
    "ladder:seed": "pnpm exec tsx scripts/seed-ladder.ts",
    "ladder:probe": "pnpm exec tsx scripts/probe-ladder-sources.ts",
    "ladder:run": "pnpm exec tsx scripts/run-ladder-pipeline.ts",
    "ladder:status": "pnpm exec tsx scripts/ladder-status.ts",
    "feed:reconcile-counts": "pnpm exec tsx scripts/reconcile-feed-counts.ts",
    "social:reconcile-counts": "pnpm exec tsx scripts/reconcile-social-counts.ts",
    "handles:backfill": "pnpm exec tsx scripts/backfill-handles.ts",
    "backfill-vibe-thumbs": "pnpm exec tsx scripts/backfill-vibe-thumbs.ts",
    "library:metadata": "pnpm exec tsx scripts/generate-library-metadata.ts",
    "docs:api": "pnpm exec tsx scripts/generate-api-docs.ts",
    "docs:api:check": "pnpm exec tsx scripts/generate-api-docs.ts --check",
    "bums:manifest": "pnpm exec tsx scripts/bums-rush-manifest.ts",
    "bums:manifest:check": "pnpm exec tsx scripts/bums-rush-manifest.ts --check",
    "docs:site": "pnpm exec tsx scripts/generate-site-reference.ts",
    "docs:site:check": "pnpm exec tsx scripts/generate-site-reference.ts --check",
    "albums:migrate": "pnpm exec tsx scripts/migrate-albums-to-storage.ts",
    "media:migrate": "pnpm exec tsx scripts/migrate-media-to-r2.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:epic": "vitest run --config vitest.epic.config.ts",
    "epic:test": "pnpm run test:epic",
    "epic:build": "node_modules/.bin/tsx scripts/epic/build-epic.ts",
    "i18n:extract": "i18next 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}'",
    "i18n:translate": "pnpm exec tsx scripts/translate-locales.ts",
    "i18n:resources": "pnpm exec tsx scripts/gen-i18n-resources.ts",
    "i18n:translate:local": "bash scripts/translate-i18n-local.sh",
    "i18n:coverage": "pnpm exec tsx scripts/check-i18n-coverage.ts",
    "emoji:shortcodes": "node scripts/generate-emoji-shortcodes.mjs",
    "og:cards": "pnpm exec tsx scripts/gen-og-cards.tsx",
    "slice-it:hit-sounds": "pnpm exec tsx scripts/gen-slice-it-hit-sounds.ts",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc/native.tsbuildinfo"
  },
