{
  "name": "rmhstudios.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm run i18n:pull && pnpm run images:variants && concurrently \"vite dev\" \"pnpm run socket-server\" \"pnpm run rmhbox-server\" \"pnpm run rmhtube-server\" \"pnpm run rmhos-net-server\" \"pnpm run ladder-worker:dev\" \"pnpm run homes-worker:dev\" \"pnpm run medschools-worker:dev\" \"pnpm run jobs:dev\"",
    "build-vibe-packages": "pnpm exec tsx scripts/build-vibe-packages.ts",
    "images:variants": "pnpm exec tsx scripts/gen-image-variants.ts",
    "images:variants:check": "pnpm exec tsx scripts/gen-image-variants.ts --check",
    "fonts:generate": "pnpm exec tsx scripts/gen-self-hosted-fonts.ts",
    "fonts:check": "pnpm exec tsx scripts/gen-self-hosted-fonts.ts --check",
    "clean": "rm -rf .output dist-server .tanstack tsconfig.tsbuildinfo dist-server/tsconfig.server.tsbuildinfo",
    "build:islands": "vite build -c vite.islands.config.ts",
    "build:frontend": "pnpm run build-vibe-packages && pnpm run images:variants && pnpm run build:islands && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:frontend:sourcemap": "pnpm run build-vibe-packages && pnpm run images:variants && pnpm run build:islands && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --sourcemap",
    "audit:pages": "node scripts/audit-pages.mjs",
    "check:consistency": "bash scripts/check-consistency.sh",
    "check:consistency:full": "bash scripts/check-consistency.sh --full",
    "hooks:install": "git config core.hooksPath .githooks && echo 'commit gate installed (.githooks/pre-commit)'",
    "check:bundle-budget": "pnpm exec tsx scripts/check-bundle-budget.ts",
    "check:entry-composition": "pnpm exec tsx scripts/check-entry-composition.ts",
    "build": "pnpm run build-vibe-packages && pnpm run images:variants && pnpm run build:islands && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && pnpm exec esbuild server/socket-server/index.ts server/rmhbox/index.ts server/rmhtube/index.ts server/rmhos-net/index.ts server/ladder-worker/index.ts server/homes-worker/index.ts server/medschools-worker/index.ts server/jobs/index.ts features/slice-it/engine/beatmap/stft.worker.ts --bundle --platform=node --target=node26 --outdir=dist-server --outbase=. --format=cjs --out-extension:.js=.cjs --packages=external --tree-shaking=true --tsconfig=tsconfig.server.json",
    "start": "concurrently \"node .output/server/index.mjs\" \"node dist-server/server/socket-server/index.cjs\" \"node dist-server/server/rmhbox/index.cjs\" \"node dist-server/server/rmhtube/index.cjs\" \"node dist-server/server/rmhos-net/index.cjs\" \"node dist-server/server/ladder-worker/index.cjs\" \"node dist-server/server/homes-worker/index.cjs\" \"node dist-server/server/medschools-worker/index.cjs\" \"node dist-server/server/jobs/index.cjs\"",
    "socket-server": "pnpm exec tsx watch --include \"server/socket-server/**/*\" --include \"server/shared/**/*\" server/socket-server/index.ts",
    "rmhbox-server": "pnpm exec tsx watch --include \"server/rmhbox/**/*\" --include \"server/shared/**/*\" server/rmhbox/index.ts",
    "rmhos-net-server": "pnpm exec tsx watch --env-file-if-exists=.env --include \"server/rmhos-net/**/*\" --include \"features/rmhos/engine/**/*\" server/rmhos-net/index.ts",
    "rmhtube-server": "pnpm exec tsx watch --include \"server/rmhtube/**/*\" --include \"server/shared/**/*\" server/rmhtube/index.ts",
    "ladder-worker:dev": "pnpm exec tsx watch --include \"server/ladder-worker/**/*\" --include \"lib/rmhladder/**/*\" server/ladder-worker/index.ts",
    "homes-worker:dev": "pnpm exec tsx watch --include \"server/homes-worker/**/*\" --include \"lib/homes/**/*\" server/homes-worker/index.ts",
    "medschools-worker:dev": "pnpm exec tsx watch --include \"server/medschools-worker/**/*\" --include \"features/medschools/**/*\" --include \"data/medschools/**/*\" server/medschools-worker/index.ts",
    "jobs:dev": "pnpm exec tsx watch --include \"server/jobs/**/*\" --include \"lib/jobs/**/*\" --include \"lib/social/engagement-effects.server.ts\" server/jobs/index.ts",
    "lint": "eslint",
    "a11y:ratchet": "node scripts/count-jsx-a11y.mjs --check",
    "lint:ratchet": "pnpm exec tsx scripts/check-lint-ratchet.ts",
    "lint:ratchet:update": "pnpm exec tsx scripts/check-lint-ratchet.ts --update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma db push --force-reset",
    "db:census": "pnpm exec tsx scripts/db-census.ts",
    "ladder:seed": "pnpm exec tsx scripts/seed-ladder.ts",
    "knip": "knip",
    "ladder:probe": "pnpm exec tsx scripts/probe-ladder-sources.ts",
    "ladder:run": "pnpm exec tsx scripts/run-ladder-pipeline.ts",
    "ladder:status": "pnpm exec tsx scripts/ladder-status.ts",
    "feed:reconcile-counts": "pnpm exec tsx scripts/reconcile-feed-counts.ts",
    "social:reconcile-counts": "pnpm exec tsx scripts/reconcile-social-counts.ts",
    "handles:backfill": "pnpm exec tsx scripts/backfill-handles.ts",
    "backfill-vibe-thumbs": "pnpm exec tsx scripts/backfill-vibe-thumbs.ts",
    "library:metadata": "pnpm exec tsx scripts/generate-library-metadata.ts",
    "docs:api": "pnpm exec tsx scripts/generate-api-docs.ts",
    "sdk:generate": "pnpm exec tsx scripts/generate-sdk.ts",
    "sdk:check": "pnpm exec tsx scripts/generate-sdk.ts --check",
    "docs:api:check": "pnpm exec tsx scripts/generate-api-docs.ts --check",
    "api:routes": "pnpm exec tsx scripts/gen-api-route-table.ts",
    "api:routes:check": "pnpm exec tsx scripts/gen-api-route-table.ts --check",
    "facts:generate": "pnpm exec tsx scripts/gen-repo-facts.ts",
    "facts:check": "pnpm exec tsx scripts/gen-repo-facts.ts --check",
    "prepaint:build": "pnpm exec tsx scripts/build-prepaint.ts",
    "prepaint:check": "pnpm exec tsx scripts/build-prepaint.ts --check",
    "docs:site": "pnpm exec tsx scripts/generate-site-reference.ts",
    "docs:site:check": "pnpm exec tsx scripts/generate-site-reference.ts --check",
    "media:migrate": "pnpm exec tsx scripts/migrate-media-to-r2.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "vitest run",
    "test:toolbox": "vitest run --config vitest.toolbox.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:epic": "vitest run --config vitest.epic.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:tf2": "vitest run --config vitest.tf2.config.ts",
    "test:balatro": "vitest run --config vitest.balatro.config.ts",
    "test:balatro:e2e": "vitest run --config vitest.balatro-e2e.config.ts",
    "test:hearthworks:e2e": "tsx testing/hearthworks-e2e/run.ts",
    "test:hearthworks:models": "tsx testing/hearthworks-models/run.ts",
    "test:balatro:lua": "lua5.1 features/balatro/engine/lua/spec/runner.lua",
    "balatro:gen-protocol": "node_modules/.bin/tsx scripts/balatro/gen-lua-protocol.ts",
    "balatro:mp-pack": "python3 -I scripts/balatro/build-game-pack.py --mp-only",
    "epic:test": "pnpm run test:epic",
    "epic:build": "node_modules/.bin/tsx scripts/epic/build-epic.ts",
    "i18n:extract": "i18next 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'features/medschools/**/*.{ts,tsx}'",
    "i18n:pull": "bash scripts/i18n-pull.sh",
    "i18n:coverage": "pnpm exec tsx scripts/check-i18n-coverage.ts",
    "emoji:shortcodes": "node scripts/generate-emoji-shortcodes.mjs",
    "og:cards": "pnpm exec tsx scripts/gen-og-cards.tsx",
    "slice-it:hit-sounds": "pnpm exec tsx scripts/gen-slice-it-hit-sounds.ts",
    "typecheck": "node node_modules/typescript-native/bin/tsc -b",
    "typecheck:engine": "node node_modules/typescript-native/bin/tsc -b tsconfig.engine.json",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "rmhos:image": "bash scripts/rmhos/build.sh",
    "rmhos:smoke": "node scripts/rmhos/smoke.mjs",
    "rmhos:snapshot": "node scripts/rmhos/snapshot.mjs",
    "rmhos:manifest": "node scripts/rmhos/write-manifest.mjs",
    "rmhos:selftest": "node scripts/rmhos/meta-selftest.mjs"
  },
