{
  // The site project: every source file that is not in the core or engine project.
  //
  // `exclude` repeats the two projects' `include` lists, and `files` names what they leave out of
  // those directories (core's tests, the engine's server side and the tests that reach it).
  // `files` wins over `exclude`, which is the only way to say "this directory except these".
  // lib/__tests__/tsconfig-projects.test.ts fails when a file is in two projects or in none, and
  // prints the line to add.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsc/site.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "app/routeTree.gen.ts"
  ],
  "exclude": [
    "node_modules",
    "bazel-*",
    "dist-server",
    "public/vibe-packages",
    "server/api-routes",
    "scripts",
    ".output",
    ".next",
    "next-env.d.ts",
    ".vinxi",
    "proxy.ts",
    "lib/core/**/*",
    "lib/contract/**/*",
    "lib/shared/**/*",
    "lib/http.ts",
    "lib/url.ts",
    "lib/network-quality.ts",
    "lib/display-scale.ts",
    "lib/tf2-game/**/*",
    "lib/sp-game/**/*",
    "lib/csgo-game/**/*",
    "lib/tf2-hud/**/*",
    "lib/tf2-loadout/**/*",
    "components/tf2-game/hud-layout.ts",
    "components/tf2-game/preview/sample-states.ts",
    "components/tf2-hud/loadout/model-utils.ts"
  ],
  "files": [
    "lib/contract/__tests__/contract.test.ts",
    "lib/core/__tests__/core.test.ts",
    "lib/core/__tests__/persist.test.ts",
    "lib/shared/p2p/__tests__/direct-connection.test.ts",
    "lib/shared/p2p/__tests__/reliable-link.test.ts",
    "lib/shared/p2p/__tests__/wire.test.ts",
    "lib/shared/realtime/connect-race.test.ts",
    "lib/shared/realtime/single-flight.test.ts",
    "lib/tf2-game/assets/assets.test.ts",
    "lib/tf2-game/assets/store.server.ts",
    "lib/tf2-hud/__tests__/ai.server.test.ts",
    "lib/tf2-hud/__tests__/base-store.test.ts",
    "lib/tf2-hud/__tests__/blob-codec.test.ts",
    "lib/tf2-hud/ai.server.ts",
    "lib/tf2-hud/api/tf2-hud.ai.server.ts",
    "lib/tf2-hud/api/tf2-hud.blobs.$sha1.server.ts",
    "lib/tf2-hud/api/tf2-hud.blobs.check.server.ts",
    "lib/tf2-hud/api/tf2-hud.huds.$id.download.server.ts",
