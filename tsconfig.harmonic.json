{
  // Typecheck only Harmonic and what it imports — the full `tsc --noEmit` needs more memory
  // than some sandboxes have. CI still runs the full check. See docs/plans/harmonic/README.md §1.3.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "incremental": false, "types": ["vite/client"] },
  "include": [
    "lib/harmonic-game/**/*",
    "components/harmonic-game/**/*",
    "app/routes/harmonic.tsx",
    "app/routeTree.gen.ts",
    "lib/**/*.d.ts"
  ]
}
