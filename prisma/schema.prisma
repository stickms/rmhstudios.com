// ─── Direct Messages ──────────────────────────────────────────────

model Conversation {
  id               String   @id @default(cuid())
  participantOneId String
  participantTwoId String
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  participantOne User            @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo User            @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages       DirectMessage[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId, lastMessageAt(sort: Desc)])
  @@index([participantTwoId, lastMessageAt(sort: Desc)])
  @@map("conversation")
}

model DirectMessage {
  id              String    @id @default(cuid())
  conversationId  String
  senderId        String
  content         String    @db.VarChar(2000)
  // Optional rich media — mirrors RMHark posts. A message can be text, media,
  // or both. gifUrl is a single GIF (KLIPY/Tenor/Giphy/direct); imageUrls are
  // up to 4 feed-image URLs owned by the sender.
  gifUrl          String?   @db.Text
  imageUrls       String[]  @default([])
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now())
  /// Edited within a short window; renders an "edited" marker.
  editedAt        DateTime?
  /// Unsent. The row is tombstoned rather than removed so the thread still
  /// shows that something was there — otherwise unsend becomes a gaslighting
  /// tool — and so a report survives the deletion.
  deletedAt       DateTime?
  deletedBy       String?   @db.VarChar(12)
  /// Voice note. Peaks are a downsampled waveform so the bubble can render
  /// without fetching the audio.
  audioUrl        String?   @db.VarChar(500)
  audioDurationMs Int?
  audioPeaks      Float[]   @default([])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  reactions DirectMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_message")
}

model DirectMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("direct_message_reaction")
}

// ─── rmhcode CLI Authentication ─────────────────────────────────────

model RmhCodeToken {
