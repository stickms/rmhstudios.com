// ─── Coin Ledger (tips & gifts) ───────────────────────────────────────────
enum CoinTxnType {
  TIP
  GIFT
  PURCHASE
  REWARD
  ADMIN
  MEMBERSHIP
  WAGER // coin-staked match / tournament entry, escrow, and payout
  MARKET // secondary-market (player marketplace) sale proceeds — excluded from creator "earned"
}

/// The coin ledger. Every movement of currency is a row here, and the sign
/// convention is what makes the whole thing reconcilable:
///
///   FAUCET   senderId = null, recipientId = user   → supply created
///   TRANSFER senderId = user, recipientId = user   → supply conserved
///   SINK     senderId = user, recipientId = null   → supply destroyed
///
/// `recipientId` is nullable precisely so sinks can be recorded. Before that,
/// spending coins decremented a balance and wrote NO row (or wrote only the
/// seller's payout, silently dropping the platform cut), so the ledger could
/// never be summed and checked against the balances it was supposed to explain.
/// With all three shapes present:
///
///   balance(u) == Σ(amount where recipientId = u) − Σ(amount where senderId = u)
///
/// which is exactly what `reconcileUser` asserts. Write rows ONLY through
/// `lib/economy/ledger.server.ts`.
model CoinTransaction {
  id          String      @id @default(cuid())
  senderId    String? // null for system faucets (rewards, quests, refunds)
  recipientId String? // null for sinks (coins destroyed: shop, unlocks, fees)
  amount      Int
  type        CoinTxnType
  note        String?     @db.VarChar(280)
  entityType  String?     @db.VarChar(32) // e.g. "rmhark", "profile"
  entityId    String?     @db.VarChar(64)
  createdAt   DateTime    @default(now())

  /// Caller-supplied dedupe token. A retried request (double-click, client
  /// retry, webhook redelivery) reusing the same key hits the unique index and
  /// is recognised as a replay instead of moving coins a second time.
  idempotencyKey String? @unique @db.VarChar(128)

  sender    User? @relation("CoinSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("CoinRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  /// Drives the economy dashboard: supply by type over a time window.
  @@index([createdAt(sort: Desc), type])
  @@map("coin_transaction")
}

