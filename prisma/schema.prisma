  @@index([token])
  @@map("rmhcode_token")
}

// ─── User Builds ────────────────────────────────────────────────────

enum BuildVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model UserBuild {
  id           String          @id @default(cuid())
  userId       String
  slug         String          @unique
  title        String          @db.VarChar(100)
  description  String          @db.VarChar(500)
  readme       String?         @db.Text
  repoUrl      String?         @db.VarChar(500)
  demoUrl      String?         @db.VarChar(500)
  thumbnailUrl String?         @db.VarChar(500)
  visibility   BuildVisibility @default(PUBLIC)
  featured     Boolean         @default(false)
  isCurated    Boolean         @default(false) // Added for "Official Build" status
  position     Int             @default(0) // Added for manual sorting by admins
  technologies Json            @default("[]")
  // Marketplace: coins to unlock the readme/repo/demo (null/0 = free).
  price        Int?
  likeCount    Int             @default(0)
  commentCount Int             @default(0)
  viewCount    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  publishedAt  DateTime?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   BuildCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?
  versions   BuildVersion[]
  tags       BuildTag[]
  likes      BuildLike[]
  comments   BuildComment[]
  views      BuildView[]
  unlocks    BuildUnlock[]

  @@index([userId])
  @@index([visibility, publishedAt(sort: Desc)])
  @@index([slug])
  @@map("user_build")
}

/// A paid unlock of a build's gated content (#16). Mirrors PostUnlock.
model BuildUnlock {
  id        String   @id @default(cuid())
  userId    String
  buildId   String
  pricePaid Int
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  build UserBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([userId, buildId])
  @@index([buildId])
  @@map("build_unlock")
}

/// Per-game ELO rating for ranked play (#5). Updated when a challenge resolves.
model EloRating {
  id        String   @id @default(cuid())
  userId    String
  game      String   @db.VarChar(40)
  rating    Int      @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@index([game, rating(sort: Desc)])
  @@map("elo_rating")
}

/// An async ranked challenge between two players. The result is trust-reported
/// by either participant; resolving it updates both ELO ratings.
model RankedChallenge {
  id           String    @id @default(cuid())
  game         String    @db.VarChar(40)
  challengerId String
  opponentId   String
  status       String    @default("pending") @db.VarChar(12) // pending|accepted|declined|done
  winnerId     String? // null winner on a done challenge = draw
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@map("ranked_challenge")
}

/// A coin-funded gift membership (#18). Grants a tier for a time window,
/// independent of Stripe billing. getUserTier folds active grants in.
model GiftMembership {
  id        String   @id @default(cuid())
  userId    String // recipient
  gifterId  String? // null = system grant
  tier      String   @db.VarChar(16) // 'starter' | 'pro'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User  @relation("GiftRecipient", fields: [userId], references: [id], onDelete: Cascade)
  gifter User? @relation("GiftGifter", fields: [gifterId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("gift_membership")
}

/// A group direct-message thread (#15). Distinct from 1-on-1 Conversations.
model GroupChat {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(60)
  ownerId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  owner    User              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupChatMember[]
  messages GroupMessage[]

  @@map("group_chat")
}

model GroupChatMember {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_chat_member")
}

model GroupMessage {
  id              String    @id @default(cuid())
  groupId         String
  senderId        String
  content         String    @db.VarChar(2000)
  // Optional rich media (mirrors DMs): a single GIF and/or up to 4 images.
  gifUrl          String?   @db.Text
  imageUrls       String[]  @default([])
  // Optional inline poll: a question + 2–6 option labels (votes in GroupPollVote).
  pollQuestion    String?   @db.VarChar(300)
  pollOptions     String[]  @default([])
  createdAt       DateTime  @default(now())
  /// Edited within a short window; renders an "edited" marker.
  editedAt        DateTime?
  /// Unsent. The row is tombstoned rather than removed so the thread still
  /// shows that something was there — otherwise unsend becomes a gaslighting
  /// tool — and so a report survives the deletion.
  deletedAt       DateTime?
  deletedBy       String?   @db.VarChar(12)
  /// Voice note. Peaks are a downsampled waveform so the bubble can render
  /// without fetching the audio.
  audioUrl        String?   @db.VarChar(500)
  audioDurationMs Int?
  audioPeaks      Float[]   @default([])

  group     GroupChat       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  pollVotes GroupPollVote[]

  reactions GroupMessageReaction[]

  @@index([groupId, createdAt])
  @@map("group_message")
}

model GroupMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("group_message_reaction")
}

model GroupPollVote {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())

  message GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("group_poll_vote")
}

/// RMHStudy flashcard deck (#31). Decks are personal but can be shared publicly.
model FlashcardDeck {
  id           String   @id @default(cuid())
  userId       String
  title        String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  isPublic     Boolean  @default(false)
  cardCount    Int      @default(0)
  // Set when this deck was cloned from a public deck (marketplace). Provenance +
  // the "you already added this deck" guard. Not a relation (the source may be
  // deleted); it just records the source deck id.
  clonedFromId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Flashcard[]

  @@index([userId])
  @@index([isPublic, updatedAt(sort: Desc)])
  @@index([userId, clonedFromId])
  @@map("flashcard_deck")
}

model Flashcard {
  id        String   @id @default(cuid())
  deckId    String
  front     String   @db.Text
  back      String   @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())

  deck    FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([deckId])
  @@map("flashcard")
}

/// Per-user spaced-repetition state for a card (SM-2). Lets several users study
/// the same (public) deck with independent schedules.
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
  @@map("flashcard_review")
}

/// A user's saved, persistent playlist of media (music tracks or videos). The
/// apps build ephemeral room queues; this is the durable personal library.
model Playlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(100)
  kind      String   @default("music") @db.VarChar(16) // "music" | "video"
  itemCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("playlist")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  position   Int      @default(0)
