/// A saved draft (scheduledAt = null) or a scheduled post (scheduledAt set).
/// Scheduled posts are materialized into real RMHarks lazily by the publisher
/// once their time is due. `publishedId` links to the created post afterwards.
model ScheduledPost {
  id           String             @id @default(cuid())
  userId       String
  content      String             @db.Text
  gifUrl       String?            @db.Text
  imageUrls    String[]           @default([])
  // Per-image alt text (accessibility), aligned by index with imageUrls.
  imageAlts    String[]           @default([])
  audience     RMHarkAudience     @default(PUBLIC)
  isSensitive  Boolean            @default(false)
  replyControl RMHarkReplyControl @default(EVERYONE)
  unlockPrice  Int?
  communityId  String?
  poll         Json? // { question, options[], multiSelect, durationHours }
  scheduledAt  DateTime? // null = plain draft
  publishedId  String? // set once published → the created RMHark id
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
  @@map("scheduled_post")
}

/// One row per user per UTC day: the daily coin-wheel spin and its reward.
/// The unique [userId, dateKey] enforces once-per-day server-side.
model DailyWheelSpin {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String   @db.VarChar(16) // YYYY-MM-DD (UTC)
  reward    Int
  segment   Int // winning segment index (for animation replay)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId])
  @@map("daily_wheel_spin")
}

/// An interest-bearing coin vault (#18). One per user. Interest accrues lazily:
/// each deposit/withdraw first rolls elapsed time into `accrued` so we never
/// need a background job. `lastAccrued` marks the last roll-up time.
model CoinStake {
  id          String   @id @default(cuid())
  userId      String   @unique
  principal   Int      @default(0)
  accrued     Int      @default(0)
  lastAccrued DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_stake")
}

/// A digital product a creator sells for coins (#19). The `deliverable` (a link,
/// code, or message) is revealed only to the creator and to buyers. A 10%
/// platform fee is burned on each sale as a coin sink.
model StorefrontProduct {
  id          String   @id @default(cuid())
  creatorId   String
  title       String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  price       Int // coins
  deliverable String?  @db.Text
  active      Boolean  @default(true)
  salesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator   User                 @relation("StorefrontCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  purchases StorefrontPurchase[]

  @@index([creatorId])
  @@map("storefront_product")
}

model StorefrontPurchase {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  pricePaid Int
  createdAt DateTime @default(now())

  product StorefrontProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User              @relation("StorefrontBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@map("storefront_purchase")
}

/// A user-authored AI persona chatbot (#8). Its `systemPrompt` shapes replies;
/// conversations are per (persona, user) and stored in AiPersonaMessage.
model AiPersona {
  id           String   @id @default(cuid())
  ownerId      String
  name         String   @db.VarChar(40)
  tagline      String?  @db.VarChar(120)
  systemPrompt String   @db.VarChar(2000)
  greeting     String?  @db.VarChar(500)
  emoji        String?  @db.VarChar(8)
  // AI-generated avatar (xAI → webp in object storage). Null until the
  // background generation kicked off on create succeeds; the UI falls back to
  // the emoji until then.
  avatarUrl    String?  @db.VarChar(500)
  isPublic     Boolean  @default(true)
  chatCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner    User               @relation("PersonaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages AiPersonaMessage[]

  @@index([ownerId])
  @@index([isPublic, chatCount(sort: Desc)])
  @@map("ai_persona")
}

model AiPersonaMessage {
  id        String   @id @default(cuid())
  personaId String
  userId    String
  role      String   @db.VarChar(12) // 'user' | 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now())

  persona AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([personaId, userId, createdAt])
  @@map("ai_persona_message")
}

// ─── RMH Rideshare ─────────────────────────────────────────────────
// Free, community ride-hailing. Riders map pickup/drop-off via OSM and pick
// a ride class (RMH-X, RMH-XL, …). Drivers apply with a license + vehicle
// details; admins review and approve, after which the license image is
// deleted from storage for privacy.

enum RideClass {
  RMH_X
  RMH_XL
  RMH_COMFORT
  RMH_GREEN
  RMH_BLACK
  RMH_BIKE
  RMH_HELI
}

enum DriverApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RideStatus {
  SCHEDULED
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RideshareDriver {
  id     String                  @id @default(cuid())
  userId String                  @unique
  status DriverApplicationStatus @default(PENDING)

  // Vehicle details
  vehicleMake  String    @db.VarChar(60)
  vehicleModel String    @db.VarChar(60)
  vehicleYear  Int
  vehicleColor String    @db.VarChar(30)
  licensePlate String    @db.VarChar(16)
  vehicleClass RideClass @default(RMH_X)
  seats        Int       @default(4)

  // Availability: drivers toggle themselves online to receive ride requests.
  isOnline Boolean @default(false)

  // Live location (updated via heartbeats while a trip is active). Shown to the
  // rider on the trip map; cleared between trips client-side by staleness.
  lastLat           Float?
  lastLng           Float?
  locationUpdatedAt DateTime?

  // Aggregate rating from completed trips (rider → driver).
  ratingCount Int @default(0)
  ratingTotal Int @default(0)

  // Driver's licence number, self-reported on the application. We no longer
  // collect or store licence images.
  licenseNumber String? @db.VarChar(40)

  // Review metadata
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RideshareApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@map("rideshare_driver")
}

model Ride {
  id        String     @id @default(cuid())
  riderId   String
  driverId  String?
  rideClass RideClass  @default(RMH_X)
  status    RideStatus @default(REQUESTED)

  // Pickup
  pickupLabel String @db.VarChar(300)
  pickupLat   Float
  pickupLng   Float

  // Drop-off
  dropoffLabel String @db.VarChar(300)
  dropoffLat   Float
  dropoffLng   Float

  // Trip fare. `estimatedFareCents` is the quote at booking and the amount the
  // rider pays for the trip; it also drives the driver payout split.
  distanceMeters     Int?
  durationSeconds    Int?
  estimatedFareCents Int  @default(0)

  // Optional rider tip, added after a completed trip and paid to the driver
  // in full. Zero until the rider tips.
  tipCents Int @default(0)

  // Set when the rider books a trip for later (status starts as SCHEDULED).
  scheduledFor DateTime?

  notes String? @db.VarChar(500)

  // Post-trip ratings (1–5). `ratingByRider` rates the driver; `ratingByDriver`
  // rates the rider.
  ratingByRider  Int?
  ratingByDriver Int?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  rider    User          @relation("RideRider", fields: [riderId], references: [id], onDelete: Cascade)
  driver   User?         @relation("RideDriver", fields: [driverId], references: [id])
  messages RideMessage[]

  @@index([status, rideClass, requestedAt])
  @@index([riderId])
  @@index([driverId])
  @@map("ride")
}

model RideMessage {
  id        String   @id @default(cuid())
  rideId    String
  senderId  String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
  @@index([senderId])
  @@map("ride_message")
}

model RideSavedPlace {
  id      String @id @default(cuid())
  userId  String
  label   String @db.VarChar(40)
  address String @db.VarChar(300)
  lat     Float
  lng     Float

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ride_saved_place")
}

// ─── RMHHomes: House / Apartment finder ───────────────────────────────────────

/// A listing a user has favorited. We store a full JSON `snapshot` of the
enum HomeListingType {
  RENT
  SALE
}

enum HomePropertyType {
  APARTMENT
  HOUSE
  CONDO
  TOWNHOUSE
  ROOM
  OTHER
}

enum HomeListingStatus {
  ACTIVE
  RENTED
  SOLD
  REMOVED
}

/// Where a listing came from: a real RMH member (COMMUNITY) or an aggregated
/// third-party posting discovered by the scraper (EXTERNAL).
enum HomeListingSource {
  COMMUNITY
  EXTERNAL
}

/// A housing listing. Most are posted by RMH members (`source = COMMUNITY`,
/// owned by `author`); the rest are aggregated from public third-party feeds by
/// the homes scraper (`source = EXTERNAL`, no author, links back to the
/// `externalUrl` original). Both kinds share this table so browse/search, the
/// map, favorites, and watch alerts work uniformly across them.
model HomeListing {
  id           String            @id @default(cuid())
  /// Null for scraped (EXTERNAL) listings, which have no RMH author.
  authorId     String?
  source       HomeListingSource @default(COMMUNITY)
  status       HomeListingStatus @default(ACTIVE)
  listingType  HomeListingType
  propertyType HomePropertyType

  title       String @db.VarChar(120)
  description String @db.VarChar(4000)

  /// Monthly rent (RENT) or total sale price (SALE), in whole USD cents.
  priceCents Int

  beds  Int
  baths Float
  sqft  Int?

  // Location. `lat`/`lng` come from geocoding the address at post time and
  // drive the map + radius search.
  address    String? @db.VarChar(300)
  city       String  @db.VarChar(120)
  state      String  @db.VarChar(64)
  postalCode String? @db.VarChar(16)
  lat        Float
  lng        Float

  amenities     String[]  @default([])
  petsAllowed   Boolean   @default(false)
  availableFrom DateTime?

  /// Photo URLs. For COMMUNITY listings these are uploads (S3/R2); for EXTERNAL
  /// listings they are the third-party CDN URLs from the source feed. First is
  /// the cover image.
  images     String[] @default([])
  /// Subset of `images` that were generated with AI (xAI). Drives the
  /// "Generated by AI" disclaimer shown on those photos. Always empty for
  /// EXTERNAL listings.
  aiImages   String[] @default([])
  viewsCount Int      @default(0)

  // ─── External / scraped listing attribution ─────────────────────────────
  // Populated only when `source = EXTERNAL`; null for community listings.
  /// The scrape source this listing was discovered through.
  sourceRefId String?
  sourceRef   HomeSource? @relation(fields: [sourceRefId], references: [id], onDelete: SetNull)
  /// The provider's own id for this posting (stable across re-scrapes),
  /// used with `sourceRefId` to dedupe/upsert.
  externalId  String?
  /// Canonical URL of the original posting ("View original listing").
  externalUrl String?     @db.VarChar(1000)
  /// Human label for the source, snapshotted for display (e.g. "Craigslist — Rochester").
  sourceName  String?     @db.VarChar(120)
  /// Last time a scrape run saw this posting still live. Drives expiry of
  /// external listings that have disappeared from their feed.
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User?          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites HomeFavorite[]

  @@unique([sourceRefId, externalId])
  @@index([status, listingType, createdAt])
  @@index([source, status, createdAt])
  @@index([city, state])
  @@index([authorId, status])
  @@map("home_listing")
}

/// A user's favorited listing.
model HomeFavorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing HomeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@map("home_favorite")
}

/// A saved-search "watch": when a new listing is posted that matches these
/// criteria, the owner gets an in-app notification. Criteria mirror the browse
/// filters. `priceCents` bounds are stored in cents to match HomeListing.
model HomeWatch {
  id     String @id @default(cuid())
  userId String
  label  String @db.VarChar(120)

  listingType   HomeListingType? // null = any
  propertyTypes HomePropertyType[] @default([])

  // Optional geographic scope: a center + radius (km). When set, matches must
  // fall within the radius. `locationLabel` is shown in the UI.
  locationLabel String? @db.VarChar(200)
  lat           Float?
  lng           Float?
  radiusKm      Int?

  minPriceCents Int?
  maxPriceCents Int?
  minBeds       Int?
  minBaths      Float?
  petsRequired  Boolean @default(false)

  active         Boolean   @default(true)
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([active])
  @@map("home_watch")
}

// ─── RMHHomes: External listing aggregation (scraper) ─────────────────────────

/// The kind of public feed a HomeSource pulls from.
enum HomeSourceProvider {
  /// Craigslist regional RSS search feeds (apartments/housing + real estate).
  CRAIGSLIST
  /// A generic RSS 2.0 housing feed configured by `url`.
  RSS
}

enum HomeSourceStatus {
  ACTIVE
  DISABLED
  /// Last run failed (fetch/parse error).
  ERROR
  /// robots.txt disallows fetching this source.
  BLOCKED
}

enum HomeRunTrigger {
  CRON
  MANUAL
}

/// A public feed the homes scraper polls for third-party listings. Each source
/// yields EXTERNAL `HomeListing` rows tagged with `sourceRefId`.
model HomeSource {
  id       String             @id @default(cuid())
  /// Stable slug used to upsert on (re)seed, e.g. "craigslist:rochester:apa"
  /// or "rss:<url>". A non-null unique avoids Postgres' NULL-distinct pitfall.
  key      String             @unique @db.VarChar(200)
  provider HomeSourceProvider
  /// Display label, e.g. "Craigslist — Rochester". Snapshotted onto listings.
  label    String             @db.VarChar(120)

  // Craigslist config: `region` is the site subdomain (e.g. "rochester") and
  // `category` the search path segment (e.g. "apa"). For RSS sources `url` is
  // the full feed URL instead.
  region      String?         @db.VarChar(64)
  category    String?         @db.VarChar(32)
  url         String?         @db.VarChar(1000)
  listingType HomeListingType @default(RENT)

  // Optional default location for feeds that omit coordinates. Listings whose
  // own coordinates can't be resolved fall back to these.
  defaultCity  String? @db.VarChar(120)
  defaultState String? @db.VarChar(64)
  defaultLat   Float?
  defaultLng   Float?

  status        HomeSourceStatus @default(ACTIVE)
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?          @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings HomeListing[]

  @@index([status])
  @@map("home_source")
}

/// A single run of the homes scraper (cron or manual), for observability.
model HomeScrapeRun {
  id              String         @id @default(cuid())
  trigger         HomeRunTrigger @default(CRON)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  discoveredCount Int            @default(0)
  createdCount    Int            @default(0)
  updatedCount    Int            @default(0)
  expiredCount    Int            @default(0)
  errorCount      Int            @default(0)
  stats           Json?

  @@index([startedAt])
  @@map("home_scrape_run")
}

// ─── Developer API: Media Upload ──────────────────────────────────────────────

enum MediaStatus {
  PENDING
  ATTACHED
}

/// Developer-API uploaded media. The `media_id` is an opaque handle; posts
/// still store the resolved `url` in RMHark.imageUrls. Reclaimed by the
/// reconciling sweep in lib/media/sweep.server.ts.
model Media {
  id          String      @id
  userId      String
  key         String
  url         String
  contentType String
  bytes       Int
  status      MediaStatus @default(PENDING)
  postId      String?
  createdAt   DateTime    @default(now())
  attachedAt  DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         RMHark?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  /// E13 — last time the assets service served this object. Written at most
  /// once a day per key, so the tiering sweep has something to sort on without
  /// a write per request.
  lastAccessAt DateTime?
  /// 'hot' | 'cold'. A cold object is served from infrequent-access storage and
  /// restores on first request; the UI must SAY so ("archived · loads in a
  /// moment") rather than letting it look broken.
  tier         String    @default("hot") @db.VarChar(8)

  @@index([status, createdAt])
  @@index([postId])
  @@index([userId])
}

/// Global daily counter for AI image generations (cost guard). One row per UTC day.
model ImageGenBudget {
  day   String @id // UTC date, "YYYY-MM-DD"
  count Int    @default(0)

  @@map("image_gen_budget")
}

/// A user-uploaded library book. PDF + cover live in R2 (keyed by id); this row
/// is the metadata the bookshelf and reader resolve. The static catalog
/// (public/library + data/library-metadata.json) is unaffected.
model LibraryDocument {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String   @default("")
  pages            Int      @default(0)
  /// Document format: "pdf" (default) or "epub". Drives which reader renders it
  /// and the content-type / extension used to store and serve the file.
  format           String   @default("pdf")
  pdfKey           String
  coverKey         String?
  sizeBytes        Int      @default(0)
  uploadedByUserId String?
  uploadedBy       User?    @relation("LibraryUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reported         Boolean  @default(false)
  hidden           Boolean  @default(false)
  /// Curated/official entry (admin upload or migrated static catalog) — shown in
  /// the "Curated" section above community uploads.
  official         Boolean  @default(false)
  /// Manual sort order within a section (lower first); ties broken by recency.
  position         Int      @default(0)
  /// Original public/library filename when this row was migrated from the bundled
  /// static catalog. Unique so the migration is idempotent and the static list can
  /// dedupe against already-migrated books.
  originFilename   String?  @unique
  /// Preserved table of contents (chapter → page) for migrated/edited books.
  toc              Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([uploadedByUserId])
  @@index([official])
  @@map("library_document")
}

/// A reader-made grouping of books (a "series" / "collection") shown as its own
/// shelf on the library page. A user owns their collections and may only add books
/// they uploaded; admins own "official" collections and may add any book. Members
/// are referenced by book slug (stable for both static-catalog and uploaded books),
/// so a collection can span both without a hard foreign key to LibraryDocument.
model LibraryCollection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  ownerUserId String?
  owner       User?    @relation("LibraryCollectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Curated/official collection (admin-made) — surfaced above community series.
  official    Boolean  @default(false)
  /// R2 key of the collection's (AI-generated) cover image, served via
  /// /api/library/cover/<collectionId>. Null until a cover is generated.
  coverKey    String?
  hidden      Boolean  @default(false)
  /// Manual sort order across collections (lower first).
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LibraryCollectionItem[]

  @@index([ownerUserId])
  @@index([official])
  @@map("library_collection")
}

model LibraryCollectionItem {
  id           String            @id @default(cuid())
  collectionId String
  collection   LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// The member book's slug (resolved to a LibraryBook at read time).
  bookSlug     String
  /// Order within the collection (lower first).
  position     Int               @default(0)
  createdAt    DateTime          @default(now())

  @@unique([collectionId, bookSlug])
  @@index([collectionId])
  @@map("library_collection_item")
}

/// A regular user's appeal to raise their library upload quota, reviewed by an
/// admin in the admin panel. Approving sets the user's libraryUploadQuota.
model LibraryQuotaRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("LibraryQuotaRequests", fields: [userId], references: [id], onDelete: Cascade)
  /// The new total cap the user is asking for.
  requestedTotal  Int
  reason          String    @default("") @db.Text
  /// pending | approved | denied
  status          String    @default("pending")
  decidedByUserId String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([status])
  @@index([userId])
  @@map("library_quota_request")
}

// ─── Albums (library photo/video carousels) ─────────────────────────────────
/// A library album: an ordered set of image/video slides shown in the
/// fullscreen carousel viewer at /library/albums/$slug. Heavy media lives in
/// object storage (R2/S3) keyed by slide id — not in the repo / build image —
/// and is served via the CDN (prod) or the /api/albums/asset proxy (dev).
model Album {
  id          String   @id @default(cuid())
  /// URL slug, e.g. "alex-wu".
  slug        String   @unique
  title       String
  description String   @default("") @db.Text
  /// Manual ordering on the library page (ascending).
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slides AlbumSlide[]

  @@index([position])
  @@map("album")
}

/// One slide in an album. `type` is "image" or "video". Storage keys point at
/// objects in the `albums/` key space (see lib/storage/keys.ts):
///  - images: fullKey (full-res original), srcKey (web-optimized webp), thumbKey
///  - videos: srcKey (compressed mp4), thumbKey (poster frame); fullKey is null.
model AlbumSlide {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  /// "image" | "video".
  type      String
  position  Int      @default(0)
  /// Full-resolution original object key (images only; null for video).
  fullKey   String?
  /// Web-optimized image / compressed video object key.
  srcKey    String
  /// Thumbnail (image) or poster frame (video) object key.
  thumbKey  String
  /// Video MIME type (e.g. "video/mp4"); null for images.
  mime      String?
  alt       String   @default("")
  /// Suggested filename on download.
  download  String   @default("")
  /// Client-supplied idempotency key, stable across upload retries. Lets a
  /// retried upload (e.g. after a lost response) resolve to the same slide
  /// instead of creating a duplicate. Null for migrated/legacy rows.
  uploadKey String?
  createdAt DateTime @default(now())

  @@unique([albumId, uploadKey])
  @@index([albumId, position])
  @@map("album_slide")
}

// ─── Wager Matches (§2) ───────────────────────────────────────────────────
// Coin-staked 1v1 challenges on any wager-eligible skill game. Both players'
// stakes are escrowed in the match row (potCoins) on acceptance and paid to the
// winner (minus rake) on settlement. Settlement is authoritative for
// server-validated games (the hub reports via /api/internal/match-result), and
// falls back to dual-confirmation (both players agree) or admin adjudication.
// Every coin movement is mirrored to CoinTransaction (type WAGER).

enum WagerMatchStatus {
  OPEN // created; awaiting acceptance (open challenge or a named opponent)
  ACCEPTED // both players in, stakes escrowed, awaiting play + result
  LIVE // gameplay in progress
  SETTLED // resolved, pot paid out
  DISPUTED // conflicting self-reports; awaiting admin adjudication
  CANCELLED // declined / cancelled before acceptance — stakes refunded
  EXPIRED // no acceptance before expiresAt — stakes refunded
}

model WagerMatch {
  id           String           @id @default(cuid())
  gameId       String           @db.VarChar(64) // GameInfo.id / app id; must be wager-eligible
  challengerId String
  opponentId   String? // null = open challenge anyone may accept
  stakeCoins   Int // per-player stake
  potCoins     Int              @default(0) // escrowed total (2 × stake once accepted)
  rakeBps      Int              @default(0) // rake in basis points, taken from the pot on settle
  status       WagerMatchStatus @default(OPEN)

  // Result reporting
  winnerId                   String?
  challengerReportedWinnerId String?
  opponentReportedWinnerId   String?
  resultSource               String? @db.VarChar(24) // "authoritative" | "agreement" | "admin" | "forfeit"
  gameSessionRef             String? @db.VarChar(96) // hub room/match id, for authoritative settle
  adminNote                  String? @db.VarChar(500)

  acceptedAt DateTime?
  settledAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  challenger User  @relation("WagerChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User? @relation("WagerOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  winner     User? @relation("WagerWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([gameId, status])
  @@index([gameSessionRef])
  @@map("wager_match")
}

// ─── Tournaments (§1) ─────────────────────────────────────────────────────
// A bracket/round-robin over any wager-eligible game. Entry fees are escrowed
// into prizePoolCoins on registration; the pool (plus any creator seed, minus
// rake) is paid out to finishers on completion. Matches advance event-driven
// as results arrive; no background worker is required.

enum TournamentFormat {
  SINGLE_ELIM
  ROUND_ROBIN
  DOUBLE_ELIM // reserved — not yet implemented by the bracket engine
}

enum TournamentStatus {
  REGISTRATION
  LIVE
  COMPLETE
  CANCELLED
}

enum TournamentMatchState {
  PENDING // waiting on entrants from prior rounds
  READY // both slots filled, awaiting play + result
  LIVE
  COMPLETE
  BYE // auto-advanced (odd bracket)
}

model Tournament {
  id             String           @id @default(cuid())
  name           String           @db.VarChar(120)
  gameId         String           @db.VarChar(64)
  format         TournamentFormat @default(SINGLE_ELIM)
  status         TournamentStatus @default(REGISTRATION)
  entryFeeCoins  Int              @default(0)
  prizePoolCoins Int              @default(0) // escrowed pool (entry fees + seed)
  seedPoolCoins  Int              @default(0) // creator/house guaranteed prize added up front
  rakeBps        Int              @default(0)
  maxPlayers     Int              @default(8)
  minPlayers     Int              @default(2)
  visibility     String           @default("public") @db.VarChar(16)
  createdById    String
  seasonId       String?          @db.VarChar(64) // optional live-ops season link
  startsAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  createdBy User                @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  entrants  TournamentEntrant[]
  matches   TournamentMatch[]
  payouts   TournamentPayout[]

  @@index([status, startsAt])
  @@index([gameId, status])
  @@map("tournament")
}

model TournamentEntrant {
  id           String    @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int?
  placement    Int? // final placement (1 = champion)
  wins         Int       @default(0)
  losses       Int       @default(0)
  eliminatedAt DateTime?
  joinedAt     DateTime  @default(now())

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchesAsA TournamentMatch[] @relation("MatchEntrantA")
  matchesAsB TournamentMatch[] @relation("MatchEntrantB")
  matchesWon TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@index([tournamentId, seed])
  @@map("tournament_entrant")
}

model TournamentMatch {
  id              String               @id @default(cuid())
  tournamentId    String
  round           Int
  slot            Int // position within the round
  entrantAId      String?
  entrantBId      String?
  winnerEntrantId String?
  state           TournamentMatchState @default(PENDING)
  // Where the winner of THIS match flows (single-elim). Plain refs, not a
  // Prisma self-relation, to keep the bracket-linking simple.
  nextMatchId     String?
  nextSlot        Int?
  gameSessionRef  String?              @db.VarChar(96)
  resultSource    String?              @db.VarChar(24)
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantA   TournamentEntrant? @relation("MatchEntrantA", fields: [entrantAId], references: [id], onDelete: SetNull)
  entrantB   TournamentEntrant? @relation("MatchEntrantB", fields: [entrantBId], references: [id], onDelete: SetNull)
  winner     TournamentEntrant? @relation("MatchWinner", fields: [winnerEntrantId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, slot])
  @@index([tournamentId, state])
  @@index([gameSessionRef])
  @@map("tournament_match")
}

model TournamentPayout {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String // plain ref — historical record, no cascade needed
  placement    Int
  amountCoins  Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("tournament_payout")
}

// ─── Creator coin → value bridge (§4) ─────────────────────────────────────
// Creators convert coins provably EARNED from creator activity (tips,
// memberships, storefront/unlock sales) into real value: subscription credit
// (granted internally via GiftMembership, no Stripe), merch, or a gated cash
// payout. Requests are admin-reviewed. "Earned" is derived from the ledger, so
// there is no stored earned-balance column — see lib/creator/earnings.server.ts.

enum RedemptionKind {
  SUB_CREDIT // burn coins → subscription time (GiftMembership)
  MERCH // burn coins → merch reward, fulfilled manually
  PAYOUT // burn coins → cash payout (gated: verified creator + admin/KYC)
}

enum RedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

model RedemptionRequest {
  id             String           @id @default(cuid())
  userId         String
  kind           RedemptionKind
  amountCoins    Int // coins to burn on fulfilment
  tierGranted    String?          @db.VarChar(16) // SUB_CREDIT: 'starter' | 'pro'
  monthsGranted  Int? // SUB_CREDIT
  fiatValueCents Int? // MERCH/PAYOUT accounting/display
  note           String?          @db.VarChar(500) // requester note / fulfilment reference id
  status         RedemptionStatus @default(PENDING)
  reviewedById   String?
  reviewNote     String?          @db.VarChar(500)
  externalRef    String?          @db.VarChar(120) // Stripe transfer id / shipment tracking
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?
  fulfilledAt    DateTime?

  user       User  @relation("RedemptionCreator", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RedemptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("redemption_request")
}

// ═══════════════════════════════════════════════════════════════════════════
// Platform expansion (design: docs/plans/2026-07-19-platform-expansion-design.md)
// Twelve features specified as deltas over the shipped economy/quest/realtime
// systems. New tables only where a new noun exists; every coin flow still lands
// in CoinTransaction.
// ═══════════════════════════════════════════════════════════════════════════

// ─── Arcade Pass (§2) ──────────────────────────────────────────────────────
// One row per user tracking the cross-game daily-challenge streak. Challenge
// *definitions* and per-challenge progress are code-driven / reuse UserQuest
// (questId "a.<day>.<game>.<metric>"); only the streak needs storage.
model ArcadeStreak {
  userId    String   @id
  current   Int      @default(0)
  best      Int      @default(0)
  lastDay   String?  @db.VarChar(10) // UTC day key "2026-07-19"
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("arcade_streak")
}

// ─── Creator Studio (§3) ───────────────────────────────────────────────────
// A creator-defined membership tier (max 3 per creator, enforced in code).
model CreatorTier {
  id         String   @id @default(cuid())
  creatorId  String
  name       String   @db.VarChar(40)
  priceCoins Int // per 30 days
  perks      Json     @default("[]") // ordered perk keys: 'badge'|'posts'|'chat'|'early_builds'
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  creator      User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships  CreatorMembership[]
  creatorPosts CreatorPost[]

  @@index([creatorId, active])
  @@map("creator_tier")
}

// ─── Live Spaces (§4) ──────────────────────────────────────────────────────
enum SpaceStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Space {
  id          String      @id @default(cuid())
  hostId      String
  communityId String? // null = profile-hosted
  title       String      @db.VarChar(120)
  status      SpaceStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  pinned      Json? // { kind: 'post'|'url'|'music_room'|'tube_room', ref }
  recordChat  Boolean     @default(true) // transcript visible after end
  createdAt   DateTime    @default(now())

  host      User           @relation("SpaceHost", fields: [hostId], references: [id], onDelete: Cascade)
  community Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  messages  SpaceMessage[]

  @@index([status, startedAt(sort: Desc)])
  @@index([communityId, status])
  @@map("space")
}

model SpaceMessage {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId, createdAt])
  @@map("space_message")
}

// ─── RMHEvents (§6) ────────────────────────────────────────────────────────
enum EventVenueKind {
  SPACE
  TOURNAMENT
  GAME
  URL
  IRL
}

model CommunityEvent {
  id          String         @id @default(cuid())
  hostId      String
  communityId String? // null = profile-hosted
  title       String         @db.VarChar(120)
  description String         @db.VarChar(2000)
  startsAt    DateTime
  endsAt      DateTime?
  venueKind   EventVenueKind
  venueRef    String?        @db.VarChar(191) // spaceId / tournamentId / game id / URL (SSRF-guarded)
  capacity    Int?
  canceledAt  DateTime?
  createdAt   DateTime       @default(now())

  host      User        @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rsvps     EventRsvp[]

  @@index([communityId, startsAt])
  @@index([startsAt])
  @@map("community_event")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @db.VarChar(8) // 'going' | 'maybe'
  createdAt DateTime @default(now())

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@map("event_rsvp")
}

// ─── Replays as content (§7) ───────────────────────────────────────────────
model GameReplay {
  id         String   @id @default(cuid())
  userId     String
  game       String   @db.VarChar(32)
  version    String   @db.VarChar(16) // game logic version for playback compat
  score      Int?
  durationMs Int
  data       Json // { seed, inputs } | { snapshots } — zod-validated per game
  sizeBytes  Int // enforced cap (e.g. 256 KB)
  visibility String   @default("public") @db.VarChar(8) // 'public' | 'unlisted'
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, score(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("game_replay")
}

// ─── Player Marketplace (§8) ───────────────────────────────────────────────
enum ListingStatus {
  ACTIVE
  SOLD
  CANCELED
  HELD // flagged for admin review (anomalous price); funds not yet released
}

model MarketListing {
  id          String        @id @default(cuid())
  sellerId    String
  inventoryId String        @unique // the exact UserInventory row held in escrow
  itemId      String        @db.VarChar(64)
  priceCoins  Int
  status      ListingStatus @default(ACTIVE)
  buyerId     String?
  createdAt   DateTime      @default(now())
  closedAt    DateTime?

  seller User  @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User? @relation("MarketBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([status, itemId, priceCoins])
  @@index([sellerId, status])
  @@map("market_listing")
}

// ─── Shareable stat cards (§13) ────────────────────────────────────────────
// Created only when a user chooses to share a moment (nothing public by
// default). Deleting the row kills the landing page and 404s the OG route.
model SharedMoment {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(24) // 'achievement'|'rank'|'streak'|'pass_tier'|'arcade'|'wrapped_stat'|'market'
  payload   Json // snapshot at share time: { title, value, subtitle, ... }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("shared_moment")
}

// ─── Parity / QOL / customization (2026-07-20 design) ───────────────────────

// Unified Saves (§4): user-created folders holding polymorphic saved items
// (posts, builds, songs, …). Addressing reuses the ledger's
// entityType/entityId convention. Replaces the flat, posts-only bookmark.
model SaveFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(40)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItem[]

  @@index([userId, sortOrder])
  @@map("save_folder")
}

model SavedItem {
  id         String   @id @default(cuid())
  userId     String
  folderId   String? // null = default "Saved"
  entityType String   @db.VarChar(24) // see SAVE_ENTITY_TYPES in lib/saves/types.ts
  entityId   String
  createdAt  DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder SaveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, entityType, entityId])
  @@index([userId, folderId, createdAt(sort: Desc)])
  // Reverse lookup: "how many people saved this?" — the insights panel counts
  // saves per post. `RMHarkBookmark` carried an equivalent `@@index([rmheetId])`
  // and this table inherited its rows without inheriting the index, which would
  // have turned that count into a full scan of every save on the site.
  @@index([entityType, entityId])
  @@map("saved_item")
}

// History & resume (§5): most-recent visit per (user, entity), with an optional
// playback `position` for resume. Upserted by a throttled client heartbeat;
// swept after HISTORY_RETENTION_DAYS.
model HistoryEntry {
  id         String   @id @default(cuid())
  userId     String
  entityType String   @db.VarChar(24) // 'tube_video' | 'song' | 'game' | 'library_doc' | 'news' | ...
  entityId   String
  position   Int? // seconds (media) | percent*100 (docs) | null (games)
  duration   Int?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("history_entry")
}

// Post awards (§7): a public, paid recognition badge pinned to content. The
// coin flow lands in the existing ledger (recipient share as TIP, giver spend
// as PURCHASE) — no new CoinTxnType.
model ContentAward {
  id         String   @id @default(cuid())
  awardId    String   @db.VarChar(32) // catalog key (lib/awards/catalog.ts)
  giverId    String
  anonymous  Boolean  @default(false)
  hidden     Boolean  @default(false) // recipient hid it
  entityType String   @db.VarChar(24) // 'rmhark' | 'comment' | 'build' | 'guide'
  entityId   String
  createdAt  DateTime @default(now())

  giver User @relation(fields: [giverId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([giverId, createdAt(sort: Desc)])
  @@map("content_award")
}

// Wishlists (§8): what a user wants — shop items, market cosmetics, or a
// creator's future builds. Powers price/publish alerts and gifting.
model WishlistEntry {
  id          String   @id @default(cuid())
  userId      String
  entityType  String   @db.VarChar(24) // 'shop_item' | 'market_cosmetic' | 'creator_builds'
  entityId    String // catalog key | itemId | creatorId
  targetPrice Int? // coins; market alerts only
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId]) // reverse index: who wants this?
  @@map("wishlist_entry")
}

// Close Friends circle (§11): one private circle per owner. Membership is
// silent (no notifications) and never publicly visible. CIRCLE-audience posts
// are visible only to the owner and their circle members.
model CloseFriend {
  ownerId  String
  memberId String
  addedAt  DateTime @default(now())

  owner  User @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("CircleMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([ownerId, memberId])
  @@index([memberId]) // viewer-side feed predicate: circles I'm in
  @@map("close_friend")
}

// Lists & custom feeds (§3): user-curated lists of accounts, read as their own
// chronological timeline. PRIVATE by default; UNLISTED is link-shareable;
// PUBLIC is discoverable (phase 2 — schema-ready, UI-gated).
enum ListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model UserList {
  id         String         @id @default(cuid())
  ownerId    String
  name       String         @db.VarChar(50)
  bio        String?        @db.VarChar(200)
  visibility ListVisibility @default(PRIVATE)
  pinned     Boolean        @default(false)
  createdAt  DateTime       @default(now())

  owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members UserListMember[]

  @@index([ownerId])
  @@map("user_list")
}

model UserListMember {
  listId  String
  userId  String
  addedAt DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId]) // "lists you're on"
  @@map("user_list_member")
}

// Feed controls (§17): reader tuning signals. 'mute_tag' filters a hashtag out;
// 'less_author' demotes an author (applied in ranking — recorded here);
// 'follow_tag' boosts a topic. Every signal is inspectable + reversible in
// settings (the transparency half).
model FeedSignal {
  userId    String
  kind      String   @db.VarChar(16) // 'less_author' | 'mute_tag' | 'follow_tag'
  targetId  String   @db.VarChar(64) // authorId | tag (lowercase, no '#')
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, targetId])
  @@index([userId, kind])
  @@map("feed_signal")
}

// Game hubs (§6): per-game reviews, ratings, and player guides.
model GameReview {
  id        String   @id @default(cuid())
  userId    String
  gameId    String   @db.VarChar(40) // key from lib/games.ts
  stars     Int // 1..5 (zod)
  body      String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes GameReviewVote[]

  @@unique([userId, gameId])
  @@index([gameId, createdAt(sort: Desc)])
  @@map("game_review")
}

model GameReviewVote {
  reviewId String
  userId   String
  helpful  Boolean

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("game_review_vote")
}

model GameGuide {
  id        String   @id @default(cuid())
  authorId  String
  gameId    String   @db.VarChar(40)
  title     String   @db.VarChar(120)
  body      String // markdown, current revision
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  revisions GameGuideRevision[]

  @@index([gameId, published, updatedAt(sort: Desc)])
  @@map("game_guide")
}

model GameGuideRevision {
  id        String   @id @default(cuid())
  guideId   String
  body      String
  note      String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  guide GameGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, createdAt(sort: Desc)])
  @@map("game_guide_revision")
}

// Theme Studio (§14): user-authored site themes as a marketplace cosmetic.
// `tokens` is a closed, versioned token map (lib/themes/tokens.ts) — never CSS
// strings — so publishing a theme can't inject styles. Ownership rides
// UserInventory (kind THEME, itemId "user:<themeId>").
enum UserThemeStatus {
  DRAFT
  PUBLISHED
  DELISTED
}

model UserTheme {
  id         String          @id @default(cuid())
  authorId   String
  name       String          @db.VarChar(40)
  tokens     Json // { v: 1, ...closed key set }
  status     UserThemeStatus @default(DRAFT)
  priceCoins Int? // null while draft; 200–5000 published
  sales      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, sales(sort: Desc)])
  @@index([authorId])
  @@map("user_theme")
}

// Profile v2 (§12): a composable profile showcase. `modules` is an ordered,
// zod-validated list of { kind, config } blocks (lib/profile/modules.ts).
// Empty = the classic profile (unedited profiles are unchanged).
model ProfileLayout {
  userId    String   @id
  modules   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_layout")
}

// Universal search v2 (§18): site-wide saved searches (promotes the
// ladder-only pattern). Optional weekly new-result alerts.
model SavedSearch {
  id        String    @id @default(cuid())
  userId    String
  query     String    @db.VarChar(200) // raw query incl. operators
  types     Json      @default("[]") // entity-type chips
  alerts    Boolean   @default(false)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())

  /// B8 — which list surface this view belongs to ('search' | 'ladder' |
  /// 'homes' | 'market' | 'arcade' | an admin queue). Defaults to 'search' so
  /// every existing row keeps meaning exactly what it meant.
  surface String  @default("search") @db.VarChar(24)
  /// Filter state, validated per surface at READ time rather than write time —
  /// so a filter removed from a surface degrades to "drop the unknown key"
  /// instead of crashing the page on a stale view.
  payload Json    @default("{}")
  /// User-given name. Null keeps the old behaviour of labelling by query text.
  name    String? @db.VarChar(60)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, surface])
  @@map("saved_search")
}

// ─── Emoji & sticker packs ──────────────────────────────────────────────────
//
// Creating a pack is a membership feature (`custom-emoji` / `sticker-packs` in
// lib/entitlements/features.ts); SUBSCRIBING to and using one is free for
// everyone. That asymmetry is the whole design: members supply the content, and
// the content is what makes the site feel alive for the people who don't pay.
//
// Items are moderated before they render in anyone else's conversation — a
// custom emoji is a user-supplied image drawn inline at small size in someone
// else's thread, which is the classic vector for shipping a slur as a picture.

model EmojiPack {
  id              String   @id @default(cuid())
  ownerId         String
  /// Share-link identity. Immutable once published.
  slug            String   @unique @db.VarChar(48)
  name            String   @db.VarChar(60)
  description     String?  @db.VarChar(300)
  /// 'emoji' (inline, shortcode-addressable) | 'sticker' (large, standalone) | 'mixed'
  kind            String   @default("emoji") @db.VarChar(8)
  coverUrl        String?  @db.VarChar(500)
  /// 'public' — listed and searchable | 'unlisted' — link only | 'private' — owner only
  visibility      String   @default("public") @db.VarChar(8)
  /// PENDING | APPROVED | REMOVED. Only APPROVED packs are usable by non-owners.
  status          String   @default("PENDING") @db.VarChar(12)
  itemCount       Int      @default(0)
  subscriberCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items         EmojiPackItem[]
  subscriptions EmojiPackSubscription[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, visibility, subscriberCount(sort: Desc)])
  @@map("emoji_pack")
}

model EmojiPackItem {
  id         String   @id @default(cuid())
  packId     String
  /// Shortcode without colons. Unique within a pack; resolution across packs is
  /// ordered by the subscriber's pack order, so a collision is a preference and
  /// not an error.
  name       String   @db.VarChar(32)
  /// 'emoji' | 'sticker'
  kind       String   @default("emoji") @db.VarChar(8)
  url        String   @db.VarChar(500)
  /// Mandatory. A custom emoji with no alt text is invisible to a screen reader
  /// and to anyone whose images fail to load, so it is not optional at any tier.
  alt        String   @db.VarChar(140)
  /// Animated items are frozen to their first frame under prefers-reduced-motion.
  animated   Boolean  @default(false)
  position   Int      @default(0)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  pack EmojiPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, name])
  @@index([packId, position])
  @@map("emoji_pack_item")
}

model EmojiPackSubscription {
  packId    String
  userId    String
  /// The subscriber's ordering, which decides shortcode precedence on collision.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  pack EmojiPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([packId, userId])
  @@index([userId, position])
  @@map("emoji_pack_subscription")
}

/// A 1:1 voice call.
///
/// Media never touches our servers: two participants means plain peer-to-peer
/// WebRTC, so there is no SFU and no media relay to run (the group-audio design
/// in docs/plans/2026-07-19 needed one; this does not). What is persisted here
/// is only the call *record* — who called whom, when, and how it ended — so a
/// conversation can show "Missed voice call" the way every messenger does.
///
/// No audio is recorded, and there is nowhere for it to be recorded to.
model Call {
  id             String  @id @default(cuid())
  callerId       String
  calleeId       String
  /// The DM thread this call belongs to, when it started from one. Null for a
  /// call started from a profile.
  conversationId String?

  /// ringing → connected → ended, or ringing → (missed | declined | cancelled | failed).
  status CallStatus @default(RINGING)

  createdAt   DateTime  @default(now())
  /// When ICE actually connected — the difference between "they picked up" and
  /// "it rang". Null for every terminal status except ENDED.
  connectedAt DateTime?
  endedAt     DateTime?
  /// Denormalised talk time in seconds, for the history row. 0 unless connected.
  durationSec Int       @default(0)

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([calleeId, createdAt(sort: Desc)])
  @@index([callerId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("call")
}

enum CallStatus {
  /// Invite sent, waiting for the callee.
  RINGING
  /// Accepted and media flowing.
  CONNECTED
  /// Hung up by either side after connecting.
  ENDED
  /// Rang out without an answer.
  MISSED
  /// Callee actively declined.
  DECLINED
  /// Caller hung up before it was answered.
  CANCELLED
  /// Callee was already in a call.
  BUSY
  /// Signalling or ICE never completed — the honest outcome when TURN is
  /// unavailable and both peers are behind symmetric NAT.
  FAILED
}

/// A long-running content operation the user asked for in bulk.
///
/// Job-backed because a 4,000-row delete must not run inside a request, and
/// because the preview count the UI showed has to be the count that actually
/// runs. Deletes go through the same soft delete as a single one, so a bulk
/// delete is undoable from the recycle bin for its retention window.
model BulkOperation {
  id         String    @id @default(cuid())
  userId     String
  /// 'delete-posts' | 'delete-comments' | 'unfollow' | 'clear-history' | 'clear-bookmarks'
  kind       String    @db.VarChar(24)
  /// { olderThanDays?, before?, maxLikes?, onlyReplies?, tag? }
  filter     Json
  /// PENDING | RUNNING | DONE | CANCELLED | FAILED
  status     String    @default("PENDING") @db.VarChar(12)
  total      Int       @default(0)
  processed  Int       @default(0)
  error      String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("bulk_operation")
}

/// Single-use account recovery codes. Hashed at rest — a plaintext recovery
/// code is a password that never expires.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(200)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

/// People who can vouch for a recovery request.
model TrustedContact {
  id          String    @id @default(cuid())
  userId      String
  contactId   String
  /// The contact has to accept; an unconfirmed nomination cannot vouch.
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User @relation("TrustedContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("TrustedContactPerson", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([contactId])
  @@map("trusted_contact")
}

/// An in-flight account recovery. Deliberately slow: a mandatory delay and a
/// notification to every existing session, or this is a social-engineering
/// vector rather than a recovery path.
model RecoveryRequest {
  id         String   @id @default(cuid())
  userId     String
  /// PENDING | APPROVED | REJECTED | EXPIRED | USED
  status     String   @default("PENDING") @db.VarChar(12)
  approvals  Int      @default(0)
  /// Who has vouched, so nobody can vouch twice.
  approvedBy String[] @default([])
  tokenHash  String   @db.VarChar(200)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("recovery_request")
}

/// "Delete for me" — hides one message for one side of a conversation.
model DirectMessageHide {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("direct_message_hide")
}

/// Per-key typing aggregates.
///
/// Aggregate ONLY, per single character, never ordered — so this table cannot
/// reconstruct anything that was typed. A bigram or sequence table could, and
/// no typing statistic is worth shipping a keylogger for.
model RmhTypeKeyStat {
  userId    String
  key       String   @db.VarChar(4)
  layout    String   @default("qwerty") @db.VarChar(16)
  attempts  Int      @default(0)
  errors    Int      @default(0)
  totalMs   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key, layout])
  @@map("rmhtype_key_stat")
}

/// A profile link, promoted out of the JSON blob it used to live in so it can
/// carry verification state and be indexed by.
model ProfileLink {
  id            String    @id @default(cuid())
  userId        String
  url           String    @db.VarChar(300)
  label         String?   @db.VarChar(60)
  position      Int       @default(0)
  /// Set when the target page links back with rel="me" to this profile.
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  /// Normalised host, so "which accounts claim this domain?" is one query —
  /// which is what an impersonation investigation actually runs.
  host          String?   @db.VarChar(200)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([host])
  @@map("profile_link")
}

/// Handle history. An account can build trust as @alice and hand the handle
/// over; without this the history is gone.
model HandleChange {
  id        String   @id @default(cuid())
  userId    String
  oldHandle String   @db.VarChar(30)
  newHandle String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([oldHandle])
  @@map("handle_change")
}

/// A speedrun category — "any%", "no-shards" — per game.
model SpeedrunCategory {
  id      String  @id @default(cuid())
  game    String  @db.VarChar(32)
  slug    String  @db.VarChar(32)
  name    String  @db.VarChar(60)
  rules   String  @db.VarChar(2000)
  /// 'time' | 'score'
  metric  String  @default("time") @db.VarChar(12)
  /// Leaderboards are per game version: an update invalidates old replays, and
  /// silently mixing versions is how a speedrun board loses its meaning.
  version String  @db.VarChar(16)
  active  Boolean @default(true)

  entries SpeedrunEntry[]

  @@unique([game, slug, version])
  @@index([game, active])
  @@map("speedrun_category")
}

/// A submitted run. Verified by re-simulating the stored replay's inputs —
/// which is why the run must reference a replay rather than a claimed time.
model SpeedrunEntry {
  id           String    @id @default(cuid())
  categoryId   String
  userId       String
  replayId     String    @unique
  timeMs       Int
  score        Int?
  /// pending | verified | rejected
  status       String    @default("pending") @db.VarChar(10)
  rejectReason String?   @db.VarChar(200)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  category SpeedrunCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId, status, timeMs])
  @@index([userId, createdAt(sort: Desc)])
  @@map("speedrun_entry")
}

/// The answers every ATS asks, stored once.
///
/// This is sensitive personal data — salary expectations and EEO answers above
/// all — so it belongs in the account export and delete flows from day one.
model LadderAnswerBank {
  userId             String   @id
  workAuthorization  String?  @db.VarChar(120)
  needsSponsorship   Boolean?
  noticePeriod       String?  @db.VarChar(60)
  salaryExpectation  String?  @db.VarChar(60)
  locationPreference String?  @db.VarChar(120)
  linkedinUrl        String?  @db.VarChar(300)
  portfolioUrl       String?  @db.VarChar(300)
  /// [{ question, answer }] — the essays that repeat across applications.
  essays             Json     @default("[]")
  /// [{ title, situation, task, action, result }] — matched to a posting by
  /// the prep sheet.
  stories            Json     @default("[]")
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ladder_answer_bank")
}

// ═══════════════════════════════════════════════════════════════════════════
// The Next 100 — 2026-08-05
// (docs/plans/2026-08-05-next-100-feature-ideas.md)
//
// All new tables here follow the R0-T7 PK policy: append-only / high-volume
// tables take a BigInt identity rather than a cuid(), so inserts stay local and
// a scan does not need a second (fk, createdAt) index.
// ═══════════════════════════════════════════════════════════════════════════

/// Site-route idempotency replay (E5).
///
/// The developer API's `ApiIdempotencyKey` is keyed to a `DeveloperApiKey`, so
/// it cannot serve the site's own mutations. This is the user-scoped twin, with
/// the same request-hash conflict rule: the same key sent with a different body
/// is a 409, not a silent replay of the wrong response.
model SiteIdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  idempotency  String   @db.VarChar(255)
  method       String   @db.VarChar(8)
  path         String   @db.VarChar(255)
  requestHash  String   @db.VarChar(64)
  /// Null while the first request is still in flight — the row is claimed
  /// BEFORE the handler runs so a concurrent duplicate loses the race rather
  /// than executing twice.
  statusCode   Int?
  responseBody String?  @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotency])
  @@index([createdAt])
  @@map("site_idempotency_key")
}

/// Per-call AI metering (A2). One row per model call, append-only.
model AiUsage {
  id         BigInt   @id @default(autoincrement())
  userId     String?
  /// An `AiTask` from lib/ai/provider.server.ts.
  task       String   @db.VarChar(40)
  provider   String   @db.VarChar(20)
  model      String   @db.VarChar(60)
  /// Prompt id + version from the registry, so a quality regression is a query.
  promptId   String?  @db.VarChar(60)
  promptVer  Int?
  inTokens   Int      @default(0)
  outTokens  Int      @default(0)
  /// Micro-dollars — integer, so a month's SUM has no float drift.
  costMicros Int      @default(0)
  ok         Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ai_usage")
}

/// Cross-device read position for long-form content (B7).
model ReadPosition {
  userId    String
  /// 'library' | 'news' | 'blog' | 'docs'
  kind      String   @db.VarChar(20)
  entityId  String
  /// 0–1. Paired with an anchor so a reflow at a different width still lands.
  fraction  Float    @default(0)
  anchorId  String?  @db.VarChar(120)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, entityId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("read_position")
}

/// The unified activity stream (C7).
///
/// History, recents, saves and bookmarks each answered "things this user
/// touched" with a different storage strategy. This is the append-only source
/// the resume rail (B2), cross-app quest chains (F19) and the "now" profile
/// block (F8) all project from. Writes are buffered — a view event per scroll
/// against a synchronous insert would be catastrophic.
model Activity {
  id       BigInt       @id @default(autoincrement())
  userId   String
  verb     ActivityVerb
  /// 'post' | 'game' | 'doc' | 'video' | 'deck' | 'build' | …
  kind     String       @db.VarChar(24)
  entityId String
  meta     Json         @default("{}")
  at       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at(sort: Desc)])
  @@index([userId, verb, at(sort: Desc)])
  @@index([kind, entityId, at(sort: Desc)])
  @@map("activity")
}

enum ActivityVerb {
  VIEWED
  PLAYED
  SAVED
  COMPLETED
  RATED
  SHARED
}

/// The default per-game stat row (C4).
///
/// `lib/game/adapters.server.ts` is right that rewriting the ~12 bespoke
/// `*Player` tables would be a large migration for no user benefit. The cost of
/// leaving it there is that every NEW scored game still needs a table, a
/// migration and an adapter. This is what a new game uses instead; the bespoke
/// adapters are untouched.
model GameStat {
  id        BigInt   @id @default(autoincrement())
  gameId    String   @db.VarChar(60)
  userId    String
  username  String?  @db.VarChar(60)
  score     Int      @default(0)
  progress  Int      @default(0)
  plays     Int      @default(1)
  /// Game-specific numeric extras, so a new game needs no migration at all.
  meta      Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId, score(sort: Desc)])
  @@map("game_stat")
}

/// Held deliveries awaiting a quiet-hours window close (B13).
///
/// `lib/notify/dispatch.server.ts` already suppresses push during quiet hours —
/// but it DROPS the notification rather than holding it, so a user with quiet
/// hours on simply never learns about anything that happened overnight. These
/// rows are flushed as one grouped delivery when the window ends.
model HeldNotification {
  id        BigInt    @id @default(autoincrement())
  userId    String
  category  String    @db.VarChar(40)
  channel   String    @db.VarChar(10)
  payload   Json
  /// Collapses duplicates inside a window — same key, one delivery.
  dedupeKey String?   @db.VarChar(160)
  heldAt    DateTime  @default(now())
  flushedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, flushedAt, heldAt])
  @@map("held_notification")
}

/// Per-conversation notification control (B14).
///
/// `mentionsOnly` is the setting people actually want out of a busy group and
/// almost no product offers; it is deliberately the middle option of three
/// rather than something buried under a mute submenu.
model ConversationPref {
  userId       String
  /// Discriminated: 'dm:<id>' | 'group:<id>' | 'space:<id>'
  scopeKey     String    @db.VarChar(80)
  /// Null = not muted. A far-future date = muted indefinitely.
  muteUntil    DateTime?
  mentionsOnly Boolean   @default(false)
  pinned       Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scopeKey])
  @@index([userId, pinned])
  @@map("conversation_pref")
}

/// Transactional outbox (E4).
///
/// Webhook and notification delivery ran inside the request that caused the
/// event, so a crash between the commit and the send lost it with no trace.
/// Writing the intent in the same transaction as the state change makes
/// delivery at-least-once — which is why E5's idempotency keys are a
/// prerequisite and not a nicety.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  /// 'webhook.post.created' | 'notify.mention' | 'delivery.email' | …
  topic       String    @db.VarChar(80)
  payload     Json
  attempts    Int       @default(0)
  nextAttempt DateTime  @default(now())
  deliveredAt DateTime?
  /// Set when attempts are exhausted; the row stays for inspection.
  deadAt      DateTime?
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, deadAt, nextAttempt])
  @@index([topic, createdAt(sort: Desc)])
  @@map("outbox_event")
}

/// Resumable backfill checkpoints (E9).
model BackfillCheckpoint {
  name      String    @id @db.VarChar(80)
  cursor    String?
  processed Int       @default(0)
  startedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doneAt    DateTime?

  @@map("backfill_checkpoint")
}

/// Nightly achievement rarity rollup (F7).
///
/// Rarity is the entire psychology of a badge case: an achievement 0.4% of
/// players hold is worth displaying, one 90% hold is not. Computed nightly
/// rather than per request — it is a full-table count.
model AchievementRarity {
  achievementId String   @id @db.VarChar(80)
  holders       Int      @default(0)
  /// Share of non-banned accounts holding it, 0–1.
  pct           Float    @default(0)
  computedAt    DateTime @default(now())

  @@index([pct])
  @@map("achievement_rarity")
}

/// Public feature requests with voting (F22).
///
/// The `declined` and `shipped` statuses REQUIRE `officialNote` — enforced in
/// `lib/requests/`, not by the database, because Prisma cannot express a
/// conditional NOT NULL. A board where things quietly rot in `open` is worse
/// than no board: it converts hope into resentment.
model FeatureRequest {
  id           String        @id @default(cuid())
  authorId     String
  title        String        @db.VarChar(120)
  body         String        @db.Text
  status       RequestStatus @default(OPEN)
  officialNote String?       @db.Text
  /// Duplicate handling — votes follow the merge target.
  mergedIntoId String?
  voteCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mergedInto FeatureRequest?      @relation("RequestMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  duplicates FeatureRequest[]     @relation("RequestMerge")
  votes      FeatureRequestVote[]

  @@index([status, voteCount(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("feature_request")
}

model FeatureRequestVote {
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@map("feature_request_vote")
}

enum RequestStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

// ═══════════════════════════════════════════════════════════════════════════
// The Next 100 — batch 2 (F4, F5, F6, F8, F9, F10, F17, F19, F20, F21, E13)
// ═══════════════════════════════════════════════════════════════════════════

/// Creator-authored long-form with per-tier gating (F4).
///
/// `BlogPost` is admin-authored; `CreatorMembership`/`CreatorTier` already let
/// creators charge. The missing piece was anything long enough to be worth the
/// money. The paywall is enforced in the loader — the gated body is NEVER sent
/// to the client and hidden with CSS, which is the mistake this shape exists to
/// make impossible.
model CreatorPost {
  id           String    @id @default(cuid())
  authorId     String
  title        String    @db.VarChar(160)
  slug         String    @db.VarChar(160)
  bodyMarkdown String    @db.Text
  /// Null = public. Otherwise the minimum CreatorTier required to read it.
  minTierId    String?
  /// The free preview above the paywall — the actual conversion lever, and
  /// what makes the page indexable without cloaking.
  teaser       String?   @db.Text
  coverKey     String?   @db.VarChar(300)
  publishedAt  DateTime?
  emailedAt    DateTime?
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  minTier CreatorTier? @relation(fields: [minTierId], references: [id], onDelete: SetNull)

  @@unique([authorId, slug])
  @@index([authorId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@map("creator_post")
}

/// Nightly per-post analytics rollup (F5).
///
/// Totals tell a creator what happened and never why. These are the three
/// views that change behaviour — where readers leave, where they came from,
/// and whether the post won or lost followers. Rolled up nightly rather than
/// computed per request: it is an aggregate over RMHarkView.
model PostAnalyticsDaily {
  id             BigInt   @id @default(autoincrement())
  postId         String
  day            DateTime @db.Date
  views          Int      @default(0)
  uniques        Int      @default(0)
  /// Share of viewers still present at each 10% depth — where people leave.
  retention      Json     @default("[]")
  /// { feed, profile, search, external, notification, share } → count
  sources        Json     @default("{}")
  followsGained  Int      @default(0)
  followsLost    Int      @default(0)
  /// Median seconds on post, split first-time vs returning.
  dwellFirst     Int      @default(0)
  dwellReturning Int      @default(0)

  post RMHark @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, day])
  @@index([day])
  @@map("post_analytics_daily")
}

/// Referral milestones, paid on ACTIVATION rather than signup (F6).
///
/// `Referral` already records who invited whom. What was missing is the loop:
/// a referrer who brings ten active people and one who brings ten bounces were
/// indistinguishable. Rewarding activation is also the anti-fraud posture —
/// signup is free to fake, three separate active days is not.
model ReferralMilestone {
  id        String   @id @default(cuid())
  userId    String
  /// Count of ACTIVATED referrals this milestone was granted for.
  threshold Int
  coins     Int      @default(0)
  cosmetic  String?  @db.VarChar(60)
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threshold])
  @@index([userId])
  @@map("referral_milestone")
}

/// Ordered blocks for the link-in-bio page (F8).
///
/// `ProfileLink` stays the source of truth for links (it carries the `rel=me`
/// verification). This is the *layout* around them, which is why a block can
/// reference a link, embed a platform object, or render a live "now playing"
/// pulled from the Activity stream — the one thing no link-in-bio service can
/// offer.
model ProfileBlock {
  id        String   @id @default(cuid())
  userId    String
  /// 'link' | 'heading' | 'embed' | 'now'
  kind      String   @db.VarChar(12)
  position  Int      @default(0)
  /// Shape depends on kind; validated by lib/profile-links/blocks.ts.
  config    Json     @default("{}")
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("profile_block")
}

/// Synchronised reading (F9).
///
/// `RmhTubeRoom` synchronises a playhead; this synchronises a *position*.
/// Followers who scroll away enter an independent state with a "back to host"
/// affordance rather than being yanked — automatic re-sync fighting the
/// reader's scroll is the failure mode every implementation of this hits.
model ReadingRoom {
  id        String   @id @default(cuid())
  docId     String
  hostId    String
  /// Host's anchor: { page, fraction, anchorId }.
  anchor    Json     @default("{}")
  /// Per-user positions, so "I'm ahead" is visible instead of a scroll fight.
  positions Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([docId, active])
  @@index([hostId])
  @@map("reading_room")
}

/// Lineage for derived works (F10).
///
/// Builds, themes, playlists and worlds are all forkable in principle and none
/// recorded a parent, so a derivative credited nothing and the original author
/// saw no benefit from being built on. One edge table serves every kind, and
/// gives `lib/commerce` a chain to route a revenue share up.
model RemixEdge {
  id        BigInt   @id @default(autoincrement())
  /// 'build' | 'theme' | 'playlist' | 'world' | 'level'
  kind      String   @db.VarChar(16)
  sourceId  String
  derivedId String
  authorId  String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// A work has exactly one parent — that is what makes the ancestry walk
  /// terminate and the revenue share computable.
  @@unique([kind, derivedId])
  @@index([kind, sourceId])
  @@map("remix_edge")
}

/// Seasonal aggregates for the app tier (F17).
///
/// The games have `UserSeasonProgress`; RMHType, RMHStudy and RMHTube have
/// all-time stats only, so a user who peaked eight months ago has nothing to
/// play for — the exact case seasons exist to solve. All-time boards stay:
/// replacing them would erase people's best results.
model AppSeasonStat {
  seasonId  String   @db.VarChar(40)
  appId     String   @db.VarChar(24)
  userId    String
  /// App-defined: WPM peak, cards reviewed, minutes watched.
  primary   Int      @default(0)
  secondary Int      @default(0)
  /// Materialised nightly, not computed per request.
  rank      Int?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([seasonId, appId, userId])
  @@index([seasonId, appId, primary(sort: Desc)])
  @@map("app_season_stat")
}

/// Cross-app quest chain progress (F19).
///
/// `UserQuest` tracks per-game objectives; nothing spanned the platform, so
/// nobody discovered the app tier from the arcade or the reverse — the biggest
/// internal cross-sell opportunity, unused. Chains are deliberately relaxed in
/// pace: a cross-app chain on a daily cadence becomes an obligation, and
/// obligation is what makes people leave.
model QuestChainProgress {
  userId    String
  chainId   String    @db.VarChar(40)
  /// Per-step counters keyed by step index.
  steps     Json      @default("{}")
  claimedAt DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chainId])
  @@map("quest_chain_progress")
}

/// Group gifting and pooled purchases (F20).
///
/// Contributions are ESCROWED, not spent. The refund path must be correct
/// before launch, not after: a pool that fails and quietly keeps the coins is
/// the fastest way to lose economy trust.
model Pool {
  id         String    @id @default(cuid())
  creatorId  String
  /// 'membership-gift' | 'tournament-prize' | 'creator-tip'
  purpose    String    @db.VarChar(24)
  /// The gift recipient / tournament / creator, depending on purpose.
  targetId   String?
  goalCoins  Int
  raised     Int       @default(0)
  expiresAt  DateTime
  settledAt  DateTime?
  /// Set when the pool expired short of its goal and contributions were
  /// returned. Distinguishes "refunded" from "still open" without a status enum
  /// that would need migrating every time a purpose is added.
  refundedAt DateTime?
  createdAt  DateTime  @default(now())

  creator       User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  contributions PoolContribution[]

  @@index([expiresAt, settledAt, refundedAt])
  @@index([creatorId])
  @@map("pool")
}

model PoolContribution {
  id         BigInt    @id @default(autoincrement())
  poolId     String
  userId     String
  coins      Int
  /// Set when this specific contribution was returned, so a partial refund
  /// sweep is resumable and can never pay the same person twice.
  refundedAt DateTime?
  createdAt  DateTime  @default(now())

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("pool_contribution")
}

/// Collaboratively edited community pages (F21).
///
/// Deliberately shaped like `GameGuide`/`GameGuideRevision` rather than as a
/// second revision system — which also means the anti-vandalism story is the
/// one already proven on guides.
model CommunityPage {
  id          String   @id @default(cuid())
  communityId String
  slug        String   @db.VarChar(60)
  title       String   @db.VarChar(120)
  body        String   @db.Text
  /// 'mods' | 'members' | 'trusted' (member 30d+ with no strikes)
  editPolicy  String   @default("mods") @db.VarChar(10)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  revisions CommunityPageRevision[]

  @@unique([communityId, slug])
  @@index([communityId, pinned])
  @@map("community_page")
}

model CommunityPageRevision {
  id        BigInt   @id @default(autoincrement())
  pageId    String
  editorId  String
  body      String   @db.Text
  summary   String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  page   CommunityPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor User          @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
  @@map("community_page_revision")
}

// ─── Group voice calls ─────────────────────────────────────────────────────
/// Where a group call came from — which is also the only thing that decides how
/// people get into it.
enum GroupCallOrigin {
  /// Started from a DM or a profile. Invitees are RUNG: they get an incoming
  /// call and accept or decline. The starter is the host.
  ADHOC
  /// An open voice room scoped to a community. Nobody is rung; eligible members
  /// walk in, and the roster is whoever has joined.
  COMMUNITY
  /// An open voice room scoped to a party. Same admission rule as COMMUNITY.
  PARTY
}

enum GroupCallStatus {
  /// Ad-hoc only: rung, and nobody but the host has joined yet.
  RINGING
  /// The room is live. Named ACTIVE rather than CONNECTED (the 1:1 `CallStatus`
  /// word) on purpose: in a mesh "connected" is N-1 separate facts, not one, so
  /// a room is not something that can be connected.
  ACTIVE
  /// Finished normally — the host ended it, or the last person left.
  ENDED
  /// Ad-hoc: rang out and nobody joined.
  MISSED
  /// Ad-hoc: everyone who was rung declined.
  DECLINED
  /// Signalling or ICE never completed for anyone — the honest outcome when
  /// TURN is unavailable and the peers are behind symmetric NAT.
  FAILED
}

/// A group voice call: one room, up to MAX_GROUP_CALL_PARTICIPANTS (8) people.
///
/// Media never touches our servers. This is a full WebRTC mesh — every
/// participant holds a direct connection to every other participant — so there
/// is no SFU and no media relay to run, which is also why the cap is eight and
/// not eighty (each client uploads N-1 copies of its own microphone; see
/// `lib/groupcall/events.ts`). What is persisted here is only the call *record*
/// — who was in it, when, and how it ended — so a DM thread can show "Missed
/// group call" and a community can show its voice history.
///
/// No audio is recorded, and there is nowhere for it to be recorded to.
///
/// Separate from `Call` rather than a nullable extension of it: the two have
/// different admission rules, different lifecycles (a 1:1 call cannot be joined
/// mid-flight), and a different cardinality of participant. Sharing the table
/// would mean every 1:1 query carrying a roster join it never needs.
model GroupCall {
  /// Time-sortable rather than `cuid()`, per the new-table policy (R0-T7): rows
  /// are only ever appended, and the id is public only to the handful of people
  /// in the room, so the creation time it encodes leaks nothing that `createdAt`
  /// on the same row does not.
  id     String          @id @default(uuid(7))
  hostId String
  origin GroupCallOrigin

  /// Set when `origin` is COMMUNITY. A real relation — communities are rows.
  communityId    String?
  /// Set when `origin` is PARTY. Deliberately NOT a relation: parties are
  /// ephemeral and have no schema at all (in-memory Maps in
  /// `server/socket-server/handlers/party.ts` — a hub restart dissolves them),
  /// so there is no table to point a foreign key at. Indexed so the live room
  /// for a party is still one lookup, and left dangling once the party is gone,
  /// which is correct: the call record outlives the party it happened in.
  partyId        String? @db.VarChar(64)
  /// The DM thread this started from, when it did. Null for a call started from
  /// a profile or scoped to a community/party. Matches `Call.conversationId` —
  /// a plain indexed column rather than a relation, for the same reason.
  conversationId String?

  status GroupCallStatus @default(RINGING)

  createdAt        DateTime  @default(now())
  /// When the room actually opened (the host's own join). Null only for a room
  /// that was refused before it ever ran.
  startedAt        DateTime?
  endedAt          DateTime?
  /// The most people in the room at once. Denormalised on each join so the
  /// history row can say "5 people" without replaying the participant rows, and
  /// so the mesh cap can be audited after the fact.
  peakParticipants Int       @default(0)

  host         User                   @relation("GroupCallHost", fields: [hostId], references: [id], onDelete: Cascade)
  community    Community?             @relation(fields: [communityId], references: [id], onDelete: SetNull)
  participants GroupCallParticipant[]

  @@index([hostId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  /// "Is there a live room for this community/party?" — the LOOKUP query.
  @@index([communityId, status])
  @@index([partyId, status])
  /// Backs the janitor sweep that closes rooms orphaned by a hub restart
  /// (WHERE status IN (RINGING, ACTIVE)).
  @@index([status, createdAt(sort: Desc)])
  @@map("group_call")
}

enum GroupCallParticipantStatus {
  /// Ad-hoc: rung, still deciding. Never used for an open room.
  INVITED
  /// In the room right now.
  JOINED
  /// Was in the room and left.
  LEFT
  /// Ad-hoc: actively refused the ring.
  DECLINED
  /// Ad-hoc: the ring timed out without an answer.
  MISSED
  /// Joined, but their media never came up — the per-person record of the
  /// symmetric-NAT case, and the only way to see that one participant could
  /// never be heard.
  FAILED
}

/// One person's membership of one group call.
///
/// Append-only and higher-volume than `GroupCall` — up to eight rows per call,
/// written once and then updated in place — so per the R0-T7 new-table policy it
/// takes a `BigInt` identity rather than a `cuid()`: insert locality without a
/// second index, and the same shape as the other high-volume child tables here
/// (`PoolContribution`, `CommunityPageRevision`). The id is never exposed to a
/// client; every read addresses a row by `(callId, userId)` or scans by user, so
/// nothing needs an opaque public handle and `BigInt`'s awkward JSON
/// serialisation never reaches the wire.
model GroupCallParticipant {
  id     BigInt @id @default(autoincrement())
  callId String
  userId String

  status GroupCallParticipantStatus @default(INVITED)

  /// When they were rung (ad-hoc) or when the row was created on join (open
  /// room). Always set, so a user's call history has one column to sort on.
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  leftAt      DateTime?
  /// Denormalised time in the room, in seconds. 0 unless they joined.
  durationSec Int       @default(0)

  call GroupCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per person per call. Also serves as the `callId` prefix index that
  /// loads a roster, so no separate `@@index([callId])` is needed.
  @@unique([callId, userId])
  @@index([userId, invitedAt(sort: Desc)])
  @@map("group_call_participant")
}
