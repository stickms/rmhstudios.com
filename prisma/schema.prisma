  highScoreNormal  Int      @default(0)
  highScoreHard    Int      @default(0)
  highScoreLunatic Int      @default(0)
  bestStage        Int      @default(1)
  character        String   @default("rei")
  gamesPlayed      Int      @default(1)
  totalGraze       Int      @default(0)
  spellsCaptured   Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScoreNormal(sort: Desc)], map: "idx_dream_rift_high_score")
  @@index([bestStage(sort: Desc)], map: "idx_dream_rift_best_stage")
}

// A single completed multiplayer (co-op) Dream Rift run. Powers the co-op
// leaderboards: highest combined squad score and longest time survived.
model DreamRiftCoopRun {
  id            String   @id @default(uuid())
  difficulty    String   @default("normal")
  combinedScore Int      @default(0)
  timeSurvived  Int      @default(0) // seconds the squad stayed alive
  stageReached  Int      @default(1)
  cleared       Boolean  @default(false)
  playerCount   Int      @default(2)
  // [{ name, charId, score }] for each squad member (host-submitted snapshot).
  players       Json
  hostUserId    String?
  hostUser      User?    @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([difficulty, combinedScore(sort: Desc)], map: "idx_dream_rift_coop_score")
  @@index([difficulty, timeSurvived(sort: Desc)], map: "idx_dream_rift_coop_time")
}

// ─── Gabriel's Horn ───────────────────────────────────────────────

// One row per account that has finished a game of Gabriel's Horn. Written
// fire-and-forget by the socket hub when hands are counted.
//
// Ranked on `wins` rather than `bestHand`: a two-card finish at a three-player
// table is not the same achievement as one at a six-player table, and a board
// that sorted on it would reward finding the smallest table. `bestHand` is a
// keepsake, and is null until a first game finishes (0 is a legitimate hand —
// an empty one — so it cannot double as "unset").
model GabrielsHornPlayer {
  id           String   @id @default(uuid())
  username     String   @unique
  gamesPlayed  Int      @default(0)
  wins         Int      @default(0)
  bestHand     Int?
  // Times this player sounded the horn, and times that call actually held.
  hornsSounded Int      @default(0)
  hornsWon     Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wins(sort: Desc)], map: "idx_gabriels_horn_wins")
}

// RMH Farming Simulator — one persistent farm per user. The full live world
// (tiles, money, day/season/weather, inventory, seeds, tool levels, members,
// shipped value) is stored as a JSON blob; `code` is the shareable join code
// other players use to request access.
model FarmingSimFarm {
  id           String   @id @default(cuid())
  ownerId      String   @unique
  code         String   @unique
  name         String
  saveData     Json
  shippedValue Int      @default(0) // surfaced column for future leaderboards
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("farming_sim_farm")
}

// ─── Massive March ────────────────────────────────────────────────

// One island, one group's history on it. The campaign save is host-owned by
// design (§6.1): the host's row IS the world, which is why the host has to be
// present for a session to continue and why nobody else can start one.
//
// The whole world state — puzzle runtimes, tower deposits, keys, unlocks and
// the day/night clock — is one JSON blob, the same shape `lib/massive-march/
// campaign.ts#toSave` writes and `fromSave` reads (and `fromSave` is written to
// survive a blob an older build produced, because a save that stops parsing is
// somebody's eleven hours). `deposited`, `solved` and `finished` are surfaced as
// real columns purely so the campaign picker can list saves without
// deserialising every one of them.
model MassiveMarchCampaign {
  id        String   @id @default(cuid())
  ownerId   String
  // Short shareable code, the only way in — there is no matchmaking (§4).
  code      String   @unique
  name      String
  // "duo" | "trio" | "band" — the crew size the puzzle layouts are lit for.
  variant   String   @default("duo")
  saveData  Json
  deposited Int      @default(0)
  solved    Int      @default(0)
  finished  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner   User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members MassiveMarchMember[]

  @@index([ownerId, updatedAt(sort: Desc)], map: "idx_massive_march_owner")
  @@map("massive_march_campaign")
}

// Everyone who has ever walked a given campaign. Exists so a player who is not
// the host can still find their way back to it — they cannot start it, but they
// should not have to keep the join code in a text file either.
model MassiveMarchMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now()) @updatedAt

  campaign MassiveMarchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, lastSeenAt(sort: Desc)], map: "idx_massive_march_member_user")
  @@map("massive_march_member")
}

// Tracks which Discord channel was last used for an activity per guild.
// Used by the daily recap script to know where to post recaps.
model DiscordActivityChannel {
  id           String    @id @default(cuid())
  guildId      String
  channelId    String
  activity     String // e.g. "lights-out"
  updatedAt    DateTime  @default(now()) @updatedAt
  // Scheduled recap: set when the first player starts the daily puzzle
  recapDateKey String? // YYYY-MM-DD of the puzzle day to recap
  recapDueAt   DateTime? // when to send the recap (24h after first activity)

  @@unique([guildId, activity])
  @@index([recapDueAt], map: "idx_discord_activity_recap_due")
  @@map("discord_activity_channel")
}

// Tracks per-user, per-guild daily puzzle participation.
// A user completing in one guild propagates to all guilds they opened the activity in.
model DiscordDailyParticipant {
  id          String   @id @default(cuid())
  discordId   String // Discord user ID
  guildId     String
  dateKey     String // YYYY-MM-DD
  username    String
  status      String   @default("playing") // "playing" | "completed"
  moves       Int?
  ratingEmoji String?
  ratingLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([discordId, guildId, dateKey])
  @@index([guildId, dateKey], map: "idx_discord_daily_participant_guild_date")
  @@index([discordId, dateKey], map: "idx_discord_daily_participant_user_date")
  @@map("discord_daily_participant")
}

// Tracks per-user daily puzzle progress across guilds/devices (prevents move resets)
model DiscordDailyProgress {
  id          String   @id @default(cuid())
  discordId   String
  dateKey     String // YYYY-MM-DD
  gridJson    String // JSON-encoded grid state
  moves       Int      @default(0)
  completed   Boolean  @default(false)
  ratingLabel String?
  ratingEmoji String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([discordId, dateKey])
  @@map("discord_daily_progress")
}

