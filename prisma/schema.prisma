// ─── User Profile (Social) ──────────────────────────────────────

model UserProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?   @db.VarChar(50)
  customImage           String?
  customImageSizeBytes  Int?
  bio                   String?   @db.VarChar(160)
  location              String?   @db.VarChar(100)
  website               String?   @db.VarChar(200)
  // Link-in-bio: an ordered list of { label, url } (max 5), stored as JSON.
  links                 Json?
  // Profile banner/cover image (WebP in object storage). Size tracked for quota.
  bannerUrl             String?   @db.VarChar(300)
  bannerSizeBytes       Int?
  showLikes             Boolean   @default(false)
  dmPrivacy             DmPrivacy @default(EVERYONE)
  // Rich presence & Friends rail (§9). Who may see this user in the rail /
  // activity line: 'mutuals' (default, Discord-like), 'followers', or 'nobody'.
  // presenceDetail=false → online/offline only, activity hidden. Presence
  // activity itself is ephemeral (expires with the heartbeat) — no column.
  presenceVisibility    String    @default("mutuals") @db.VarChar(12)
  presenceDetail        Boolean   @default(true)
  // Reader content control: feed posts whose text contains any of these words
  // are hidden from this user (case-insensitive substring match). Opt-in.
  mutedWords            String[]  @default([])
  profileSongSpotifyId  String?   @db.VarChar(50)
  profileSongTitle      String?   @db.VarChar(200)
  profileSongArtist     String?   @db.VarChar(200)
  profileSongPreviewUrl String?   @db.VarChar(500)
  profileSongAlbumArt   String?   @db.VarChar(500)

  // Custom status (parity/QOL spec §10): a short emoji + text presence line
  // shown on the profile, hover cards, DMs, and (later) the friends rail.
  // `statusExpires` is enforced at read time (past = no status); `statusAuto`
  // mirrors rich presence as a now-playing line when no manual status is set.
  statusEmoji   String?   @db.VarChar(16)
  statusText    String?   @db.VarChar(80)
  statusExpires DateTime?
  statusAuto    Boolean   @default(false)

  // History & resume (§5): when true, no new HistoryEntry rows are recorded.
  historyPaused Boolean @default(false)

  // Wishlists (§8): public-by-default so friends can see what you want (gifting).
  wishlistPublic Boolean @default(true)

  // RMH Coins
  coins          Int     @default(10)
  hasProfilePet  Boolean @default(false)
  showProfilePet Boolean @default(true)

  // Progression: lifetime platform XP (level is derived from this)
  xp Int @default(0)

  // Creator tip goal (monthly coins target shown on the profile)
  tipGoal      Int?
  tipGoalLabel String? @db.VarChar(80)

  // Per-creator memberships: monthly price in coins to become a member of this
  // creator (null/0 = memberships disabled). Paid from the supporter's coins.
  membershipPriceCoins Int?

  // First-run onboarding checklist: when the completion reward was claimed
  // (null = not claimed; also acts as the atomic double-claim guard)
  onboardingRewardedAt DateTime?

  // Onboarding v2 "First Week" arc: when the graduation reward was claimed
  // (null = not graduated; atomic double-claim guard, like onboardingRewardedAt)
  firstWeekRewardedAt DateTime?

  // Gifting v2: whether this user accepts peer coin gifts (opt-out). When false,
  // /api/coins/gift rejects gifts to them.
  receiveGifts Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Leaderboard scans (global by xp / by coins) — without these the leaderboard
  // is a full-table sort of user_profile on every load.
  @@index([xp(sort: Desc)])
  @@index([coins(sort: Desc)])
  @@map("user_profile")
}

// ─── Prediction markets ────────────────────────────────────────────

enum PredictionStatus {
  PENDING // submitted by a user, awaiting admin approval
  OPEN // approved, trading is live
  RESOLVED_YES
  RESOLVED_NO
  DENIED // rejected by an admin
}

/// A binary (YES/NO) prediction market priced by an LMSR market maker. The live
/// YES price is the implied probability and moves as users trade. Shares pay 1
/// coin each on the winning side at resolution. `creatorId` is null for markets
/// seeded by the DeepSeek worker.
model Prediction {
  id            String           @id @default(cuid())
  title         String           @db.VarChar(160)
  description   String?          @db.VarChar(1000)
  creatorId     String?
  status        PredictionStatus @default(PENDING)
  isAiGenerated Boolean          @default(false)

  // LMSR state (floats). Shares pay 1 coin each on the winning side.
  b      Float @default(120) // liquidity parameter
  qYes   Float @default(0) // YES shares outstanding
  qNo    Float @default(0) // NO shares outstanding
  volume Int   @default(0) // total coins traded (display only)

  closesAt   DateTime? // trading deadline
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ─── Self-referential (auto) markets ────────────────────────────────
  // When `resolverKey` is set the market resolves itself from the platform's
  // own ground truth (a leaderboard, a build's like count, a tournament
  // result …) via a resolver in `lib/predictions/resolvers/`. No admin or AI
  // judge is involved. `resolverParams` carries the resolver's inputs, and
  // `subjectUrl` deep-links the card to whatever the market is about.
  resolverKey    String?   @db.VarChar(120) // e.g. "build.likes" — null for ordinary markets
  resolverParams Json? // resolver inputs, e.g. { buildId, threshold }
  subjectUrl     String?   @db.VarChar(200) // in-app deep link to the subject
  autoResolveAt  DateTime? // when the resolver becomes eligible to settle this market

  creator   User?                @relation("PredictionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  positions PredictionPosition[]

  @@index([status, createdAt(sort: Desc)])
  @@index([resolverKey, status]) // resolver settlement sweeps
  // Per-author pending-submission cap, counted on every market creation.
  @@index([creatorId, status])
  @@map("prediction")
}

/// A user's aggregate holdings in a single market. Updated per trade; settled at
/// resolution (winning shares credited back as coins).
model PredictionPosition {
  id           String  @id @default(cuid())
  predictionId String
  userId       String
  yesShares    Float   @default(0)
  noShares     Float   @default(0)
  spent        Int     @default(0) // net coins spent (cost basis)
  settled      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User       @relation("PredictionPositions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId])
  @@index([userId])
  @@map("prediction_position")
}

// ─── News ─────────────────────────────────────────────────────────

enum NewsStatus {
  STAGING
  PUBLISHED
}

model NewsArticle {
  id               String     @id @default(cuid())
