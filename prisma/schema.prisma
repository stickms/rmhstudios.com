// ─── User Strikes ─────────────────────────────────────────────────────────
// A strike is the moderation penalty; the appeal columns below are the user's
// side of it. Before they existed a strike was admin-write-only — the punished
// user got a SYSTEM notification and had no way to see the record or contest
// it. `/settings/account-status` reads these; `/admin/appeals` writes them.
model UserStrike {
  id        String    @id @default(cuid())
  userId    String
  adminId   String
  reason    String    @db.VarChar(500)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // What the strike attached to, so the user's status page can link to the
  // content instead of just naming it. Same (entityType, entityId) vocabulary
  // ContentReport uses ('rmhark' | 'comment' | 'build' | 'user' | …).
  entityType String? @db.VarChar(32)
  entityId   String? @db.VarChar(64)

  // Set when the user opens their status page and sees this strike, so
  // moderators can tell "notified" from "acknowledged".
  acknowledgedAt DateTime?

  // ── Appeal (one per strike; NONE until the user files) ──
  appealStatus  AppealStatus @default(NONE)
  appealText    String?      @db.VarChar(2000)
  appealedAt    DateTime?
  appealNote    String?      @db.VarChar(1000) // moderator's decision note, shown to the user
  appealAdminId String? // reviewer who decided; null while PENDING
  decidedAt     DateTime?

  user        User  @relation("StrikeUser", fields: [userId], references: [id], onDelete: Cascade)
  admin       User  @relation("StrikeAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  appealAdmin User? @relation("StrikeAppealAdmin", fields: [appealAdminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  // Drives the admin appeal queue: open appeals oldest-first.
  @@index([appealStatus, appealedAt])
  @@map("user_strike")
}

/// Lifecycle of a strike appeal. NONE = never filed (the default for every
/// strike). OVERTURNED voids the strike — it stops counting toward the
/// three-strike auto-ban and is struck through on the user's status page.
enum AppealStatus {
  NONE
  PENDING
  UPHELD
  OVERTURNED
}

enum RMHarkAudience {
  PUBLIC // anyone
  FOLLOWERS // the author's followers only
  PRIVATE // only the author
  SUPPORTERS // active members of the author (any creator tier)
  CIRCLE // the author's close-friends circle (§11)
}

enum RMHarkReplyControl {
  EVERYONE // anyone can reply (default)
  FOLLOWING // only accounts the author follows
  MENTIONED // only accounts @mentioned in the post (plus the author)
}

// ─── Paid post unlocks ────────────────────────────────────────────────────
model PostUnlock {
