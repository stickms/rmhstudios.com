generator client {
  provider        = "prisma-client-js"
  // Skip engine binary — the pg adapter uses the JS-based query engine
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// User Model (Better Auth)
model User {
  id               String    @id @default(cuid())
  name             String?
  username         String?   @unique // Added for username login
  handle           String?   @unique // Unique user handle for @mentions and URLs
  handleChangedAt  DateTime? // Last time the handle was changed (2-week cooldown)
  email            String?   @unique
  emailVerified    Boolean?
  password         String? // Added for password login
  image            String?
  stripeCustomerId String? // Stripe customer id (set by @better-auth/stripe on signup)
  isAdmin          Boolean   @default(false)
  isVerified       Boolean   @default(false)
  // Moderation: temporary/permanent ban (null = not banned)
  bannedUntil      DateTime?
  banReason        String?   @db.VarChar(500)
  // Presence: last heartbeat from an active client (for "online now")
  lastSeenAt       DateTime?
  // Referral program: this user's shareable invite code (lazily generated)
  referralCode     String?   @unique
  // ─── RMHark AI bot users (generated + driven by the bot-worker) ──
  isBot            Boolean   @default(false) // synthetic account created by the bot-worker
  botPersona       String?   @db.Text // private prompt seed describing the bot's posting "theme"
  botLastPostAt    DateTime? // last time the worker posted as this bot (pacing)
  // Denormalized follower count, kept in sync on follow/unfollow so hot paths
  // (recommendations, profile cards) can sort/read without a relation aggregate.
  followerCount    Int       @default(0)
  // Denormalized following/post counts, maintained on follow-unfollow and
  // post create/delete so the (hot) profile page never runs COUNT(*) aggregates.
  // Reconciled by scripts/reconcile-social-counts.ts.
  followingCount   Int       @default(0)
  postCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  // Game Relations (Progression linked to User)
  altairProfile        AltairPlayer?
  altairMetaProgress   AltairMetaProgress?
  altairCoopProfile    AltairCoopProfile?
  altairMatchPlayers   AltairMatchPlayer[]
  laundryProfile       LaundryPlayer?
  sliceItProfile       Player?
  vegaProfile          VegaPlayer?
  signalForgeProfile   SignalForgePlayer?
  templeOfJoyProfile   TempleOfJoySave?
  gameSaves            GameSave[]
  neonDriftwayProfile  NeonDriftwayPlayer?
  nightrailProfile     NightrailPlayer?
  synapseStormProfile  SynapseStormPlayer?
  rmhboxProfile        RMHboxProfile?
  rmhtypeProfiles      RmhTypeProfile[]
  libraryUploads       LibraryDocument[]     @relation("LibraryUploader")
  libraryCollections   LibraryCollection[]   @relation("LibraryCollectionOwner")
  /// Per-user library upload quota override (null → the default cap). Raised by
  /// an admin when approving a quota appeal.
  libraryUploadQuota   Int?
  libraryQuotaRequests LibraryQuotaRequest[] @relation("LibraryQuotaRequests")
  rmhstudyProfile      RmhStudyProfile?
  voidBreakerProfile   VoidBreakerPlayer?
  dailyPuzzleScores    DailyPuzzleScore[]
  versecraftSave       VersecraftSave?
  versecraftProgress   VersecraftProgress?
  forestExplorerSave   ForestExplorerSave?
  dreamRiftProfile     DreamRiftPlayer?
  dreamRiftCoopRuns    DreamRiftCoopRun[]
  farmingSimFarm       FarmingSimFarm?
  gabrielsHornProfile  GabrielsHornPlayer?

  // Massive March: campaigns this account owns, and the ones it has walked.
  massiveMarchCampaigns   MassiveMarchCampaign[]
  massiveMarchMemberships MassiveMarchMember[]

  // Slice-It Library Relations
  uploadedSongs Song[]            @relation("SongUploader")
  songLikes     SongLike[]
  songRatings   SongRating[]
  songComments  SongComment[]
  songScores    SongLeaderboard[]
  songPlays     SongPlay[]

  // RmhTube Relations
  rmhtubeHostedRooms RmhTubeRoom[]       @relation("RmhTubeHostedRooms")
  rmhtubeRoomMembers RmhTubeRoomMember[]
  rmhtubeQueueItems  RmhTubeQueueItem[]
  rmhtubePlaylists   RmhTubePlaylist[]
  rmhtubeStats       RmhTubeUserStats?

  // ─── RMHMusic ──────────────────────────────────────────────────
  rmhMusicHostedRooms  RmhMusicRoom[]        @relation("RmhMusicHostedRooms")
  rmhMusicRoomMembers  RmhMusicRoomMember[]  @relation("RmhMusicRoomMembers")
  rmhMusicQueueItems   RmhMusicQueueItem[]   @relation("RmhMusicQueueItems")
  rmhMusicChatMessages RmhMusicChatMessage[] @relation("RmhMusicChatMessages")

  // Site Feedback
  feedbacks Feedback[]

  // RMHark (Feed) Relations
  rmharks                RMHark[]
  rmharkLikes            RMHarkLike[]
  rmharkComments         RMHarkComment[]
  rmharkReposts          RMHarkRepost[]
  rmharkViews            RMHarkView[]
  rmharkCommentLikes     RMHarkCommentLike[]
  rmharkCommentReposts   RMHarkCommentRepost[]
  rmharkCommentViews     RMHarkCommentView[]
  rmharkPollVotes        RMHarkPollVote[]
  announcementPollVotes  FeedAnnouncementPollVote[]
  rmharkReactions        RMHarkReaction[]
  rmharkCommentReactions RMHarkCommentReaction[]

  // Profile & Social
  profile   UserProfile?
  followers Follow[]     @relation("UserFollowing")
  following Follow[]     @relation("UserFollowers")

  // Per-creator memberships: who supports this creator, and who this user supports.
  creatorMemberships CreatorMembership[] @relation("CreatorMemberships")
  supportedCreators  CreatorMembership[] @relation("SupportedCreators")

  // Notifications
  notifications     Notification[] @relation("UserNotifications")
  notificationsSent Notification[] @relation("UserNotificationActor")

  // Engagement: bookmarks, achievements, daily streak
  bookmarks    RMHarkBookmark[]
  achievements UserAchievement[]
  dailyStreak  DailyStreak?
  postUnlocks  PostUnlock[]

  // Communities created + memberships
  communitiesCreated     Community[]             @relation("CommunityCreator")
  communityMembers       CommunityMember[]
  communityAnnouncements CommunityAnnouncement[] @relation("CommunityAnnouncementAuthor")

  // Progression: quests + battle-pass season progress
  quests         UserQuest[]
  seasonProgress UserSeasonProgress[]

  // Composer: saved drafts + scheduled posts
  scheduledPosts ScheduledPost[]

  // Daily coin wheel spins
  wheelSpins DailyWheelSpin[]

  // Coin staking (interest-bearing vault)
  coinStake CoinStake?

  // Creator storefront
  storefrontProducts  StorefrontProduct[]  @relation("StorefrontCreator")
  storefrontPurchases StorefrontPurchase[] @relation("StorefrontBuyer")

  // AI persona chatbots
  aiPersonas        AiPersona[]        @relation("PersonaOwner")
  aiPersonaMessages AiPersonaMessage[]

  // Build marketplace unlocks
  buildUnlocks BuildUnlock[]

  // Ranked play: ELO ratings + challenges
  eloRatings         EloRating[]
  challengesIssued   RankedChallenge[] @relation("ChallengeChallenger")
  challengesReceived RankedChallenge[] @relation("ChallengeOpponent")

  // Gifted (coin-funded) memberships
  giftMembershipsReceived GiftMembership[] @relation("GiftRecipient")
  giftMembershipsSent     GiftMembership[] @relation("GiftGifter")

  // Group DMs
  groupChatsOwned       GroupChat[]            @relation("GroupOwner")
  groupMemberships      GroupChatMember[]
  groupMessages         GroupMessage[]
  groupPollVotes        GroupPollVote[]
  groupMessageReactions GroupMessageReaction[]

  // RMHStudy flashcards
  flashcardDecks   FlashcardDeck[]
  flashcardReviews FlashcardReview[]

  // Saved media playlists (music/video)
  playlists Playlist[]

  // RMHTube channel subscriptions
  rmhtubeSubscriptions RmhTubeSubscription[] @relation("TubeSubscriber")
  rmhtubeSubscribers   RmhTubeSubscription[] @relation("TubeChannel")

  // RMHMusic "guess the song" game
  musicPuzzles       MusicGuessPuzzle[]
  musicGuessAttempts MusicGuessAttempt[]

  // Developer API keys + one-time promo claims
  developerApiKeys DeveloperApiKey[]
  webhookEndpoints WebhookEndpoint[] @relation("UserWebhookEndpoints")
  promoClaims      PromoClaim[]

  // Economy: shop inventory, coin ledger (tips/gifts)
  inventory     UserInventory[]
  coinsSent     CoinTransaction[] @relation("CoinSender")
  coinsReceived CoinTransaction[] @relation("CoinRecipient")

  // Prediction markets: created markets + open positions
  predictionsCreated  Prediction[]         @relation("PredictionCreator")
  predictionPositions PredictionPosition[] @relation("PredictionPositions")

  // Wager matches: coin-staked 1v1 challenges on skill games
  wagerMatchesChallenged WagerMatch[] @relation("WagerChallenger")
  wagerMatchesOpposed    WagerMatch[] @relation("WagerOpponent")
  wagerMatchesWon        WagerMatch[] @relation("WagerWinner")

  // Tournaments: created events + entries
  tournamentsCreated Tournament[]        @relation("TournamentCreator")
  tournamentEntries  TournamentEntrant[]

  // Creator coin -> value bridge: redemption requests authored / reviewed
  redemptionRequests  RedemptionRequest[] @relation("RedemptionCreator")
  redemptionsReviewed RedemptionRequest[] @relation("RedemptionReviewer")

  // Admin-authored feed announcements
  feedAnnouncements FeedAnnouncement[]

  // Admin moderation: audit log entries authored, strikes received/issued
  auditLogs      AdminAuditLog[] @relation("AuditAdmin")
  strikes        UserStrike[]    @relation("StrikeUser")
  strikesIssued  UserStrike[]    @relation("StrikeAdmin")
  appealsDecided UserStrike[]    @relation("StrikeAppealAdmin")

  // Moderation (reports filed / received, blocks & mutes)
  reportsFiled    ContentReport[] @relation("ReportReporter")
  reportsResolved ContentReport[] @relation("ReportResolver")
  blocksMade      UserBlock[]     @relation("BlockBlocker")
  blocksReceived  UserBlock[]     @relation("BlockBlocked")
  mutesMade       UserMute[]      @relation("MuteMuter")
  mutesReceived   UserMute[]      @relation("MuteMuted")

  // Direct Messages
  conversationsAsOne     Conversation[]          @relation("ConversationParticipantOne")
  conversationsAsTwo     Conversation[]          @relation("ConversationParticipantTwo")
  directMessages         DirectMessage[]
  directMessageReactions DirectMessageReaction[]

  // rmhcode & User Builds
  rmhCodeTokens RmhCodeToken[]
  userBuilds    UserBuild[]
  buildLikes    BuildLike[]
  buildComments BuildComment[]
  buildViews    BuildView[]

  // ─── Doctrine Engine (RMH Strategies) ─────────────────────────
  doctrineTier                String                       @default("PUBLIC") // PUBLIC | INSIDER | OPERATOR
  doctrineTierChangedAt       DateTime?
  doctrineTimezone            String                       @default("America/New_York")
  doctrineRecruitedById       String?
  doctrineRecruitedBy         User?                        @relation("DoctrineRecruitment", fields: [doctrineRecruitedById], references: [id])
  doctrineRecruits            User[]                       @relation("DoctrineRecruitment")
  doctrineReputation          DoctrineReputation?
  doctrinePuzzleSubmissions   DoctrinePuzzleSubmission[]
  doctrinePuzzleReplays       DoctrinePuzzleReplay[]
  doctrineSafehouseAccessLogs DoctrineAccessLog[]
  doctrineIncidentReports     DoctrineIncidentReport[]
  doctrineReactions           DoctrineReaction[]
  doctrineRecruitmentCodes    DoctrineRecruitmentCode[]
  doctrineSahurParticipations DoctrineSahurParticipation[]

  // RMH Ladder Relations
  ladderPrefs             LadderUserPrefs?
  ladderKeywords          LadderKeyword[]
  ladderWatchlist         LadderWatchlistEntry[]
  ladderJobActions        LadderJobAction[]
  ladderApplications      LadderApplication[]
  ladderAlerts            LadderAlert[]
  ladderResumes           LadderResume[]
  ladderResumeVersions    LadderResumeVersion[]
  ladderResumeReviews     LadderResumeReview[]
  ladderJobMatches        LadderJobMatch[]
  ladderAiTasks           LadderAiTask[]
  ladderSavedSearches     LadderSavedSearch[]
  ladderApplicationEvents LadderApplicationEvent[]
  ladderAlertEvents       LadderAlertEvent[]
  ladderProductEvents     LadderProductEvent[]

  // ─── RMH Rideshare ────────────────────────────────────────────
  rideshareDriver       RideshareDriver?
  rideshareApplications RideshareDriver[] @relation("RideshareApplicationReviewer")
  ridesRequested        Ride[]            @relation("RideRider")
  ridesDriven           Ride[]            @relation("RideDriver")
  rideMessages          RideMessage[]
  rideSavedPlaces       RideSavedPlace[]

  // ─── RMHHomes (community housing marketplace) ─────────────────
  homeListings  HomeListing[]
  homeFavorites HomeFavorite[]
  homeWatches   HomeWatch[]

  media Media[]

  // WebAuthn passkeys (@better-auth/passkey)
  passkeys Passkey[]

  // Web Push subscriptions
  pushSubscriptions PushSubscription[]

  // Referral program
  referralsMade    Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("Referee")

  // Notification preferences (per-type opt-outs)
  notificationPreference NotificationPreference?

  // Appearance preferences (theme + accent), synced across devices
  appearancePreference AppearancePreference?

  // Layout preferences (sidebar pin/hide + home widget stack), synced (§15)
  layoutPreference LayoutPreference?

  // ─── Platform expansion (2026-07-19 design) ──────────────────────────────
  arcadeStreak         ArcadeStreak?
  creatorTiers         CreatorTier[]
  spacesHosted         Space[]          @relation("SpaceHost")
  spaceMessages        SpaceMessage[]
  eventsHosted         CommunityEvent[] @relation("EventHost")
  eventRsvps           EventRsvp[]
  gameReplays          GameReplay[]
  marketListingsSold   MarketListing[]  @relation("MarketSeller")
  marketListingsBought MarketListing[]  @relation("MarketBuyer")
  sharedMoments        SharedMoment[]

  // ─── Parity / QOL / customization (2026-07-20 design) ────────────────────
  saveFolders         SaveFolder[]
  savedItems          SavedItem[]
  historyEntries      HistoryEntry[]
  contentAwardsGiven  ContentAward[]
  wishlistEntries     WishlistEntry[]
  closeFriendsOwned   CloseFriend[]    @relation("CircleOwner")
  closeFriendOf       CloseFriend[]    @relation("CircleMember")
  userLists           UserList[]
  userListMemberships UserListMember[]
  feedSignals         FeedSignal[]
  gameReviews         GameReview[]
  gameReviewVotes     GameReviewVote[]
  gameGuides          GameGuide[]
  userThemes          UserTheme[]
  profileLayout       ProfileLayout?
  savedSearches       SavedSearch[]

  // ─── Emoji & sticker packs (2026-08-04) ──────────────────────────────────
  emojiPacks       EmojiPack[]
  bulkOperations   BulkOperation[]
  recoveryCodes    RecoveryCode[]
  trustedContacts  TrustedContact[]        @relation("TrustedContactOwner")
  trustedFor       TrustedContact[]        @relation("TrustedContactPerson")
  recoveryRequests RecoveryRequest[]
  messageHides     DirectMessageHide[]
  typingKeyStats   RmhTypeKeyStat[]
  profileLinks     ProfileLink[]
  handleChanges    HandleChange[]
  speedrunEntries  SpeedrunEntry[]
  ladderAnswers    LadderAnswerBank?
  emojiPackSubs    EmojiPackSubscription[]

  // ─── Voice calls ─────────────────────────────────────────────────────────
  callsPlaced   Call[] @relation("CallCaller")
  callsReceived Call[] @relation("CallCallee")

  // ─── Group voice calls ───────────────────────────────────────────────────
  groupCallsHosted GroupCall[]            @relation("GroupCallHost")
  groupCalls       GroupCallParticipant[]

  // ─── The Next 100 (2026-08-05) ───────────────────────────────────────────
  /// Set by POST /api/account/delete. The account is signed out and hidden
  /// immediately, but the anonymisation runs 30 days later — so a deletion at
  /// 2am in anger is recoverable by simply signing back in (B12).
  deletionScheduledAt DateTime?

  aiUsage             AiUsage[]
  activities          Activity[]
  gameStats           GameStat[]
  readPositions       ReadPosition[]
  heldNotifications   HeldNotification[]
  conversationPrefs   ConversationPref[]
  idempotencyKeys     SiteIdempotencyKey[]
  featureRequests     FeatureRequest[]
  featureRequestVotes FeatureRequestVote[]

  creatorPosts           CreatorPost[]
  referralMilestones     ReferralMilestone[]
  profileBlocks          ProfileBlock[]
  readingRooms           ReadingRoom[]
  remixEdges             RemixEdge[]
  appSeasonStats         AppSeasonStat[]
  questChainProgresses   QuestChainProgress[]
  pools                  Pool[]
  poolContributions      PoolContribution[]
  communityPageRevisions CommunityPageRevision[]

  @@index([isBot])
  @@index([followerCount])
  // Backs the nightly finalize-deletion sweep; partial in effect since the
  // column is null for every live account.
  @@index([deletionScheduledAt])
  // Backs the "online now" fallback count (WHERE lastSeenAt >= cutoff). The
  // fast path is a Redis presence set; this keeps the DB fallback sane.
  @@index([lastSeenAt])
  @@map("user")
}

// Per-type notification opt-outs. A missing row means "everything on"
// (the default) — rows are created on first save from the preferences panel.
// Moderation notices (SYSTEM/strike) are always delivered regardless.
model NotificationPreference {
  userId      String  @id
  likes       Boolean @default(true)
  comments    Boolean @default(true) // includes replies
  follows     Boolean @default(true)
  mentions    Boolean @default(true)
  reposts     Boolean @default(true)
  system      Boolean @default(true) // achievements, levels, coins, …
  // Weekly digest email (opt-in). Missing row / unset = off; users turn it on
  // in settings. Kept opt-in for deliverability + consent hygiene.
  emailDigest Boolean @default(false)

  // Notification center v2 (§16): per-category × per-channel matrix
  // ({ [category]: { inapp, push, email } }; missing = category default) plus
  // quiet hours. The booleans above stay until every notifier is migrated onto
  // lib/notify/dispatch.server.ts.
  matrix     Json    @default("{}")
  quietStart Int? // minutes from midnight, user tz
  quietEnd   Int?
  tz         String? @db.VarChar(40)

  /// Who may start a voice call with this user: 'everyone' | 'following'
  /// (people this user follows) | 'nobody'. Enforced server-side in the call
  /// signaling handler, never by the caller's client.
  callPrivacy String @default("following") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// Per-user appearance preferences, synced across devices (localStorage is the
// no-flash cache; this row is the source of truth once signed in). Every field is
// nullable and means "use the built-in default" when unset, so new preference
// knobs (density, font scale, …) can be added later as additional nullable
// columns without a data backfill. A missing row = all defaults.
model AppearancePreference {
  userId             String  @id
  style              String? // site theme id (see SITE_STYLES); null → DEFAULT_STYLE (Glass Dark)
  accent             String? // accent preset id (see ACCENT_PRESETS); null → theme's own accent
  reduceTransparency Boolean @default(false) // collapse the glass to opaque surfaces
  // Appearance & accessibility suite (§13). Null = built-in default.
  fontScale          Int? // 875 | 1000 | 1125 | 1250 (per-mille; avoids floats)
  density            String? @db.VarChar(8) // 'cozy' | 'compact'
  readableFont       Boolean @default(false)
  customAccent       String? @db.VarChar(7) // '#rrggbb'; wins over `accent` preset
  reduceMotion       Boolean @default(false)
  glassLevel         Int? // glass clarity slider (§5.46): 0 Opaque · 1 Calm · 2 Default · 3 Airy · 4 Clear; null → 2
  /// Colour-vision deficiency mode: 'deuteranopia' | 'protanopia' |
  /// 'tritanopia'; null/'none' → the untouched palette. Retints the semantic
  /// success/danger/warning tokens only.
  colorVision        String? @db.VarChar(16)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appearance_preference")
}

// Home dashboard & sidebar customization (§15) — "your daily surfaces, your
// order". Deliberately separate from AppearancePreference (looks vs where;
// different churn). `sidebar` holds { pinned: string[], hidden: string[] } of
// nav item ids; `homeStack` is an ordered list of widget config
// ({ kind, collapsed? }); [] / {} both mean "use the defaults". Unknown ids are
// dropped at read time by parseLayoutPref (forward-safe across removed apps).
model LayoutPreference {
  userId    String   @id
  sidebar   Json     @default("{}")
  homeStack Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("layout_preference")
}

// One row per successfully attributed invite. `rewardedAt` is set when the
// mutual coin reward fires (on the referee's first achievement unlock, so
// throwaway signups earn nothing).
model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String    @unique
  code       String    @db.VarChar(32)
  createdAt  DateTime  @default(now())
  rewardedAt DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Coarse device family ("Chrome on macOS") — NOT a tracking identifier.
  /// A sign-in whose (userId, deviceFp) pair has never been seen triggers the
  /// new-device alert (B11). Deliberately low-entropy: the goal is "is this
  /// familiar to the account owner", not "is this the same physical machine".
  deviceFp  String?   @db.VarChar(80)
  /// Hashed via lib/hash-ip.server — raw addresses are never stored here.
  ipHash    String?   @db.VarChar(64)
  /// Set once the owner has been told about this device, so an alert fires at
  /// most once per device rather than on every session refresh.
  alertedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceFp])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  expiresAt             DateTime? // Re-added for Better Auth compatibility
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Web Push subscriptions — one row per browser/device a user enabled push on.
// Endpoint is globally unique; rows are removed when the push service reports
// the subscription gone (404/410) or the user disables push on that device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

// WebAuthn credentials for password-less sign-in (@better-auth/passkey).
// Field names/types follow the plugin's expected schema exactly.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// --- Blog Models ---

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        String
  description String
  image       String?
  tags        String[]
  content     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date(sort: Desc)])
  @@map("blog_post")
}

// --- Game Models ---

model AltairPlayer {
  id                String   @id @default(uuid())
  username          String   @unique
  bestTime          Float    @default(0)
  totalKills        Int      @default(0)
  totalXP           Int      @default(0)
  totalGold         Int      @default(0)
  totalTimeSurvived Float    @default(0)
  gamesPlayed       Int      @default(1)
  updatedAt         DateTime @default(now()) @updatedAt

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bestTime(sort: Desc)], map: "idx_altair_best_time")
  @@index([totalKills(sort: Desc)], map: "idx_altair_kills")
  @@index([totalXP(sort: Desc)], map: "idx_altair_xp")
  @@index([totalGold(sort: Desc)], map: "idx_altair_gold")
  @@index([totalTimeSurvived(sort: Desc)], map: "idx_altair_survival")
}

model LaundryPlayer {
  id          String   @id @default(uuid())
  username    String   @unique
  // Solo best. Versus scores are tracked separately below: the two modes run
  // different clocks and different pressure, so one board for both would be
  // meaningless.
  highScore   Int      @default(0)
  gamesPlayed Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt

  // Versus (multiplayer race) record, written by the socket hub on match end.
  versusWins   Int @default(0)
  versusPlayed Int @default(0)
  versusBest   Int @default(0)
  // Career stats, shown on the results screen and the leaderboard detail rows.
  bestCombo    Int @default(0)
  totalSorted  Int @default(0)

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_laundry_high_score")
  @@index([versusWins(sort: Desc)], map: "idx_laundry_versus_wins")
}

// Daily Puzzle Score — generic leaderboard for all daily puzzles including lights-out
model DailyPuzzleScore {
  id          String   @id @default(cuid())
  userId      String
  gameMode    String // lights-out | alibi | spectrum | outcast | chainlink | impostor
  dateKey     String // YYYY-MM-DD
  score       Int      @default(0) // points (higher = better) for most games
  moves       Int? // lights-out: move count (lower = better)
  hintUsed    Boolean? @default(false) // lights-out: whether hints were used
  dnf         Boolean? @default(false) // lights-out: did not finish
  resultJson  Json? // game-specific result data
  timeSeconds Int? // time taken (for timed games)
  createdAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameMode, dateKey])
  @@index([gameMode, dateKey, score(sort: Desc)])
  @@index([gameMode, dateKey, moves(sort: Asc)])
  @@map("daily_puzzle_score")
}

// Daily Puzzle content cache — the generated puzzle for a given mode + day.
// The first request for a (gameMode, dateKey) generates the puzzle (via the
// DeepSeek AI pipeline, falling back to the built-in deterministic generator)
// and stores it here; every later request for that day reads this row, so the
// puzzle is identical for everyone worldwide. The unique constraint makes the
// first writer win under concurrent first-requests.
model DailyPuzzle {
  id        String   @id @default(cuid())
  gameMode  String // alibi | spectrum | outcast | chainlink | impostor
  dateKey   String // YYYY-MM-DD (America/New_York)
  source    String   @default("deepseek") // deepseek | fallback
  data      Json // full puzzle payload, including the solution fields
  createdAt DateTime @default(now())

  @@unique([gameMode, dateKey])
  @@map("daily_puzzle")
}

