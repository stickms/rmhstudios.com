// ─── Notifications ────────────────────────────────────────────────────────
// In-app notifications for social events (likes, comments, replies, follows,
// mentions, reposts). Recipient is `userId`; `actorId` is who triggered it.

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  FOLLOW
  MENTION
  REPOST
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String // recipient
  actorId    String? // who triggered it (null for system notifications)
  type       NotificationType
  entityType String?          @db.VarChar(32) // e.g. "rmhark", "comment", "user"
  entityId   String?          @db.VarChar(64)
  preview    String?          @db.VarChar(280) // short snapshot of the content
  link       String?          @db.VarChar(500) // where clicking should take the user
  read       Boolean          @default(false)
  // §16 batching: rows sharing a groupKey collapse in the list/badge ("12 people
  // liked your post"). Null = ungrouped (rendered individually, as today).
  groupKey   String?          @db.VarChar(80)
  createdAt  DateTime         @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("UserNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, groupKey])
  // Unread-dedupe lookup + the retraction deleteMany (createNotification /
  // removeNotification), which run on every like, comment, follow and unlike.
  // Without this they fell back to (userId, read, createdAt) and scanned every
  // unread row the recipient has.
  @@index([userId, read, type, entityId])
  @@map("notification")
}

// ─── Moderation ───────────────────────────────────────────────────────────
// User-facing reporting plus block/mute. Admins review reports via the queue.

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL
  SELF_HARM
  MISINFORMATION
  ILLEGAL
  OTHER
}

model ContentReport {
  id           String       @id @default(cuid())
  reporterId   String
  reason       ReportReason
  details      String?      @db.VarChar(1000)
  // What is being reported. entityType is "rmhark" | "comment" | "user" | "build" | "dm".
  entityType   String       @db.VarChar(32)
  entityId     String       @db.VarChar(64)
  // Convenience: the user who owns the reported content (for quick triage).
  targetUserId String?

  status        ReportStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  moderatorNote String?      @db.VarChar(1000)

  createdAt DateTime @default(now())

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([reporterId])
  @@map("content_report")
}

