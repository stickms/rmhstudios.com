  content          String     @db.Text
  category         String
  tags             String[]
  featured         Boolean    @default(false)
  sourceTitle      String
  sourceUrl        String
  sourcePublisher  String
  sourceDate       String?
  image            String?
  discordMessageId String?
  status           NewsStatus @default(PUBLISHED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, date(sort: Desc)])
  @@index([category])
  @@index([slug])
  @@map("news_article")
}

// ─── Follow Relation ─────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  // Keyset pagination of a user's followers / following ordered by recency
  // (celebrity accounts have millions of followers — single-column index +
  // sort is not enough).
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
  @@map("follow")
}

/// Normalized hashtag registry. Tags are extracted from post content at write
/// time (see lib/tags-extract.server.ts) into these tables so trending and tag
/// feeds are indexed lookups instead of ILIKE '%#tag%' scans of rmheet.content.
model Hashtag {
  id        String   @id @default(cuid())
  tag       String   @unique // normalized: lowercased, no leading '#'
  postCount Int      @default(0) // denormalized count of linked, non-deleted posts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts PostHashtag[]

  // Trending: order tags by popularity.
  @@index([postCount(sort: Desc)])
  @@map("hashtag")
}

/// Join row linking a post to a hashtag it contains.
model PostHashtag {
  id        String   @id @default(cuid())
  hashtagId String
  rmheetId  String
  createdAt DateTime @default(now())

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  rmhark  RMHark  @relation(fields: [rmheetId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, rmheetId])
  // Keyset scan of a tag's recent posts.
  @@index([hashtagId, createdAt(sort: Desc)])
  @@index([rmheetId])
  @@map("post_hashtag")
}

/// A coin-funded membership: `supporter` supports `creator` for a 30-day period.
/// Renewing extends `expiresAt`; membership is "active" while expiresAt > now.
model CreatorMembership {
  id          String   @id @default(cuid())
  creatorId   String
  supporterId String
  priceCoins  Int
  startedAt   DateTime @default(now())
  expiresAt   DateTime

  // Multi-tier memberships (Creator Studio). Null for legacy single-price rows;
  // backfilled to the creator's auto-created default tier by the studio UI.
  tierId String?

  creator   User         @relation("CreatorMemberships", fields: [creatorId], references: [id], onDelete: Cascade)
  supporter User         @relation("SupportedCreators", fields: [supporterId], references: [id], onDelete: Cascade)
  tier      CreatorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([creatorId, supporterId])
  @@index([creatorId])
  @@index([supporterId])
  @@index([expiresAt])
  @@index([tierId])
  @@map("creator_membership")
}

