// ─── RMHark (Feed) Models ─────────────────────────────────────────

model RMHark {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  gifUrl    String?  @db.Text
  imageUrls String[] @default([])
  // Per-image alt text (accessibility), aligned by index with imageUrls.
  // May be shorter than imageUrls; a missing/empty entry means "no description".
  imageAlts String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Denormalized engagement counters (Phase 1: eventual consistency) ──
  // Maintained transactionally by the like/comment/repost/view routes via
  // atomic increment/decrement, so the feed read path never needs `_count`
  // aggregation. Drift is reconciled by scripts/reconcile-feed-counts.ts.
  likeCount    Int @default(0)
  commentCount Int @default(0)
  repostCount  Int @default(0)
  viewCount    Int @default(0)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     RMHarkLike[]
  comments  RMHarkComment[]
  reposts   RMHarkRepost[]
  views     RMHarkView[]
  media     Media[]
  poll      RMHarkPoll?
  bookmarks RMHarkBookmark[]

  // Paid unlock: coins required to view content (null/0 = free)
  unlockPrice Int?
  unlocks     PostUnlock[]

  // Optional community this post belongs to
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  // Self-relation for reposts (quote-repost displays the original inline)
  originalId String?
  original   RMHark?  @relation("RMHarkReposts", fields: [originalId], references: [id], onDelete: SetNull)
  repostedBy RMHark[] @relation("RMHarkReposts")

  deletedAt      DateTime?
  /// 'author' | 'moderator' | 'system'. Only 'author' is restorable from the
  /// recycle bin — moderation must not be undone by the person moderated.
  deletedBy      String?   @db.VarChar(12)
  deletedByAdmin Boolean   @default(false)

  // Audience: who can see this post.
  audience RMHarkAudience @default(PUBLIC)

  // Content warning: media/text hidden behind a click-to-reveal overlay.
  isSensitive Boolean @default(false)

  // Who is allowed to reply to this post (anti-harassment control).
  replyControl RMHarkReplyControl @default(EVERYONE)

  // Author-pinned to the top of their profile (one per user, enforced in code).
  pinnedAt DateTime?

  // Edit history: editedAt set on first edit; prior versions stored separately.
  editedAt DateTime?
  edits    RMHarkEdit[]

  reactions RMHarkReaction[]

  // Normalized hashtags extracted at write time (replaces scanning content with
  // ILIKE '%#tag%'). Trending / tag feeds read these indexed rows instead.
  hashtags PostHashtag[]

  // Authored threads (chain-your-own-posts). Follow-up segments carry the root
  // post's id in `threadRootId` (null on the root and on standalone posts) so
  // the feed can show only the root; the root carries `threadReplyCount` (number
  // of follow-ups) to render a "show this thread" affordance.
  threadRootId         String?
  /// F1 — 'standard' | 'megathread' | 'ama'. Changes how the comment tree
  /// renders and sorts, not what a post IS, so it is a column rather than a
  /// separate model. Defaults keep every existing row a standard post.
  kind                 String               @default("standard") @db.VarChar(16)
  threadReplyCount     Int                  @default(0)
  postAnalyticsDailies PostAnalyticsDaily[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  // Composite index backing keyset pagination on (createdAt desc, id desc)
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Per-author keyset scan for the Following feed (userId IN (...) ORDER BY
  // createdAt desc, id desc). Also backs a partial index added in the migration
  // (rmheet_feed_scan_idx) for the For-You WHERE deleted/community/thread filters.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, pinnedAt])
  @@index([threadRootId])
  // Community feed keyset scan (communityId + ORDER BY createdAt desc, id desc).
  @@index([communityId, createdAt(sort: Desc), id(sort: Desc)])
  // Quote-repost lookups ("who quoted this post") and original hydration.
  @@index([originalId])
  @@map("rmheet")
}

model RMHarkReaction {
  id        String   @id @default(cuid())
  rmheetId  String
  userId    String
  emoji     String   @db.VarChar(32)
