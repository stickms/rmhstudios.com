// Deletions the sync APIs report (s09-10). One row per deleted highlight, deck, card, bookmark or shelf entry:
// ids, kind and time only, never content. Pruned after 90 days by the `sync.tombstones.prune` job.
model SyncTombstone {
  id        BigInt   @id @default(autoincrement())
  userId    String
  /// highlight | deck | card | bookmark | shelf_entry (lib/sync/tombstones.ts)
  kind      String   @db.VarChar(16)
  entityId  String   @db.VarChar(200)
  deletedAt DateTime @default(now())

  user User @relation("SyncTombstoneOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, deletedAt])
  @@index([deletedAt])
  @@map("sync_tombstone")
}
