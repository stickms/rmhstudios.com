// ─── RMH Music learning programme ─────────────────────────────────────────
/// One row per learner: the instrument and input they chose in setup, the
/// latency offset they calibrated, and their daily goal. Created on first save.
model MusicLearnProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// `INSTRUMENTS`: piano, guitar or voice.
  instrument String   @default("piano")
  input      String   @default("screen")
  latencyMs  Int      @default(0)
  dailyGoal  Int      @default(1)
  /// The sampled sound lessons play (`INSTRUMENT_IDS`); null follows `instrument`.
  sound      String?  @db.VarChar(16)
  /// A voice learner's range (`VOICE_RANGES`: soprano, alto, tenor, bass); null until chosen.
  voiceRange String?  @db.VarChar(16)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("music_learn_profile")
}

/// Best result per learner per lesson. `lessonId` is validated against the
/// static catalogue in `lib/rmhmusic/learn/content/path.ts`, not a FK.
model MusicLearnLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("music_learn_lesson_progress")
}

/// One remembered staff-reading card per learner: its spaced-repetition state
/// (`lib/rmhmusic/learn/srs/schedule.ts`). `cardId` (`treble:64`) is validated
/// against the decks in `lib/rmhmusic/learn/content/decks.ts`, not a FK. A row
/// is written only by a review (Practice), always with the server's clock.
model MusicLearnCard {
  id           String    @id @default(cuid())
  userId       String
  cardId       String    @db.VarChar(64)
  due          DateTime
  stability    Float     @default(0)
  difficulty   Float     @default(5)
  reps         Int       @default(0)
  lapses       Int       @default(0)
  lastReviewAt DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@map("music_learn_card")
}

/// Sight reading (Sprint) freeplay: the best per learner per level (`SPRINT_LEVELS`, validated in
/// code, not a FK). Score and average reaction are bests independently (`record.ts` `nextBest`).
model MusicSprintBest {
  id        String   @id @default(cuid())
  userId    String
  level     String   @db.VarChar(16)
  bestScore Int      @default(0)
  bestAvgMs Int?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
  @@map("music_sprint_best")
}

/// Sight reading daily challenge: one row per learner per UTC date (`YYYY-MM-DD`, the date the run
/// was dealt on). The row is written when the scored run STARTS (`createdAt`, score null) and
/// filled once when it finishes; a started row with no score is an abandoned run, so later runs
/// that date are practice. `results` holds the server-recomputed per-prompt results.
model MusicSprintDaily {
  id        String    @id @default(cuid())
  userId    String
  date      String    @db.VarChar(10)
  score     Int?
  avgMs     Int?
  played    Int?
  skipped   Int?
  results   Json?
  scoredAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("music_sprint_daily")
}

/// A learner's best score on a song of the songbook (`lib/rmhmusic/learn/songs/catalog.ts`, ids
/// validated in code, not a FK), per way of playing it (`mode`: `wait` or `play`). The server
/// re-scores every run from its per-note results (`songs/scoring.ts` `checkSongRun`) and keeps the
/// higher score.
model MusicSongBest {
  id        String   @id @default(cuid())
  userId    String
  songId    String   @db.VarChar(64)
  mode      String   @db.VarChar(8)
  bestScore Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, mode])
  @@map("music_song_best")
}
