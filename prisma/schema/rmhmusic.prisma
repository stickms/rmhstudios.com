// ─── RMH Music learning programme ─────────────────────────────────────────
/// One row per learner: the instrument and input they chose in setup, the
/// latency offset they calibrated, and their daily goal. Created on first save.
model MusicLearnProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// `INSTRUMENTS`: piano, guitar or voice.
  instrument String   @default("piano")
  input      String   @default("screen")
  latencyMs  Int      @default(0)
  dailyGoal  Int      @default(1)
  /// The sampled sound lessons play (`INSTRUMENT_IDS`); null follows `instrument`.
  sound      String?  @db.VarChar(16)
  /// A voice learner's range (`VOICE_RANGES`: soprano, alto, tenor, bass); null until chosen.
  voiceRange String?  @db.VarChar(16)
  /// `learning` keeps a missed question until it is answered right; `test` moves on (`practice-mode.ts`).
  practiceMode String @default("learning") @db.VarChar(8)
  /// Microphone input gain, a linear multiplier from 1 (as heard) to 16, for quiet microphones (`input/mic-gain.ts`).
  micGain    Float    @default(1)
  /// Automatic microphone sensitivity (`input/mic-auto.ts`): the gain and the cutoff follow the room and the notes.
  micAuto    Boolean  @default(true)
  /// The manual cutoff: sound quieter than this level (RMS) is ignored; used when `micAuto` is off (`input/mic-gain.ts`).
  micGate    Float    @default(0.01)
  /// Mains-hum filter: `off`, `50` or `60` (Hz).
  micHum     String   @default("off") @db.VarChar(3)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("music_learn_profile")
}

/// Best result per learner per lesson. `lessonId` is validated against the
/// static catalogue in `lib/rmhmusic/learn/content/path.ts`, not a FK.
model MusicLearnLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("music_learn_lesson_progress")
}

/// One remembered staff-reading card per learner: its spaced-repetition state
/// (`lib/rmhmusic/learn/srs/schedule.ts`). `cardId` (`treble:64`) is validated
/// against the decks in `lib/rmhmusic/learn/content/decks.ts`, not a FK. A row
/// is written only by a review (Practice), always with the server's clock.
model MusicLearnCard {
  id           String    @id @default(cuid())
  userId       String
  cardId       String    @db.VarChar(64)
  due          DateTime
  stability    Float     @default(0)
  difficulty   Float     @default(5)
  reps         Int       @default(0)
  lapses       Int       @default(0)
  lastReviewAt DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@map("music_learn_card")
}

/// Sight reading (Sprint) freeplay: the best per learner per level (`SPRINT_LEVELS`, validated in
/// code, not a FK). Score and average reaction are bests independently (`record.ts` `nextBest`).
model MusicSprintBest {
  id        String   @id @default(cuid())
  userId    String
  level     String   @db.VarChar(16)
  bestScore Int      @default(0)
  bestAvgMs Int?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
  @@map("music_sprint_best")
}

/// Sight reading daily challenge: one row per learner per UTC date (`YYYY-MM-DD`, the date the run
/// was dealt on). The row is written when the scored run STARTS (`createdAt`, score null) and
/// filled once when it finishes; a started row with no score is an abandoned run, so later runs
/// that date are practice. `results` holds the server-recomputed per-prompt results.
model MusicSprintDaily {
  id        String    @id @default(cuid())
  userId    String
  date      String    @db.VarChar(10)
  score     Int?
  avgMs     Int?
  played    Int?
  skipped   Int?
  results   Json?
  scoredAt  DateTime?
  createdAt DateTime  @default(now())
  /// Passed the Daily board's checks (`sprint/plausible.ts`) when it was scored; false for rows
  /// scored before Phase 6 and for runs that failed a check (kept for the learner's own streak).
  ranked         Boolean   @default(false)
  /// Why a scored run is not ranked: no-start | clock | too-fast | too-even. Null when ranked.
  unrankedReason String?   @db.VarChar(16)
  /// Set by a moderator ("Resolve & remove content" on a `music-score` report): off every board.
  hiddenAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, ranked, score(sort: Desc), avgMs])
  @@map("music_sprint_daily")
}

/// A learner's best score on a song of the songbook (`lib/rmhmusic/learn/songs/catalog.ts`, ids
/// validated in code, not a FK), per way of playing it (`mode`: `wait` or `play`). The server
/// re-scores every run from its per-note results (`songs/scoring.ts` `checkSongRun`) and keeps the
/// higher score.
model MusicSongBest {
  id        String   @id @default(cuid())
  userId    String
  songId    String   @db.VarChar(64)
  mode      String   @db.VarChar(8)
  bestScore Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, mode])
  @@map("music_song_best")
}

/// A learner's social consent (Phase 6, `lib/rmhmusic/learn/social/prefs.ts`). No row = both off:
/// nothing about the learner is visible to anyone until they turn a switch on. Read at query time,
/// so turning a switch off removes every past and present appearance at once; it never deletes a
/// result.
model MusicSocial {
  userId    String   @id
  /// Show my Daily challenge scores on the board (any signed-in learner).
  board     Boolean  @default(false)
  /// Share my progress (Daily streak, finished units, song bests) with mutual follows.
  friends   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("music_social")
}

/// A shared result (Phase 6, PR D): the capability link `/rmhmusic/r/<token>` and the snapshot its
/// page and card show. The server builds the snapshot from the stored row it points at (a scored
/// Daily run or a song best), never from client text. Works for 90 days unless stopped sooner;
/// a moderator's hide or a banned author makes it read as gone.
model MusicShare {
  id        String    @id @default(cuid())
  /// 128 random bits, base64url (22 characters). Never logged; reports and "Stop sharing" use `id`.
  token     String    @unique @db.VarChar(32)
  userId    String
  /// daily | song
  kind      String    @db.VarChar(8)
  /// What was shared, for reuse: `2026-11-15` or `ode-to-joy:play`.
  subject   String    @db.VarChar(80)
  /// The stored row the snapshot was taken from (`MusicSprintDaily.id` or `MusicSongBest.id`).
  rowId     String    @db.VarChar(32)
  /// The server-built snapshot (`social/share.ts` `SharePayload`, versioned `v: 1`).
  payload   Json
  /// Show the learner's name and picture (resolved live, never frozen). Off unless chosen per link.
  showName  Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set by the learner ("Stop sharing").
  stoppedAt DateTime?
  /// Set by a moderator ("Resolve & remove content" on a `music-share` report).
  hiddenAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("music_share")
}

/// One finished practice activity (Sprint 03 practice log, `lib/rmhmusic/history.ts`). Append-only: the
/// endpoints that already keep a result also write one entry, so a second, lower attempt at a song
/// leaves a trace the bests never keep. Nothing reads it but its owner. `kind` is `lesson`, `song`,
/// `sprint` or `cards`; `refId` is the lesson id, song id, sprint level (the date for the daily run) or
/// `cards`; `mode` is the song mode (`wait`/`play`) or the sprint mode (`daily`/`free`). `durationMs`
/// is null when the client did not say (the entry then counts as an activity, not as minutes).
model MusicPracticeEntry {
  id         BigInt   @id @default(autoincrement())
  userId     String
  kind       String   @db.VarChar(8)
  refId      String   @db.VarChar(80)
  mode       String?  @db.VarChar(8)
  score      Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, kind, refId, createdAt])
  @@map("music_practice_entry")
}
