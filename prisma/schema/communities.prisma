// ─── Communities ──────────────────────────────────────────────────────────
enum CommunityRole {
  MEMBER
  MOD
  ADMIN
}

model Community {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String   @db.VarChar(60)
  description       String?  @db.VarChar(500)
  color             String?  @db.VarChar(16) // accent color for the header
  icon              String?  @db.VarChar(8) // emoji
  isPrivate         Boolean  @default(false)
  memberCount       Int      @default(1)
  // Denormalized count of non-deleted posts, maintained on post create/delete so
  // the community page never runs COUNT(*) over rmheet. Backfilled in migration.
  postCount         Int      @default(0)
  // S2: posting requirement. level = none | email | account_age | member_age;
  // value = days (account_age) or minutes (member_age).
  verificationLevel String   @default("none") @db.VarChar(16)
  verificationValue Int      @default(0)
  // N1: every post in the community must carry a flair.
  flairRequired     Boolean  @default(false)
  // N2: ⭐ reactions needed for the hall of fame.
  starThreshold     Int      @default(5)
  // s03-13: joining needs the member to tick "I have read the rules".
  rulesRequireAgreement Boolean @default(false)
  // s03-14: members may read the content part of the moderation log.
  publicModLog      Boolean  @default(false)
  // s07-16: every image posted here needs a description.
  requireImageAlt   Boolean  @default(false)
  createdById       String
  createdAt         DateTime @default(now())
  /// Catalog id of the game/app this community is the home of (shown on that
  /// title's library page). Set by admins; no owner UI yet.
  gameId            String?  @db.VarChar(64)
  /// s10-17: an admin took the community out of discovery (directory, Explore, related rail, a game's
  /// communities, the sitemap, RSS, search). Members, the page and the feed are untouched. Null = discoverable.
  delistedAt        DateTime?
  delistedReason    String?  @db.VarChar(300)
  /// The admin who did it. A plain column: the audit log, not this column, is the record of who.
  delistedById      String?

  flairsP06            CommunityFlair[]
  starPostsP06         CommunityStarPost[]
  onboardingQsP06      CommunityOnboardingQuestion[]
  automodRulesP06      CommunityAutomodRule[]
  modItemsP06          CommunityModItem[]
  challengesP06        CommunityChallenge[]
  censusesP06          CommunityCensus[]
  contributorScoresP06 CommunityContributorScore[]
  sistersOutP06        CommunitySister[]             @relation("CommunitySisterFrom")
  sistersInP06         CommunitySister[]             @relation("CommunitySisterTo")
  rules                CommunityRule[]
  modActions           CommunityModAction[]
  memberEvents         CommunityMemberEvent[]
  handovers            CommunityHandover[]
  bans                 CommunityBan[]
  memberNotes          CommunityMemberNote[]
  recurringThreads     CommunityRecurringThread[]

  createdBy      User                    @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members        CommunityMember[]
  invites        CommunityInvite[]
  joinRequests   CommunityJoinRequest[]
  posts          RMHark[]
  announcements  CommunityAnnouncement[]
  calendarEvents Event[]                 @relation("CommunityEvents")
  communityPages CommunityPage[]
  groupCalls     GroupCall[]
  pinnedPosts    CommunityPinnedPost[]

  @@index([memberCount(sort: Desc)])
  @@index([gameId])
  @@map("community")
}

// Invite links for a private community. A holder of a valid code may join
// without approval. `code` is 128+ random bits (crypto.randomBytes, base64url);
// `uses` is incremented by a single conditional UPDATE so `maxUses` cannot be
// overshot by concurrent accepts. New high-volume-style table, so a time-sortable
// BigInt identity key (lib/CLAUDE.md new-table policy).
model CommunityInvite {
  id          BigInt    @id @default(autoincrement())
  communityId String
  createdById String
  code        String    @unique @db.VarChar(64)
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([createdById])
  @@map("community_invite")
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  DENIED
  // A moderator removed the member: the row is the marker that stops an invite
  // link or a request from putting them straight back (cooldown, then request).
  REMOVED
  // The requester withdrew: kept (rather than deleted) so cancel + re-request
  // cannot re-notify every moderator on demand (short cooldown).
  CANCELLED
}

// A request to join a private community, decided by its owner or a moderator.
// One row per (community, user): a re-request after a denial resets the row to
// PENDING once the cooldown has passed (see lib/communities/join-requests.server.ts).
model CommunityJoinRequest {
  id          BigInt                     @id @default(autoincrement())
  communityId String
  userId      String
  message     String?                    @db.VarChar(280)
  status      CommunityJoinRequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  // Matches the pending list (`WHERE communityId, status ORDER BY id`).
  @@index([communityId, status, id])
  @@index([userId])
  @@map("community_join_request")
}

// Mod/admin announcements pinned to the top of a community.
model CommunityAnnouncement {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  body        String   @db.VarChar(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation("CommunityAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt(sort: Desc)])
  @@map("community_announcement")
}

/// s09-06 — a post a moderator pinned to the top of a community (at most three, ordered by `position`, 0 leads).
/// A community's own arrangement of its content: the row never reaches a reader with the pinner's name on it.
model CommunityPinnedPost {
  communityId String
  postId      String
  position    Int
  pinnedById  String
  pinnedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post      RMHark    @relation("CommunityPinnedPostPost", fields: [postId], references: [id], onDelete: Cascade)
  pinnedBy  User      @relation("CommunityPinnedPostPinner", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@id([communityId, postId])
  @@index([communityId, position])
  @@index([postId])
  @@index([pinnedById])
  @@map("community_pinned_post")
}

model CommunityMember {
  id               String        @id @default(cuid())
  communityId      String
  userId           String
  role             CommunityRole @default(MEMBER)
  joinedAt         DateTime      @default(now())
  // N3: flairs this member follows (feed priority) and cosmetic role labels
  // granted by onboarding answers. Labels never carry permissions.
  followedFlairIds String[]      @default([])
  roleTags         String[]      @default([])
  // s03-13: when the member ticked the community's rules (set only on a join that agreed).
  rulesAcceptedAt  DateTime?
  /// s05-17: "off" (default) or "all" — notify this member of every new visible post in the community.
  postAlerts       String        @default("off") @db.VarChar(4)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  // The post-alert fan-out reads a community's opted-in members. Built CONCURRENTLY in its own migration.
  @@index([communityId, postAlerts])
  @@map("community_member")
}

/// s05-17 — one row per post whose new-post alerts have been claimed by the fan-out job (insert-if-absent), so a
/// retried or duplicated job never notifies twice. Not a member's data (no user column), so not exported or erased.
model CommunityPostAlertRun {
  postId    String   @id
  claimedAt DateTime @default(now())

  @@map("community_post_alert_run")
}

// ─── RMHEvents (§6) ────────────────────────────────────────────────────────
enum EventVenueKind {
  SPACE
  TOURNAMENT
  GAME
  URL
  IRL
}

// Lists & custom feeds (§3): user-curated lists of accounts, read as their own
// chronological timeline. PRIVATE by default; UNLISTED is link-shareable;
// PUBLIC is discoverable (phase 2 — schema-ready, UI-gated).
enum ListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/// Collaboratively edited community pages (F21).
///
/// Deliberately shaped like `GameGuide`/`GameGuideRevision` rather than as a
/// second revision system — which also means the anti-vandalism story is the
/// one already proven on guides.
model CommunityPage {
  id          String   @id @default(cuid())
  communityId String
  slug        String   @db.VarChar(60)
  title       String   @db.VarChar(120)
  body        String   @db.Text
  /// 'mods' | 'members' | 'trusted' (member 30d+ with no strikes)
  editPolicy  String   @default("mods") @db.VarChar(10)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  revisions CommunityPageRevision[]

  @@unique([communityId, slug])
  @@index([communityId, pinned])
  @@map("community_page")
}

model CommunityPageRevision {
  id        BigInt   @id @default(autoincrement())
  pageId    String
  editorId  String
  body      String   @db.Text
  summary   String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  page   CommunityPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor User          @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
  @@map("community_page_revision")
}

// ── P06: N1 N2 N3 N4 N5 N6 N7 N8 S2 ──

/// N1 — a flair a community's mods define. `color` is a token preset key
/// (accent | success | warning | danger | neutral), never a raw colour.
model CommunityFlair {
  id          String   @id @default(cuid())
  communityId String
  name        String   @db.VarChar(24)
  color       String   @default("accent") @db.VarChar(12)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  community Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts     CommunityPostFlair[]

  @@unique([communityId, name])
  @@index([communityId, position])
  @@map("community_flair")
}

/// N1 — the flair on a community post. A side table rather than a column on the
/// hot `rmheet` table, so the feed schema and its indexes are untouched.
model CommunityPostFlair {
  postId    String   @id
  flairId   String
  createdAt DateTime @default(now())

  post  RMHark         @relation(fields: [postId], references: [id], onDelete: Cascade)
  flair CommunityFlair @relation(fields: [flairId], references: [id], onDelete: Cascade)

  @@index([flairId])
  @@map("community_post_flair")
}

/// N2 — running count of ⭐ reactions on a community post, maintained by one
/// indexed upsert per reaction toggle. A post is "in the hall of fame" when
/// starCount >= community.starThreshold, evaluated at read time so a changed
/// threshold needs no backfill.
model CommunityStarPost {
  postId      String   @id
  communityId String
  starCount   Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  post      RMHark    @relation(fields: [postId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, starCount(sort: Desc)])
  @@map("community_star_post")
}

/// N3 — an onboarding question. `options` is a JSON array of
/// { id, label, roleTag?, flairIds[] }, validated in lib/communities/onboarding.ts.
model CommunityOnboardingQuestion {
  id          String   @id @default(cuid())
  communityId String
  position    Int      @default(0)
  prompt      String   @db.VarChar(140)
  options     Json
  createdAt   DateTime @default(now())

  community Community                   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  answers   CommunityOnboardingAnswer[]

  @@index([communityId, position])
  @@map("community_onboarding_question")
}

/// N3 — a member's answer (one option per question, once).
model CommunityOnboardingAnswer {
  id          String   @id @default(cuid())
  communityId String
  questionId  String
  userId      String
  optionId    String   @db.VarChar(40)
  createdAt   DateTime @default(now())

  question CommunityOnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([communityId, userId])
  @@map("community_onboarding_answer")
}

/// N4 — an AutoMod rule. `conditions` is JSON validated by lib/communities/automod.ts.
/// action = flag | hold | remove; appliesTo = posts | comments | both.
model CommunityAutomodRule {
  id          String   @id @default(cuid())
  communityId String
  name        String   @db.VarChar(60)
  enabled     Boolean  @default(true)
  appliesTo   String   @default("both") @db.VarChar(8)
  action      String   @db.VarChar(8)
  conditions  Json
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, position])
  @@map("community_automod_rule")
}

/// N4 — the community mod queue. HOLD items are hidden until a mod approves
/// them, FLAG items stay visible but are queued for a look, REMOVE items are the
/// log of content AutoMod refused. `payload` carries a held comment's body
/// (a held comment does not exist until approved); `snapshot` is a short text
/// preview for the queue.
model CommunityModItem {
  id           String    @id @default(cuid())
  communityId  String
  entityType   String    @db.VarChar(8)
  entityId     String?   @db.VarChar(64)
  postId       String?   @db.VarChar(64)
  authorId     String
  action       String    @db.VarChar(8)
  ruleName     String    @db.VarChar(60)
  snapshot     String    @db.VarChar(300)
  payload      Json?
  status       String    @default("PENDING") @db.VarChar(10)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("community_mod_item")
}

/// N5 — a weekly challenge. Submissions are open until submitEndsAt, voting
/// until voteEndsAt; a worker finalizes it (winner flair + notification).
model CommunityChallenge {
  id            String    @id @default(cuid())
  communityId   String
  title         String    @db.VarChar(80)
  prompt        String    @db.VarChar(1000)
  submitEndsAt  DateTime
  voteEndsAt    DateTime
  createdById   String
  winnerEntryId String?
  finalizedAt   DateTime?
  createdAt     DateTime  @default(now())

  community Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  entries   CommunityChallengeEntry[]

  @@index([communityId, createdAt(sort: Desc)])
  @@index([finalizedAt, voteEndsAt])
  @@map("community_challenge")
}

/// N5 — an entry: a community post submitted to a challenge (one per member).
model CommunityChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  postId      String
  userId      String
  voteCount   Int      @default(0)
  createdAt   DateTime @default(now())

  challenge CommunityChallenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  post      RMHark                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     CommunityChallengeVote[]

  @@unique([challengeId, userId])
  @@unique([postId])
  @@index([challengeId, voteCount(sort: Desc)])
  @@map("community_challenge_entry")
}

/// N5 — one vote per member per challenge.
model CommunityChallengeVote {
  id          String   @id @default(cuid())
  challengeId String
  entryId     String
  userId      String
  createdAt   DateTime @default(now())

  entry CommunityChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([entryId])
  @@map("community_challenge_vote")
}

/// N6 — a community census. `questions` is a JSON array of
/// { id, prompt, kind: single | multi, options: [{ id, label }] }.
model CommunityCensus {
  id            String    @id @default(cuid())
  communityId   String
  title         String    @db.VarChar(100)
  description   String?   @db.VarChar(500)
  questions     Json
  closesAt      DateTime?
  closedAt      DateTime?
  responseCount Int       @default(0)
  createdById   String
  createdAt     DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt(sort: Desc)])
  @@map("community_census")
}

/// N6 — "this member has answered". Deliberately holds no answers: the link
/// between a person and what they chose does not exist anywhere in the database.
model CommunityCensusParticipant {
  censusId  String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([censusId, userId])
  @@index([userId])
  @@map("community_census_participant")
}

/// N6 — aggregate tally per option; the only place answers are stored.
model CommunityCensusTally {
  censusId   String
  questionId String @db.VarChar(24)
  optionId   String @db.VarChar(24)
  count      Int    @default(0)

  @@id([censusId, questionId, optionId])
  @@map("community_census_tally")
}

/// N7 — per-community helpfulness score, rebuilt daily by a worker.
model CommunityContributorScore {
  communityId   String
  userId        String
  starPosts     Int      @default(0)
  challengeWins Int      @default(0)
  score         Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([communityId, score(sort: Desc)])
  @@map("community_contributor_score")
}

/// N8 — a one-way link from one community to a related one (mutual when the
/// other community links back). At most 5 per community, enforced in code.
model CommunitySister {
  communityId        String
  relatedCommunityId String
  position           Int      @default(0)
  createdAt          DateTime @default(now())

  community Community @relation("CommunitySisterFrom", fields: [communityId], references: [id], onDelete: Cascade)
  related   Community @relation("CommunitySisterTo", fields: [relatedCommunityId], references: [id], onDelete: Cascade)

  @@id([communityId, relatedCommunityId])
  @@index([relatedCommunityId])
  @@map("community_sister")
}

// ── P02 posts-plus: X4 X5 X8 X11 ──

/// X4 — a question-of-the-day prompt. `dayKey` (YYYY-MM-DD, UTC) is null while the
/// prompt waits in the admin queue and is stamped the first time its day is read;
/// an admin may also pre-assign a future day. Days with no row fall back to the
/// built-in list (lib/posts-plus/qotd-builtin.ts).
model QotdPrompt {
  id          String   @id @default(cuid())
  text        String   @db.VarChar(280)
  dayKey      String?  @unique @db.VarChar(10)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dayKey, createdAt])
  @@map("qotd_prompt")
}

/// X4 — links an ordinary post to the prompt of a day. The post stays a normal
/// RMHark; this row is what puts it in the day's thread.
model QotdAnswer {
  postId    String   @id
  userId    String
  dayKey    String   @db.VarChar(10)
  createdAt DateTime @default(now())

  post RMHark @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dayKey, createdAt(sort: Desc)])
  @@index([userId, dayKey])
  @@map("qotd_answer")
}

/// s03-13 — a community's written rules, in the order moderators set (position 0 first).
/// A removal or a report quotes the title as a copy, so deleting a rule never rewrites history.
model CommunityRule {
  id          String   @id @default(cuid())
  communityId String
  position    Int
  title       String   @db.VarChar(60)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, position])
  @@map("community_rule")
}

/// s03-14 — one row per community moderation action, written in the action's own
/// transaction by `logModAction`. Append-only. `actorId` / `targetUserId` are plain
/// columns (no relation to User): account deletion anonymises in place and nulls them.
model CommunityModAction {
  id           BigInt   @id @default(autoincrement())
  communityId  String
  actorId      String?
  /// A code from `MOD_ACTIONS` (lib/communities/modlog.ts), never English.
  action       String   @db.VarChar(32)
  targetUserId String?
  targetType   String?  @db.VarChar(16)
  targetId     String?  @db.VarChar(64)
  ruleId       String?
  ruleTitle    String?  @db.VarChar(60)
  reason       String?  @db.VarChar(300)
  detail       Json?
  createdAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt(sort: Desc)])
  @@index([communityId, actorId, createdAt])
  @@map("community_mod_action")
}

/// s03-15 — one row per membership change (join, leave, removed), written in the change's own
/// transaction by `recordMemberEvent`. Append-only; the Insights tab counts them. `userId` is a plain
/// column (no relation to User): account deletion anonymises in place and sets it to null, so the totals
/// stay right and nothing links a row to a person. Before the first row existed only joins can be known.
model CommunityMemberEvent {
  id          BigInt   @id @default(autoincrement())
  communityId String
  userId      String?
  /// join | leave | removed (`MEMBER_EVENT_KINDS` in lib/communities/insights.ts).
  kind        String   @db.VarChar(8)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@map("community_member_event")
}

/// s04-17 — an offer of a community from its owner to one of its moderators. One pending offer per
/// community (taken under an advisory lock in the offer transaction); it expires after 7 days (read as
/// expired, no job). `status`: pending | accepted | declined | cancelled. A community record, not exported.
model CommunityHandover {
  id          String    @id @default(cuid())
  communityId String
  fromId      String
  toId        String
  status      String    @default("pending") @db.VarChar(10)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  from      User      @relation("CommunityHandoverFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User      @relation("CommunityHandoverTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([communityId, status])
  @@index([toId, status])
  @@map("community_handover")
}

/// s06-01 — a ban or a timeout of one member of one community. At most one is active per member (a new one lifts the
/// old in the same transaction); expiry is read-time (`endsAt <= now()`), no job. `reason` is the moderators' private
/// note and is never sent to the member. `createdById` / `liftedById` are plain columns: erasure nulls them.
model CommunityBan {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  /// 'ban' | 'timeout'
  kind        String    @db.VarChar(8)
  /// Null = until a moderator lifts it (bans only).
  endsAt      DateTime?
  ruleId      String?
  reason      String?   @db.VarChar(300)
  createdById String?
  createdAt   DateTime  @default(now())
  liftedAt    DateTime?
  liftedById  String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("CommunityBanSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, userId, liftedAt])
  @@index([communityId, createdAt(sort: Desc)])
  @@map("community_ban")
}

/// s06-02 — a private moderator note on a member, scoped to one community. Ids are plain columns (no `User`
/// relation, like `CommunityModAction`); account deletion removes the notes about a member and nulls the author.
model CommunityMemberNote {
  id          String    @id @default(cuid())
  communityId String
  subjectId   String
  authorId    String?
  body        String    @db.VarChar(500)
  /// The sanction (`CommunityBan.id`) or mod-queue item it was written with.
  banId       String?
  modItemId   String?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, subjectId, createdAt(sort: Desc)])
  @@map("community_member_note")
}

/// s08-09 — a thread template a community's moderators set to post itself, weekly or monthly, at a local time in a
/// chosen time zone. Text only (title, body, flair). `nextAt` is the next occurrence in UTC; the minute cron moves
/// it to the following occurrence in a compare-and-set before it posts, so an occurrence is posted once. The
/// template posts as `createdById`, the moderator who last saved it.
model CommunityRecurringThread {
  id           String    @id @default(cuid())
  communityId  String
  createdById  String
  title        String    @db.VarChar(120)
  body         String    @db.VarChar(2000)
  /// Plain id (no relation): a flair deleted later just posts without one.
  flairId      String?   @db.VarChar(64)
  /// 'weekly' | 'monthly'
  cadence      String    @db.VarChar(8)
  /// 0 (Sunday) to 6, for a weekly template.
  weekday      Int?
  /// 1 to 28, for a monthly template.
  dayOfMonth   Int?
  /// Minutes after local midnight, 0 to 1439.
  minuteOfDay  Int
  timeZone     String    @db.VarChar(64)
  nextAt       DateTime
  active       Boolean   @default(true)
  /// Why a paused template stopped (a short code), null while active.
  pausedReason String?   @db.VarChar(32)
  lastPostId   String?
  lastPostedAt DateTime?
  failures     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CommunityRecurringThreadAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([active, nextAt])
  @@index([communityId])
  @@map("community_recurring_thread")
}
