// ─── PF2e team calendar (/pf2ecal) ─────────────────────────────────────────
// A private, unlisted scheduling board for one Pathfinder 2e table. Everything
// here is table-wide rather than per-owner: the page has no roles, so any
// signed-in account may create and edit. Authorship is recorded (`createdBy` /
// `updatedBy`) so the group can see who moved a session, not to gate anything.

/// How one player answers one session.
enum Pf2eAvailability {
  GOING
  TENTATIVE
  UNAVAILABLE
}

model Pf2eSession {
  id String @id @default(cuid())

  /// Set only on rows materialised from the recurring rule
  /// (`lib/pf2ecal/schedule.ts`), formatted `YYYY-MM-DD` in the campaign
  /// timezone. It is the idempotency key for that materialisation: the
  /// generator runs on every read, so without a unique key each read would
  /// insert the same session again. Null on a session someone added by hand,
  /// and `@unique` tolerates many nulls in Postgres, so one-off sessions do
  /// not collide with each other.
  occurrenceKey String? @unique @db.VarChar(16)

  title    String   @db.VarChar(120)
  notes    String   @default("") @db.VarChar(4000)
  startsAt DateTime
  endsAt   DateTime
  /// Free text — a VTT link, a house, "Zack's place". Rendered as a link only
  /// when it parses as an http(s) URL.
  location String   @default("") @db.VarChar(300)

  /// AI-written descriptions of this session, cached on the row.
  ///
  /// `blurbShort` is the line under the card, `blurbLong` the paragraph in the
  /// sheet. Both are derived from what a person typed — title, notes, location,
  /// when it runs — so `blurbKey` is a hash of exactly those inputs and a
  /// mismatch is what triggers a rewrite. Everything is null until the first
  /// reader asks for it: generating during materialisation would put a model
  /// call in the path of every page load, and the page has to be readable with
  /// no AI configured at all.
  blurbShort String?   @db.VarChar(240)
  blurbLong  String?   @db.VarChar(2000)
  blurbKey   String?   @db.VarChar(64)
  blurbAt    DateTime?

  /// AI summary of what happened, written from the `recaps` below once the
  /// session is over. Keyed like the blurbs: `recapKey` hashes the entries it
  /// was written from, so adding one more account of the night rewrites it and
  /// nothing else does.
  recapSummary String?   @db.VarChar(2000)
  recapKey     String?   @db.VarChar(64)
  recapAt      DateTime?

  /// Set instead of deleting, so the row keeps its responses and the .ics feed
  /// can publish STATUS:CANCELLED to calendars that already imported it.
  /// Deleting outright would silently leave the event on every subscriber's
  /// phone.
  canceledAt DateTime?

  /// True once a generated occurrence has been edited or answered. The
  /// materialiser skips rebuilding a session that anyone has touched, so
  /// changing the recurring rule never overwrites a session the table has
  /// already moved or RSVP'd to.
  pinnedToRule Boolean @default(true)

  /// When the Discord reminder for this session actually went out.
  ///
  /// The idempotency key for the reminder cron: the sweep runs every few
  /// minutes and would otherwise re-post the same reminder on every tick for
  /// the whole morning. Cleared when the session is moved to a different day,
  /// so rescheduling a night genuinely re-arms its reminder.
  reminderSentAt DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User?                 @relation("Pf2eSessionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("Pf2eSessionEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  responses     Pf2eSessionResponse[]
  recaps        Pf2eRecap[]
  announcements Pf2eAnnouncement[]

  /// The one read the page makes: a window of sessions in chronological order.
  @@index([startsAt])
  @@map("pf2e_session")
}

/// One person's account of what happened in a session.
///
/// Several per session on purpose rather than one shared text field: the GM
/// remembers the plot and a player remembers that their character nearly died,
/// and a single field means whoever types second overwrites the first. They are
/// also the raw material for `Pf2eSession.recapSummary` and for the assistant's
/// grounding, both of which are better with more than one account of the night.
model Pf2eRecap {
  id        String  @id @default(cuid())
  sessionId String
  authorId  String?

  body String @db.VarChar(4000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Pf2eSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User?       @relation("Pf2eRecapAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("pf2e_recap")
}

model Pf2eSessionResponse {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  status    Pf2eAvailability
  /// "can only make the first hour", "driving, might be late".
  note      String?          @db.VarChar(200)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session Pf2eSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One answer per player per session — the write is an upsert on this key.
  @@unique([sessionId, userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("pf2e_session_response")
}

model Pf2eAnnouncement {
  id     String  @id @default(cuid())
  body   String  @db.VarChar(2000)
  /// Pinned announcements sort above the rest and survive the "recent" cutoff.
  pinned Boolean @default(false)

  /// The session this note is about, when it is about one.
  ///
  /// Set automatically for a note the board writes after a change, and inferred
  /// from the text for one a person writes ("no game next Friday"). It is what
  /// makes `expiresAt` meaningful — the note is relevant until that night has
  /// been and gone, and then it is clutter.
  sessionId String?

  /// When this note stops being shown. Null means it stays until someone
  /// removes it, which is the right default for "read the recap first" and the
  /// wrong one for "we're starting an hour late on Wednesday".
  ///
  /// Pinned notes ignore it: pinning is an explicit "keep this up", and having
  /// a pin silently expire would be the more surprising of the two behaviours.
  expiresAt DateTime?

  /// True when the board wrote this itself, because a session was moved or
  /// called off and whoever did it left no note. Surfaced in the UI so nobody
  /// mistakes it for a person speaking.
  automated Boolean @default(false)

  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User?        @relation("Pf2eAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  session Pf2eSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([pinned, createdAt(sort: Desc)])
  /// The board read filters on this every time; without it that is a scan.
  @@index([expiresAt])
  @@map("pf2e_announcement")
}

/// Board-wide settings. Exactly one row, id `singleton`.
///
/// A single-row table rather than a config file because the group edits this
/// from the page: the webhook URL and the reminder time are theirs to change,
/// and a deploy should not be in the loop. The fixed id is what makes
/// `upsert` the only write path — there is no way to end up with two.
model Pf2eSettings {
  id String @id @default("singleton")

  /// A Discord incoming-webhook URL. Server-only: it is a bearer credential —
  /// anyone holding it can post to the channel — so it is NEVER returned to a
  /// client in full (`maskWebhookUrl` in `lib/pf2ecal/discord.server.ts` is
  /// what the API sends instead). The host is validated against Discord's own
  /// domains on write, so this column cannot become an arbitrary SSRF target.
  discordWebhookUrl String? @db.VarChar(500)

  /// Reminders are off until someone turns them on, even once a URL is saved:
  /// pasting a webhook should not immediately start posting to a channel.
  remindersEnabled Boolean @default(false)

  /// Minutes past local midnight to post the morning-of reminder. 540 = 9:00am.
  /// Stored as minutes rather than a time so the arithmetic in the cron is
  /// integer comparison and no timezone can creep into the stored value.
  reminderMinutes Int @default(540)

  /// The zone `reminderMinutes` is measured in — "morning" is meaningless
  /// without one, and the worker runs in UTC. IANA name, validated on write.
  reminderTimeZone String @default("America/New_York") @db.VarChar(64)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("Pf2eSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("pf2e_settings")
}
