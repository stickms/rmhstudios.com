/// A member's RMH Studio project saved to their account ("Save to account").
/// The id is the client's own project id (at most 64 characters), so the same project
/// is recognised on every device; an id owned by another member is refused, never reused.
/// `data` is the project JSON without audio (user samples stay on the device).
model StudioProject {
  id        String   @id @db.VarChar(64)
  userId    String
  name      String   @db.VarChar(80)
  data      Json
  /// Serialised size of `data` in bytes, so the list never has to read the blob.
  sizeBytes Int
  /// Bumped by every save; a save names the revision it was based on and a stale one is refused.
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions StudioProjectRevision[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("studio_project")
}

/// An earlier version of a cloud project: the `data` a save replaced (kept at most once per ten minutes,
/// up to 20 per project and 20 MB per member). `revision` is the project revision this data had.
/// `userId` is a plain column (no relation): erasure and the per-member byte cap read by it.
model StudioProjectRevision {
  id         String   @id @default(cuid())
  projectId  String   @db.VarChar(64)
  userId     String
  revision   Int
  name       String   @db.VarChar(80)
  data       Json
  sizeBytes  Int
  /// Number of tracks in `data`, computed at capture so the list never reads the blob.
  trackCount Int
  /// When this version was saved (the replaced row's `updatedAt`).
  savedAt    DateTime

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revision])
  @@index([userId, savedAt])
  @@map("studio_project_revision")
}
