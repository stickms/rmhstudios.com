  @@index([deletionScheduledAt])
  // Backs the "online now" fallback count (WHERE lastSeenAt >= cutoff). The
  // fast path is a Redis presence set; this keeps the DB fallback sane.
  @@index([lastSeenAt])
  @@map("user")
}

// One row per successfully attributed invite. `rewardedAt` is set when the
// mutual coin reward fires (on the referee's first achievement unlock, so
// throwaway signups earn nothing).
model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String    @unique
  code       String    @db.VarChar(32)
  createdAt  DateTime  @default(now())
  rewardedAt DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Coarse device family ("Chrome on macOS") — NOT a tracking identifier.
  /// A sign-in whose (userId, deviceFp) pair has never been seen triggers the
  /// new-device alert (B11). Deliberately low-entropy: the goal is "is this
  /// familiar to the account owner", not "is this the same physical machine".
  deviceFp  String?   @db.VarChar(80)
  /// Hashed via lib/hash-ip.server — raw addresses are never stored here.
  ipHash    String?   @db.VarChar(64)
  /// Set once the owner has been told about this device, so an alert fires at
  /// most once per device rather than on every session refresh.
  alertedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceFp])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  expiresAt             DateTime? // Re-added for Better Auth compatibility
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Web Push subscriptions — one row per browser/device a user enabled push on.
// Endpoint is globally unique; rows are removed when the push service reports
// the subscription gone (404/410) or the user disables push on that device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

// WebAuthn credentials for password-less sign-in (@better-auth/passkey).
// Field names/types follow the plugin's expected schema exactly.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ─── Security / Bug Bounty reports ────────────────────────────────────

enum SecurityReportStatus {
  NEW
  TRIAGING
  ACCEPTED
  RESOLVED
  DUPLICATE
  NOT_APPLICABLE
}

model SecurityReport {
  id            String               @id @default(cuid())
  title         String
  category      String
  severity      String
  affectedArea  String?
  description   String
  reporterName  String?
  reporterEmail String?
  status        SecurityReportStatus @default(NEW)
  adminNotes    String?
  // Set when the reporter was signed in; nullable for external researchers.
  userId        String?
  // SHA-256 of the client IP — abuse correlation without storing raw IPs.
  ipHash        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("security_report")
}

// ─── User Strikes ─────────────────────────────────────────────────────────
// A strike is the moderation penalty; the appeal columns below are the user's
// side of it. Before they existed a strike was admin-write-only — the punished
// user got a SYSTEM notification and had no way to see the record or contest
// it. `/settings/account-status` reads these; `/admin/appeals` writes them.
model UserStrike {
  id        String    @id @default(cuid())
  userId    String
  adminId   String
  reason    String    @db.VarChar(500)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // What the strike attached to, so the user's status page can link to the
  // content instead of just naming it. Same (entityType, entityId) vocabulary
  // ContentReport uses ('rmhark' | 'comment' | 'build' | 'user' | …).
  entityType String? @db.VarChar(32)
  entityId   String? @db.VarChar(64)

  // Set when the user opens their status page and sees this strike, so
  // moderators can tell "notified" from "acknowledged".
  acknowledgedAt DateTime?

  // ── Appeal (one per strike; NONE until the user files) ──
  appealStatus  AppealStatus @default(NONE)
  appealText    String?      @db.VarChar(2000)
  appealedAt    DateTime?
  appealNote    String?      @db.VarChar(1000) // moderator's decision note, shown to the user
  appealAdminId String? // reviewer who decided; null while PENDING
  decidedAt     DateTime?

  user        User  @relation("StrikeUser", fields: [userId], references: [id], onDelete: Cascade)
  admin       User  @relation("StrikeAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  appealAdmin User? @relation("StrikeAppealAdmin", fields: [appealAdminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  // Drives the admin appeal queue: open appeals oldest-first.
  @@index([appealStatus, appealedAt])
  @@map("user_strike")
}

/// Lifecycle of a strike appeal. NONE = never filed (the default for every
/// strike). OVERTURNED voids the strike — it stops counting toward the
/// three-strike auto-ban and is struck through on the user's status page.
enum AppealStatus {
  NONE
  PENDING
  UPHELD
  OVERTURNED
}

/// Single-use account recovery codes. Hashed at rest — a plaintext recovery
/// code is a password that never expires.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(200)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

/// People who can vouch for a recovery request.
model TrustedContact {
  id          String    @id @default(cuid())
  userId      String
  contactId   String
  /// The contact has to accept; an unconfirmed nomination cannot vouch.
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User @relation("TrustedContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("TrustedContactPerson", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([contactId])
  @@map("trusted_contact")
}

/// An in-flight account recovery. Deliberately slow: a mandatory delay and a
/// notification to every existing session, or this is a social-engineering
/// vector rather than a recovery path.
model RecoveryRequest {
  id         String   @id @default(cuid())
  userId     String
  /// PENDING | APPROVED | REJECTED | EXPIRED | USED
  status     String   @default("PENDING") @db.VarChar(12)
  approvals  Int      @default(0)
  /// Who has vouched, so nobody can vouch twice.
  approvedBy String[] @default([])
  tokenHash  String   @db.VarChar(200)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("recovery_request")
}

/// Handle history. An account can build trust as @alice and hand the handle
/// over; without this the history is gone.
model HandleChange {
  id        String   @id @default(cuid())
  userId    String
  oldHandle String   @db.VarChar(30)
  newHandle String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([oldHandle])
  @@map("handle_change")
}

// ─── Responsible play (W8, 2026-09-19) ────────────────────────────────────
// The guard rails every coin-risking surface on the site shipped without.
//
// The audit for `docs/plans/2026-09-19-next-phase-feature-ideas.md` grepped the
// tree for `selfExclu|age-gate|isAdult|over18` and found nothing: `/wager`,
// `/predictions`, `CoinStake`, `DailyWheelSpin` and the five casino tables ran
// with per-stake ceilings (`lib/wager/constants.ts`) and no per-DAY anything.
//
// Coins cannot be cashed out, which is why this is a small feature rather than
// an incident. It is not a reason to keep adding risk surfaces without it.

/// One row per member who has ever set a limit. Absent row = no limits, which
/// is why every read goes through `resolvePlayLimits()` rather than assuming a
/// row exists.
model UserPlayLimits {
  userId String @id

  /// Most coins this member may stake per rolling UTC day, across every risk
  /// surface. Null = no cap. Enforced in `debitCoinsOn` for `type: 'WAGER'`,
  /// which is the one chokepoint both the web tier and the socket tier share.
  dailyCoinCap Int?

  /// Set by the member; until it passes, every `WAGER` debit is refused and the
  /// risk surfaces are hidden from navigation and search. Deliberately NOT
  /// clearable early — see `play-limits.ts` for why the asymmetry is the
  /// feature rather than an inconvenience.
  selfExcludedUntil DateTime?

  /// A shorter, softer break. Same refusal, no navigation change.
  coolOffUntil DateTime?

  /// A LOOSENING waiting out its 24 hours. Tightening applies immediately and
  /// never lands here; only a change that would give the member more rope is
  /// parked, so that "raise my limit" can never be an impulse the site honours
  /// in the same minute it was typed.
  ///
  /// `pendingCap` is the requested new cap (null means "remove the cap"), and
  /// `pendingCapAt` is when it becomes effective. Both are cleared together,
  /// so `pendingCapAt != null` is the only test for "a change is in flight" —
  /// a null `pendingCap` is a meaningful request, not an empty slot.
  pendingCap   Int?
  pendingCapAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_play_limits")
}

// ── P11: G1 G2 G3 G4 F2 ──

/// Opt-in birthday (G1): month/day only, never a year. Row present = opted in.
model UserBirthday {
  userId           String   @id
  month            Int
  day              Int
  /// Last calendar year followers were nudged, so the daily job is idempotent.
  lastNotifiedYear Int?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month, day])
  @@map("user_birthday")
}
