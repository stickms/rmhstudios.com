  eventsHosted         CommunityEvent[] @relation("EventHost")
  eventRsvps           EventRsvp[]
  gameReplays          GameReplay[]
  marketListingsSold   MarketListing[]  @relation("MarketSeller")
  marketListingsBought MarketListing[]  @relation("MarketBuyer")
  sharedMoments        SharedMoment[]
  reminders            Reminder[]
  guestbookOwned       GuestbookEntry[] @relation("GuestbookOwner")
  guestbookSigned      GuestbookEntry[] @relation("GuestbookAuthor")

  // ─── Parity / QOL / customization (2026-07-20 design) ────────────────────
  saveFolders         SaveFolder[]
  savedItems          SavedItem[]
  historyEntries      HistoryEntry[]
  contentAwardsGiven  ContentAward[]
  wishlistEntries     WishlistEntry[]
  closeFriendsOwned   CloseFriend[]    @relation("CircleOwner")
  closeFriendOf       CloseFriend[]    @relation("CircleMember")
  userLists           UserList[]
  userListMemberships UserListMember[]
  feedSignals         FeedSignal[]
  gameReviews         GameReview[]
  gameReviewVotes     GameReviewVote[]
  gameGuides          GameGuide[]
  userThemes          UserTheme[]
