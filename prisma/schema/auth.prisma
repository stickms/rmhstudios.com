  /// immediately, but the anonymisation runs 30 days later — so a deletion at
  /// 2am in anger is recoverable by simply signing back in (B12).
  deletionScheduledAt DateTime?

  aiUsage    AiUsage[]
  activities Activity[]
  gameStats  GameStat[]

