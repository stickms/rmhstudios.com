  bulkOperations   BulkOperation[]
  recoveryCodes    RecoveryCode[]
  trustedContacts  TrustedContact[]        @relation("TrustedContactOwner")
  trustedFor       TrustedContact[]        @relation("TrustedContactPerson")
  recoveryRequests RecoveryRequest[]
  messageHides     DirectMessageHide[]
