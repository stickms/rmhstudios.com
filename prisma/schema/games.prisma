model LaundryPlayer {
  id          String   @id @default(uuid())
  username    String   @unique
  // Solo best. Versus scores are tracked separately below: the two modes run
  // different clocks and different pressure, so one board for both would be
  // meaningless.
  highScore   Int      @default(0)
  gamesPlayed Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt

  // Versus (multiplayer race) record, written by the socket hub on match end.
  versusWins   Int @default(0)
  versusPlayed Int @default(0)
  versusBest   Int @default(0)
  // Career stats, shown on the results screen and the leaderboard detail rows.
  bestCombo    Int @default(0)
  totalSorted  Int @default(0)

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_laundry_high_score")
  @@index([versusWins(sort: Desc)], map: "idx_laundry_versus_wins")
}

// Daily Puzzle Score — generic leaderboard for all daily puzzles including lights-out
model DailyPuzzleScore {
  id          String   @id @default(cuid())
  userId      String
  gameMode    String // lights-out | alibi | spectrum | outcast | chainlink | impostor | globeset
  dateKey     String // YYYY-MM-DD
  score       Int      @default(0) // points (higher = better) for most games
  moves       Int? // lights-out: move count (lower = better)
  hintUsed    Boolean? @default(false) // lights-out: whether hints were used
  dnf         Boolean? @default(false) // lights-out: did not finish; globeset: auto-solver used
  resultJson  Json? // game-specific result data
  timeSeconds Int? // time taken (for timed games); globeset: rank axis, lower is better
  createdAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameMode, dateKey])
  @@index([gameMode, dateKey, score(sort: Desc)])
  @@index([gameMode, dateKey, moves(sort: Asc)])
  // globeset ranks by time (lower = better), same shape as the moves index above.
  @@index([gameMode, dateKey, timeSeconds(sort: Asc)])
  @@map("daily_puzzle_score")
}

// GlobeSet's versus record — one row per player, written by the socket hub when
// a race finishes.
//
// An AGGREGATE rather than a match table, following `LaundryPlayer` (the other
// casual versus game on the same hub). GlobeSet races are ephemeral rooms with
// no ladder behind them, so a row per match would be unbounded growth nobody
// queries; what a player actually wants to know is how many they have run, how
// many they have won, and their best clear. The daily run is scored separately
// in `DailyPuzzleScore` — the two are different contests and one table for both
// would make neither number mean anything.
//
// Anonymous racers are first-class in a room (see `identity()` in
// `server/socket-server/handlers/globeset.ts`) and are deliberately NOT written
// here: their id is `guest:<socketId>`, which dies with the connection, so a
// row keyed on it could never be read back and would accumulate forever.
model GlobeSetPlayer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  racesPlayed Int  @default(0)
  racesWon    Int  @default(0)
  /// Fastest full clear in a race, in milliseconds. Null until one is finished
  /// — a forfeit and an unfinished race both leave it alone.
  bestRaceMs  Int?
  /// Career sets taken across every race. A volume number, not a skill one.
  setsFound   Int  @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([racesWon(sort: Desc)])
  @@map("globeset_player")
}

// Daily Puzzle content cache — the generated puzzle for a given mode + day.
// The first request for a (gameMode, dateKey) generates the puzzle (via the
// DeepSeek AI pipeline, falling back to the built-in deterministic generator)
// and stores it here; every later request for that day reads this row, so the
// puzzle is identical for everyone worldwide. The unique constraint makes the
// first writer win under concurrent first-requests.
model DailyPuzzle {
  id        String   @id @default(cuid())
  gameMode  String // alibi | spectrum | outcast | chainlink | impostor
  dateKey   String // YYYY-MM-DD (America/New_York)
  source    String   @default("deepseek") // deepseek | fallback
  data      Json // full puzzle payload, including the solution fields
  createdAt DateTime @default(now())

  @@unique([gameMode, dateKey])
  @@map("daily_puzzle")
}

// Slice It Player Model
model Player {
  id       String @id @default(cuid())
  username String @unique

  /// **Lifetime volume, not skill.** The sum of every score this account has
  /// ever submitted, incremented on every run forever.
  ///
  /// It is kept exactly as it was, and deliberately NOT repurposed: it is a real
  /// statistic ("how much have I played"), it is what the profile card shows,
  /// and rewriting its meaning under a shipped column would silently change
  /// every number already displayed. `skillRating` is the ranking axis; this is
  /// the odometer. See `lib/slice-it/ranking.server.ts`.
  totalScore  Int @default(0)
  gamesPlayed Int @default(0)

  /// R2 — the global skill rating. Best performance per **ranked** chart,
  /// weighted by the chart's computed rating (C3) and by accuracy, summed with
  /// geometric decay so the top ~50 dominate and grinding cannot substitute for
  /// playing well. Computed by `recomputeSkillRating()`.
  ///
  /// Zero means "never computed, or no scores on ranked charts" — the two are
  /// indistinguishable and do not need distinguishing, because both rank last.
  skillRating Float @default(0)

  /// How many ranked charts contributed to `skillRating`, so the board can show
  /// "42 ranked charts" beside the number and a player can tell a small rating
  /// from an unrecomputed one.
  rankedPlays Int @default(0)

  /// When `skillRating` was last recomputed. Null until the first recompute.
  /// The re-rate sweep uses it to find rows stale against a weight change.
  skillRatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The global skill board's only read: order by rating, page.
  @@index([skillRating(sort: Desc)])
}

model VegaPlayer {
  id           String   @id @default(uuid())
  username     String   @unique
  highestLoop  Int      @default(1)
  highestLevel Int      @default(1)
  gamesPlayed  Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestLoop(sort: Desc)], map: "idx_vega_loop")
  @@index([highestLevel(sort: Desc)], map: "idx_vega_level")
}

model SignalForgePlayer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String   @unique
  highScore     Int      @default(0)
  floorReached  Int      @default(1)
  gamesPlayed   Int      @default(1)
  savedRunState Json?
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Link to Auth User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_signal_forge_high_score")
  @@index([floorReached(sort: Desc)], map: "idx_signal_forge_floor")
}

model TempleOfJoySave {
  id        String   @id @default(cuid())
  userId    String   @unique
  saveData  Json
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("temple_of_joy_save")
}

/// The shared single-player save.
///
/// One row per (account, game) holding whatever that game's client serialises,
/// for the games that had no save table of their own — the alternative being
/// fifteen near-identical two-column models and fifteen near-identical routes.
/// Games that already have a table (Temple of Joy, Versecraft,
/// Synapse Storm, Signal Forge) keep it; there is nothing to gain from moving a
/// working save across a migration.
///
/// `gameId` is checked against `SHARED_SAVE_GAMES` in `lib/game-saves/registry`
/// before anything is written, so this cannot be used as a general key-value
/// store by anyone holding a session.
model GameSave {
  /// Time-sortable rather than `cuid()`, per the new-table policy: this is
  /// append-heavy and every read is by `(userId, gameId)` anyway.
  id        String   @id @default(uuid(7))
  userId    String
  gameId    String
  saveData  Json
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@map("game_save")
}

model NeonDriftwayPlayer {
  id           String   @id @default(uuid())
  username     String   @unique
  highScore    Int      @default(0)
  bestDistance Int      @default(0)
  bestTimeMs   Int      @default(0)
  bestLevel    Int      @default(1)
  gamesPlayed  Int      @default(1)
  updatedAt    DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_neon_driftway_high_score")
}

model NightrailPlayer {
  id             String   @id @default(uuid())
  username       String   @unique
  /// Best single-run score across every level.
  highScore      Int      @default(0)
  /// Furthest distance covered in one run, metres.
  bestDistance   Int      @default(0)
  /// Highest combo multiplier ever reached — the trick-skill number.
  bestMultiplier Int      @default(1)
  /// Highest level reached, so the level select can be restored per account.
  bestLevel      Int      @default(1)
  /// Runs that reached the finish line with cargo still aboard.
  runsFinished   Int      @default(0)
  gamesPlayed    Int      @default(1)
  updatedAt      DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_nightrail_high_score")
}

model VoidBreakerPlayer {
  id          String   @id @default(uuid())
  username    String   @unique
  highScore   Int      @default(0)
  bestWave    Int      @default(0)
  totalKills  Int      @default(0)
  bestTimeMs  Int      @default(0)
  gamesPlayed Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScore(sort: Desc)], map: "idx_void_breaker_high_score")
}

// ─── Dream Rift ───────────────────────────────────────────────────

model DreamRiftPlayer {
  id               String   @id @default(uuid())
  username         String   @unique
  highScoreEasy    Int      @default(0)
  highScoreNormal  Int      @default(0)
  highScoreHard    Int      @default(0)
  highScoreLunatic Int      @default(0)
  bestStage        Int      @default(1)
  character        String   @default("rei")
  gamesPlayed      Int      @default(1)
  totalGraze       Int      @default(0)
  spellsCaptured   Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([highScoreNormal(sort: Desc)], map: "idx_dream_rift_high_score")
  @@index([bestStage(sort: Desc)], map: "idx_dream_rift_best_stage")
}

// A single completed multiplayer (co-op) Dream Rift run. Powers the co-op
// leaderboards: highest combined squad score and longest time survived.
model DreamRiftCoopRun {
  id            String   @id @default(uuid())
  difficulty    String   @default("normal")
  combinedScore Int      @default(0)
  timeSurvived  Int      @default(0) // seconds the squad stayed alive
  stageReached  Int      @default(1)
  cleared       Boolean  @default(false)
  playerCount   Int      @default(2)
  // [{ name, charId, score }] for each squad member (host-submitted snapshot).
  players       Json
  hostUserId    String?
  hostUser      User?    @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([difficulty, combinedScore(sort: Desc)], map: "idx_dream_rift_coop_score")
  @@index([difficulty, timeSurvived(sort: Desc)], map: "idx_dream_rift_coop_time")
}

// ─── Gabriel's Horn ───────────────────────────────────────────────

// One row per account that has finished a game of Gabriel's Horn. Written
// fire-and-forget by the socket hub when hands are counted.
//
// Ranked on `wins` rather than `bestHand`: a two-card finish at a three-player
// table is not the same achievement as one at a six-player table, and a board
// that sorted on it would reward finding the smallest table. `bestHand` is a
// keepsake, and is null until a first game finishes (0 is a legitimate hand —
// an empty one — so it cannot double as "unset").
model GabrielsHornPlayer {
  id           String   @id @default(uuid())
  username     String   @unique
  gamesPlayed  Int      @default(0)
  wins         Int      @default(0)
  bestHand     Int?
  // Times this player sounded the horn, and times that call actually held.
  hornsSounded Int      @default(0)
  hornsWon     Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wins(sort: Desc)], map: "idx_gabriels_horn_wins")
}

// ─── Game playtime ────────────────────────────────────────────────────────
// Credited by POST /api/games/playtime (lib/playtime/playtime.server.ts): a
// client heartbeat while a catalog title's page is visible and in use. `gameId`
// is a catalog id (games and apps share one namespace). One row per user per
// title; the per-day table backs "last 2 weeks" and the Recent shelf.

model GamePlaytime {
  userId          String
  gameId          String   @db.VarChar(64)
  totalSeconds    Int      @default(0)
  /// Last accepted heartbeat. The crediting gap is measured from here.
  lastHeartbeatAt DateTime
  lastPlayedAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId, totalSeconds(sort: Desc)])
  @@map("game_playtime")
}

model GamePlaytimeDay {
  userId  String
  gameId  String   @db.VarChar(64)
  /// UTC calendar day.
  day     DateTime @db.Date
  seconds Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, day])
  @@index([userId, day])
  @@map("game_playtime_day")
}

model GameBadge {
  userId    String
  gameId    String   @db.VarChar(64)
  foil      Boolean  @default(false)
  level     Int      @db.SmallInt
  craftedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, foil])
  @@map("game_badge")
}

// A title in one of the member's game library collections ("favorites" is the reserved
// built-in one). A collection exists while it holds at least one title.
model GameCollectionItem {
  userId     String
  collection String   @db.VarChar(40)
  gameId     String   @db.VarChar(64)
  addedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, collection, gameId])
  @@map("game_collection_item")
}

// The achievements and badges a member chose to feature on their Steam-style
// profile (at most six of each). Empty means "show my most recent".
model GameProfileShowcase {
  userId         String   @id
  achievementIds String[] @default([])
  /// "<gameId>:<normal|foil>" keys of badges the member owns.
  badges         String[] @default([])
  /// Chosen profile background and avatar frame (keys unlocked by badges; see lib/games/customize.ts).
  background     String?  @db.VarChar(80)
  frame          String?  @db.VarChar(80)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_profile_showcase")
}

// Per-game Community Hub discussions (design:
// docs/superpowers/specs/2026-10-30-game-community-hub-design.md). Plain text only.
// `replyCount` and `lastPostAt` are maintained in the same transaction as the post.
model GameThread {
  id         String   @id @default(cuid())
  gameId     String   @db.VarChar(64)
  authorId   String
  title      String   @db.VarChar(120)
  body       String   @db.VarChar(4000)
  createdAt  DateTime @default(now())
  lastPostAt DateTime @default(now())
  replyCount Int      @default(0)
  locked     Boolean  @default(false)
  pinned     Boolean  @default(false)

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts  GameThreadPost[]

  @@index([gameId, pinned(sort: Desc), lastPostAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("game_thread")
}

model GameThreadPost {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  thread GameThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("game_thread_post")
}

// ═══════════════════════════════════════════════════════════════════════════
// Platform expansion (design: docs/plans/2026-07-19-platform-expansion-design.md)
// Twelve features specified as deltas over the shipped economy/quest/realtime
// systems. New tables only where a new noun exists; every coin flow still lands
// in CoinTransaction.
// ═══════════════════════════════════════════════════════════════════════════

// ─── Arcade Pass (§2) ──────────────────────────────────────────────────────
// One row per user tracking the cross-game daily-challenge streak. Challenge
// *definitions* and per-challenge progress are code-driven / reuse UserQuest
// (questId "a.<day>.<game>.<metric>"); only the streak needs storage.
model ArcadeStreak {
  userId    String   @id
  current   Int      @default(0)
  best      Int      @default(0)
  lastDay   String?  @db.VarChar(10) // UTC day key "2026-07-19"
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("arcade_streak")
}

// ─── Replays as content (§7) ───────────────────────────────────────────────
model GameReplay {
  id         String   @id @default(cuid())
  userId     String
  game       String   @db.VarChar(32)
  version    String   @db.VarChar(16) // game logic version for playback compat
  score      Int?
  durationMs Int
  data       Json // { seed, inputs } | { snapshots } — zod-validated per game
  sizeBytes  Int // enforced cap (e.g. 256 KB)
  visibility String   @default("public") @db.VarChar(8) // 'public' | 'unlisted'
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, score(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("game_replay")
}

// Game hubs (§6): per-game reviews, ratings, and player guides.
model GameReview {
  id        String   @id @default(cuid())
  userId    String
  gameId    String   @db.VarChar(40) // key from lib/games.ts
  stars     Int // 1..5 (zod)
  body      String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes GameReviewVote[]

  @@unique([userId, gameId])
  @@index([gameId, createdAt(sort: Desc)])
  @@map("game_review")
}

model GameReviewVote {
  reviewId String
  userId   String
  helpful  Boolean

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("game_review_vote")
}

model GameGuide {
  id        String   @id @default(cuid())
  authorId  String
  gameId    String   @db.VarChar(40)
  title     String   @db.VarChar(120)
  body      String // markdown, current revision
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  revisions GameGuideRevision[]

  @@index([gameId, published, updatedAt(sort: Desc)])
  @@map("game_guide")
}

model GameGuideRevision {
  id        String   @id @default(cuid())
  guideId   String
  body      String
  note      String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  guide GameGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, createdAt(sort: Desc)])
  @@map("game_guide_revision")
}

/// The default per-game stat row (C4).
///
/// `lib/game/adapters.server.ts` is right that rewriting the ~12 bespoke
/// `*Player` tables would be a large migration for no user benefit. The cost of
/// leaving it there is that every NEW scored game still needs a table, a
/// migration and an adapter. This is what a new game uses instead; the bespoke
/// adapters are untouched.
model GameStat {
  id        BigInt   @id @default(autoincrement())
  gameId    String   @db.VarChar(60)
  userId    String
  username  String?  @db.VarChar(60)
  score     Int      @default(0)
  progress  Int      @default(0)
  plays     Int      @default(1)
  /// Game-specific numeric extras, so a new game needs no migration at all.
  meta      Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId, score(sort: Desc)])
  @@map("game_stat")
}

// ─── Rebar & Rutabaga — reservations (W1, 2026-09-19) ─────────────────────
// The first piece of state behind any of the eleven /services and /ventures
// microsites. Before this the whole section was brochureware: a signed-in
// member and a search-engine crawler got the same page, and the one
// interactive control anywhere in it was a `mailto:`.
//
// The `mailto:` stays, for parties larger than the form takes — that was
// always the right path for those, and the component's comment says so.

/// One booked table. The rules these rows must satisfy live in
/// `lib/rebar-rutabaga/booking.ts` and are enforced in `.server.ts`.
model RebarReservation {
  id String @id @default(cuid())

  /// Null for a guest booking. The restaurant takes a table from anyone with an
  /// email; being a member gets you the booking in /notifications and a
  /// calendar file, not a better chance of a table.
  userId String?

  /// The LOCAL calendar day of the service, `YYYY-MM-DD` — not an instant.
  /// 17:30 is 17:30 in Gothenburg whether or not Sweden is on summer time that
  /// week, so storing a UTC instant would make the seating drift an hour twice
  /// a year. See the booking module's header.
  serviceDate String @db.VarChar(10)

  /// '17:30' | '20:45' — the two seatings the page prints.
  seating String @db.VarChar(5)

  partySize Int

  name  String @db.VarChar(80)
  email String @db.VarChar(160)

  /// Allergies and anything else the kitchen needs to know. The house's first
  /// policy is about allergies, so this is the field that policy acts on.
  note String? @db.VarChar(500)

  /// 'booked' | 'cancelled'. A string rather than an enum: the restaurant will
  /// grow 'seated' and 'no-show' when there is a host stand to record them,
  /// and each of those is a migration if this is an enum.
  status String @default("booked") @db.VarChar(16)

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The availability query: covers already booked for one service.
  @@index([serviceDate, seating, status])
  /// "My bookings", newest first.
  @@index([userId, createdAt(sort: Desc)])
  /// NOTE: the migration also adds a PARTIAL unique index —
  /// ("email", "serviceDate", "seating") WHERE status = 'booked' — so a
  /// double-submitted form cannot take two tables out of twenty-two, while a
  /// cancellation still frees the night to be re-booked. Prisma's DSL cannot
  /// express a filtered index, so it is hand-written in the migration and
  /// intentionally NOT mirrored here, exactly as
  /// `20260716000000_add_rmhark_feed_partial_index` documents. A local
  /// `prisma migrate dev` / `db push` may offer to DROP it — do not accept
  /// that drop; the uniqueness is what makes the insert safe under a race.
  @@map("rebar_reservation")
}

/// A Dunesday marathon plan (/dunesday) synced from the browser so a server
/// can act on it: a live calendar subscription, an RSS feed and Discord posts.
///
/// There is deliberately no user relation. The planner works signed out, and
/// a plan is addressed by two capabilities instead of an account:
///   - `feedId` (public, unguessable) — reads the calendar and RSS feeds, which
///     calendar apps and feed readers fetch with no cookies attached;
///   - the edit token — only its SHA-256 is stored; the browser keeps the token.
/// `state` is the same shape the browser keeps in localStorage, re-normalised
/// by `hydrateState` on every write, so a hostile client cannot store anything
/// the planner would not have produced itself.
model DunesdayPlan {
  id            String @id @default(cuid())
  feedId        String @unique @db.VarChar(32)
  editTokenHash String @db.VarChar(64)

  state Json

  /// IANA zone the plan's dates and nightly start time are read in. The worker
  /// runs in UTC, so "tonight" means nothing without it. Validated on write.
  timeZone String @default("UTC") @db.VarChar(64)

  /// A Discord incoming-webhook URL — a bearer credential, so it is never sent
  /// back to a client in full (see `maskWebhookUrl`) and its host is validated
  /// against Discord's own domains before it is stored.
  discordWebhookUrl String? @db.VarChar(500)
  /// Post "tonight's lineup" an hour before the nightly start time.
  discordDaily      Boolean @default(true)
  /// Post when titles are ticked off (and phases completed).
  discordProgress   Boolean @default(true)
  /// The name posts use ("Sam watched Iron Man"). Optional, user-written.
  discordName       String? @db.VarChar(40)
  /// The plan-zone date (YYYY-MM-DD) the daily lineup was last posted for —
  /// the idempotency key for the 10-minute sweep.
  lastDailyPostDate String? @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discordWebhookUrl, discordDaily])
  @@map("dunesday_plan")
}

/// One opened advent door per member per year (G2). The unique key is the
/// once-per-day guarantee; the coin grant is keyed off the row's identity.
model AdventClaim {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  door      Int
  coins     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, door])
  @@map("advent_claim")
}

// ── P07: E1 daily mutator, E2 backlog, E6 achievement guides, E10 patch notes, E11 rivals, E12 shared seeds ──

// One row per (player, daily | shared seed). kind 'daily': seedKey is the UTC
// day, the row is created when the attempt STARTS (score null) and the first
// finish is the one that counts. kind 'seed': seedKey is '<seed>:<variant>' and
// score is the player's best on that seed.
model ArcadeSeedRun {
  id         String    @id @default(cuid())
  kind       String    @db.VarChar(8)
  gameId     String    @db.VarChar(48)
  seedKey    String    @db.VarChar(64)
  userId     String
  score      Int?
  detail     Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, gameId, seedKey, userId])
  @@index([kind, gameId, seedKey, score(sort: Desc)])
  @@index([userId])
  @@map("arcade_seed_run")
}

// Backlog / play status per game. finishMinutes feeds the community median.
model GamePlayStatus {
  id            String   @id @default(cuid())
  userId        String
  gameId        String   @db.VarChar(64)
  status        String   @db.VarChar(16)
  finishMinutes Int?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, status])
  @@map("game_play_status")
}

// Admin-authored short patch notes; the client remembers the last version seen.
model GamePatchNote {
  id        String   @id @default(cuid())
  gameId    String   @db.VarChar(64)
  version   String   @db.VarChar(32)
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@unique([gameId, version])
  @@index([gameId, createdAt(sort: Desc)])
  @@map("game_patch_note")
}

// ── P19 canvas: Z5 community pixel canvas, X3 context notes ──
// One row per event; `state` is width*height bytes (one palette index per pixel)
// so a snapshot is a single read. The placement log is the history for the replay.
model CanvasEvent {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(80)
  width       Int
  height      Int
  cooldownSec Int
  startsAt    DateTime
  endsAt      DateTime
  state       Bytes
  createdById String
  createdAt   DateTime @default(now())

  placements CanvasPlacement[]
  cooldowns  CanvasCooldown[]

  @@index([startsAt])
  @@map("canvas_event")
}

model CanvasPlacement {
  id        Int      @id @default(autoincrement())
  eventId   String
  userId    String
  x         Int      @db.SmallInt
  y         Int      @db.SmallInt
  color     Int      @db.SmallInt
  createdAt DateTime @default(now())

  event CanvasEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, id])
  @@index([userId])
  @@map("canvas_placement")
}

// Last placement per member per event; the conditional upsert on this row is the cooldown gate.
model CanvasCooldown {
  eventId      String
  userId       String
  lastPlacedAt DateTime

  event CanvasEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("canvas_cooldown")
}

// A member-authored 4x4 Connections grid: groups = [{ label, items: [4] }] x 4.
// Counters are denormalised so the list never aggregates plays. dailyDate is the
// UTC day (YYYY-MM-DD) an admin scheduled this grid as the daily.
model ConnectionsGrid {
  id          String   @id @default(cuid())
  authorId    String
  title       String   @db.VarChar(80)
  groups      Json
  playCount   Int      @default(0)
  solveCount  Int      @default(0)
  ratingSum   Int      @default(0)
  ratingCount Int      @default(0)
  dailyDate   String?  @unique @db.VarChar(10)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  author User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  plays  ConnectionsPlay[]

  @@index([authorId, createdAt])
  @@index([hidden, createdAt])
  @@map("connections_grid")
}

// One play per member per grid. found = indices of the groups solved so far;
// status active | solved | failed (4 mistakes). Guesses are checked server-side.
model ConnectionsPlay {
  id        String   @id @default(cuid())
  gridId    String
  userId    String
  found     Json     @default("[]")
  mistakes  Int      @default(0)
  status    String   @default("active") @db.VarChar(8)
  rating    Int?
  updatedAt DateTime @updatedAt

  grid ConnectionsGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gridId, userId])
  @@index([userId])
  @@map("connections_play")
}

// ── P25 action: R5 ──
// One saved Neon Driftway livery per member, stored as its shareable code
// (`ND1-base-accent1-accent2-stripe`); the format is validated on write.
model NdwLivery {
  userId    String   @id
  code      String   @db.VarChar(40)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ndw_livery")
}

// ── P27 async-games: R11 R12 R13 R18 R21 ──
// R11: per-member career aggregates behind the Gabriel's Horn post-game table read.
// Claim times are summed in ms so "tell" = mean(lie claim) - mean(truth claim).
model GabrielsHornTableRead {
  id           String   @id @default(cuid())
  userId       String   @unique
  games        Int      @default(0)
  claims       Int      @default(0)
  lies         Int      @default(0)
  calls        Int      @default(0)
  callsCorrect Int      @default(0)
  lieClaimMs   Int      @default(0)
  truthClaimMs Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gabriels_horn_table_read")
}

// R12: one row per delivery route (pickup chunk -> drop-off chunk, world metres).
// The row carries the standing record; no coins are paid for holding it.
model VelumContract {
  id          String   @id @default(cuid())
  pickupX     Int
  pickupZ     Int
  dropX       Int
  dropZ       Int
  creatorId   String
  holderId    String?
  bestCentis  Int
  runs        Int      @default(1)
  createdAt   DateTime @default(now())
  recordSetAt DateTime @default(now())

  creator User  @relation("VelumContractMaker", fields: [creatorId], references: [id], onDelete: Cascade)
  holder  User? @relation("VelumContractHolder", fields: [holderId], references: [id], onDelete: SetNull)

  @@unique([pickupX, pickupZ, dropX, dropZ])
  @@index([recordSetAt(sort: Desc)])
  @@index([creatorId])
  @@index([holderId])
  @@map("velum_contract")
}

// R21: a Nightrail trick submitted for the week's vote. Nightrail records no
// replay, so the clip is the best combo's trick chain + score (bounded by the
// member's recorded high score). `week` is the UTC Monday, YYYY-MM-DD.
model NightrailTrick {
  id         String   @id @default(cuid())
  week       String   @db.VarChar(10)
  authorId   String
  level      Int
  score      Int
  multiplier Float
  chain      String[]
  votes      Int      @default(0)
  createdAt  DateTime @default(now())

  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  voteRows NightrailTrickVote[]

  @@unique([week, authorId])
  @@index([week, votes(sort: Desc)])
  @@map("nightrail_trick")
}

model NightrailTrickVote {
  trickId   String
  userId    String
  week      String   @db.VarChar(10)
  createdAt DateTime @default(now())

  trick NightrailTrick @relation(fields: [trickId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([trickId, userId])
  @@unique([week, userId])
  @@index([userId])
  @@map("nightrail_trick_vote")
}

// ─── Election watch rooms ──────────────────────────────────────────────

enum ElectionRoomVisibility {
  PUBLIC // listed in the lobby for its election day
  PRIVATE // unlisted: reachable only by its code
}

/// A watch room for an election night: a shared screen (layout + panes) with its own chat and
/// reactions. Chat and reactions are ephemeral (realtime bus only); what is stored is the room
/// itself so a link keeps working across deploys. Solo rooms are not stored at all (browser only).
/// The `code` is the capability: anyone holding it can read and chat; only the owner edits.
model ElectionRoom {
  id           String                 @id @default(cuid())
  code         String                 @unique @db.VarChar(12)
  name         String                 @db.VarChar(60)
  visibility   ElectionRoomVisibility @default(PRIVATE)
  ownerId      String
  /// The election day this room watches, YYYY-MM-DD.
  electionDate String                 @db.VarChar(10)
  /// Shared layout and panes — validated by lib/elections/room-config.ts before every write.
  config       Json
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  /// Rooms are not kept forever: swept after this (election day + a few days).
  expiresAt    DateTime

  owner User @relation("ElectionRoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([visibility, electionDate, expiresAt])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("election_room")
}

/// A friends league for election predictions: people join by code, each submits a painted map, and the
/// leaderboard scores everyone's calls against the races as they are called. No coins are involved.
/// The `code` is the capability to join; the board is visible to members only.
model ElectionLeague {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(12)
  name      String   @db.VarChar(60)
  /// The cycle being predicted: a year ("2026") or an election day (YYYY-MM-DD).
  cycle     String   @db.VarChar(10)
  ownerId   String
  createdAt DateTime @default(now())

  owner   User                   @relation("ElectionLeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ElectionLeagueMember[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("election_league")
}

model ElectionLeagueMember {
  id       String    @id @default(cuid())
  leagueId String
  userId   String
  /// race key -> "DEM" | "GOP" | "TOSS" (validated by lib/elections/leagues.ts before every write).
  picks    Json      @default("{}")
  pickedAt DateTime?
  joinedAt DateTime  @default(now())

  league ElectionLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User           @relation("ElectionLeagueMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("election_league_member")
}
