// ─── RMH Type Models ───────────────────────────────────────

model RmhTypeProfile {
  id               String               @id @default(cuid())
  userId           String
  difficulty       String               @default("medium")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalGamesPlayed Int                  @default(0)
  totalWins        Int                  @default(0)
  bestWpm          Float                @default(0)
  bestWpmAccuracy  Float                @default(0)
  avgWpm           Float                @default(0)
  bestAccuracy     Float                @default(0)
  avgAccuracy      Float                @default(0)
  totalCharsTyped  Int                  @default(0)
  totalTimeMs      Int                  @default(0)
  currentStreak    Int                  @default(0)
  bestStreak       Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  matches          RmhTypeMatchPlayer[]

  @@unique([userId, difficulty])
  @@index([difficulty, bestWpm(sort: Desc)])
  @@index([totalWins(sort: Desc)])
  @@map("rmhtype_profile")
}

model RmhTypeMatch {
  id            String               @id @default(cuid())
  roomId        String
  difficulty    String
  passageId     String
  passageLength String
  rounds        Int
  startedAt     DateTime             @default(now())
  endedAt       DateTime?
  durationMs    Int?
  winnerUserId  String?
  playerCount   Int
  isSolo        Boolean              @default(false)
  results       Json
  players       RmhTypeMatchPlayer[]

  @@index([startedAt(sort: Desc)])
  @@index([winnerUserId])
  @@map("rmhtype_match")
}

model RmhTypeMatchPlayer {
  id        String         @id @default(cuid())
  matchId   String
  match     RmhTypeMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profileId String
  profile   RmhTypeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  rank      Int
  wpm       Float
  accuracy  Float
  timeMs    Int
  score     Int
  wasWinner Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@unique([matchId, userId])
  @@index([profileId])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([wpm(sort: Desc)])
  @@map("rmhtype_match_player")
}

/// Per-key typing aggregates.
///
/// Aggregate ONLY, per single character, never ordered — so this table cannot
/// reconstruct anything that was typed. A bigram or sequence table could, and
/// no typing statistic is worth shipping a keylogger for.
model RmhTypeKeyStat {
  userId    String
  key       String   @db.VarChar(4)
  layout    String   @default("qwerty") @db.VarChar(16)
  attempts  Int      @default(0)
  errors    Int      @default(0)
  totalMs   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key, layout])
  @@map("rmhtype_key_stat")
}

/// Touch-typing course progress: one row per member and lesson, bests only.
///
/// `stars` is recomputed on the server from speed and accuracy
/// (`lib/rmhtype/lessons.ts`), never taken from a client. Lesson ids live in the
/// curriculum, not in a table, so a lesson can be reworded without a migration.
model RmhTypeLessonProgress {
  userId       String
  lessonId     String    @db.VarChar(32)
  bestWpm      Float
  bestAccuracy Float
  stars        Int
  attempts     Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("rmhtype_lesson_progress")
}

/// One member's attempt at one day's passage. The row is created by Start and is the
/// server's clock: `startedAt` is never rewritten, so the elapsed time is always
/// measured from the first Start. `day` is the UTC day, `YYYYMMDD`. `wpm`, `accuracy`
/// and `timeMs` stay null until a plausible Finish lands; a Finish past the window
/// sets `finishedAt` alone (did not finish).
model RmhTypeDailyEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String    @db.VarChar(8)
  passageId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  wpm        Float?
  accuracy   Float?
  timeMs     Int?

  @@unique([userId, day])
  @@index([day, wpm(sort: Desc)])
  @@map("rmhtype_daily_entry")
}

/// A member's best run on one passage, kept as a coarse progress curve so the next
/// attempt can race it. Positions only (characters reached per 250 ms) — no key
/// identities, no errors, nothing a key logger would want. At most 500 per member.
model RmhTypeGhost {
  userId    String
  user      User     @relation("RmhTypeGhosts", fields: [userId], references: [id], onDelete: Cascade)
  passageId String
  wpm       Float
  timeMs    Int
  samples   Int[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, passageId])
  @@index([userId, updatedAt])
  @@map("rmhtype_ghost")
}

/// A text a member keeps to practise (s10-05): up to 50 each, private to the owner, never on a board.
/// `bestWpm` / `bestAccuracy` / `runs` / `lastRunAt` are the member's own record on it. Editing the body
/// resets them and deletes the runs (and the `text:<id>` ghost, which lives in `rmhtype_ghost`).
model RmhTypeText {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("RmhTypeTexts", fields: [userId], references: [id], onDelete: Cascade)
  title        String    @db.VarChar(80)
  body         String    @db.VarChar(3000)
  bestWpm      Float?
  bestAccuracy Float?
  runs         Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  textRuns RmhTypeTextRun[]

  @@index([userId, updatedAt])
  @@map("rmhtype_text")
}

/// One finished run on a saved text; the newest 50 per text are kept (trimmed on insert).
model RmhTypeTextRun {
  id        String      @id @default(cuid())
  textId    String
  text      RmhTypeText @relation(fields: [textId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("RmhTypeTextRuns", fields: [userId], references: [id], onDelete: Cascade)
  wpm       Float
  accuracy  Float
  timeMs    Int
  createdAt DateTime    @default(now())

  @@index([textId, createdAt])
  @@index([userId])
  @@map("rmhtype_text_run")
}
