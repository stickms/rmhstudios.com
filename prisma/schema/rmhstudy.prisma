// ─── RMH Study Models ──────────────────────────────────────

model RmhStudyProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalFocusTimeMs  BigInt            @default(0)
  sessionsCompleted Int               @default(0)
  currentStreak     Int               @default(0)
  longestStreak     Int               @default(0)
  lastStudyDate     DateTime?
  /// Weekly focus goal in minutes (30 to 3,000); null when none is set.
  weeklyGoalMinutes Int?
  /// The member's IANA zone, sent on joining a room and validated by the hub; streak days are counted in it (UTC when null).
  timeZone          String?           @db.VarChar(40)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          RmhStudySession[]

  @@index([totalFocusTimeMs(sort: Desc)])
  @@index([sessionsCompleted(sort: Desc)])
  @@index([currentStreak(sort: Desc)])
  @@map("rmhstudy_profile")
}

model RmhStudySession {
  id            String          @id @default(cuid())
  profileId     String
  profile       RmhStudyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId        String
  roomId        String?
  focusTimeMs   Int
  breakTimeMs   Int
  sessionsInRun Int
  startedAt     DateTime        @default(now())
  endedAt       DateTime?

  @@index([profileId])
  @@index([userId])
  @@index([startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@map("rmhstudy_session")
}

/// RMHStudy flashcard deck (#31). Decks are personal but can be shared publicly.
model FlashcardDeck {
  id           String   @id @default(cuid())
  userId       String
  title        String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  isPublic     Boolean  @default(false)
  cardCount    Int      @default(0)
  // Set when this deck was cloned from a public deck (marketplace). Provenance +
  // the "you already added this deck" guard. Not a relation (the source may be
  // deleted); it just records the source deck id.
  clonedFromId String?
  /// When this copy last had nothing left pending from its source (set by clone, link and apply).
  sourceSyncedAt  DateTime?
  /// Set whenever an authored card is added, edited or deleted (not on reorder). `updatedAt` does not
  /// move for a card edit, so copies compare this with their `sourceSyncedAt`.
  cardsChangedAt  DateTime?
  /// "Tell me about updates": the copy's owner wants the deck page to show the author's changes.
  notifyUpdates   Boolean  @default(true)
  /// The owner's private folder for this deck (null: "No folder"). Never in a public payload.
  folderId     String?
  /// New cards a day for the owner (0-200); null = no daily limit, the per-session rule (s10-03). Owner only, never copied.
  newPerDay    Int?
  /// The owner's test date, a local YYYY-MM-DD (s10-03). Owner only, never copied.
  testDate     String?  @db.VarChar(10)
  /// The local day `extraNew` applies to ("Learn 10 more"); a different day means no extra.
  extraNewDay  String?  @db.VarChar(10)
  extraNew     Int      @default(0)
  /// The author lets people who study this deck suggest a corrected card; off for every deck until they turn it on (s10-04).
  acceptsSuggestions Boolean @default(false)
  /// The languages the owner's cards are written in (BCP 47, from `lib/study/listen.ts`), so Listen reads each side in its own voice (s11-17). Null: the site's language. Describes the cards, so a copy takes it; sync never changes it.
  frontLang    String?  @db.VarChar(16)
  backLang     String?  @db.VarChar(16)
  /// Set when a moderator took this deck down after a report (s12-16): it is no longer public and its owner cannot make it public again.
  moderatedAt  DateTime?
  /// Stars given to this public deck and how many members gave them (s12-08); the average is `ratingSum / ratingCount`. Written with the `DeckRating` row, in one transaction.
  ratingSum    Int      @default(0)
  ratingCount  Int      @default(0)
  /// Copies of this deck that exist now: counted when a clone is made and when a copy is deleted (s12-08).
  copyCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      DeckFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  cards       Flashcard[]
  testResults FlashcardTestResult[]
  suggestions DeckSuggestion[]
  editors     DeckEditor[]
  ratings     DeckRating[]

  @@index([userId])
  @@index([isPublic, updatedAt(sort: Desc)])
  @@index([userId, clonedFromId])
  @@index([userId, folderId])
  @@map("flashcard_deck")
}

/// One member's rating of one public deck (s12-08): 1 to 5 stars, changeable, no text. Who rated what is never shown.
model DeckRating {
  deckId    String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User          @relation("DeckRatings", fields: [userId], references: [id], onDelete: Cascade)

  @@id([deckId, userId])
  @@index([userId])
  @@map("deck_rating")
}

/// A member's private, one-level folder of decks: name, order and collapse state follow the member across devices.
model DeckFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(40)
  position  Int
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks FlashcardDeck[]

  @@index([userId, position])
  @@map("deck_folder")
}

model Flashcard {
  id         String   @id @default(cuid())
  deckId     String
  front      String   @db.Text
  back       String   @db.Text
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  /// basic | reversible | cloze | occlusion. An authored card (`sourceId` null) carries the
  /// kind the owner chose; generated siblings carry `reversible` (the reverse
  /// side), `cloze` (one per deletion index) or `occlusion` (one per mask). An authored
  /// cloze or occlusion row is never reviewed; its siblings are.
  kind       String   @default("basic") @db.VarChar(10)
  /// The authored card this row was generated from; null for an authored card.
  sourceId   String?
  /// The deletion (cloze cN) or mask (occlusion, the mask's stable `id`) a sibling hides; null otherwise.
  clozeIndex Int?
  /// On an authored occlusion card: `{ mode: 'hide-all' | 'hide-one', masks: [{ id, x, y, w, h, label }] }`, the
  /// rectangles over the front picture in picture-relative units (s09-03). Null on every other row.
  occlusion  Json?
  /// On a copied authored card: the source deck's card it came from, and the hash of that card's
  /// kind, front and back when it was copied or last synced. Null on cards the member wrote.
  originCardId String? @db.VarChar(30)
  originHash   String? @db.VarChar(64)
  /// The member's own key for an authored card, set through the developer API so a script can upsert by it.
  /// Unique per deck; null (the default) never collides.
  externalId   String? @db.VarChar(100)
  /// One optional picture per side of an authored card, each with the description a screen reader reads (s08-15).
  /// Generated siblings carry none: they read their source card's. A copy shares the object (same URL); the
  /// object is deleted only when no card references its URL any more.
  frontImageUrl String? @db.VarChar(500)
  frontImageAlt String? @db.VarChar(1000)
  backImageUrl  String? @db.VarChar(500)
  backImageAlt  String? @db.VarChar(1000)
  /// One optional sound per side of an authored card, with the transcript that is its text alternative and its length
  /// (s10-02). Private to the member who recorded it: a copy and deck sync never carry these columns, and no payload
  /// another member receives includes them. One stored object per side (no sharing, so no reference count).
  frontSoundUrl  String? @db.VarChar(500)
  frontSoundText String? @db.VarChar(500)
  frontSoundMs   Int?
  backSoundUrl   String? @db.VarChar(500)
  backSoundText  String? @db.VarChar(500)
  backSoundMs    Int?

  deck       FlashcardDeck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  source     Flashcard?           @relation("FlashcardSiblings", fields: [sourceId], references: [id], onDelete: Cascade)
  siblings   Flashcard[]          @relation("FlashcardSiblings")
  reviews    FlashcardReview[]
  reviewLogs FlashcardReviewLog[]
  /// Where an authored card came from when it was made from a reading highlight (s10-01); never copied with a deck.
  highlightLink HighlightCardLink?
  suggestions   DeckSuggestion[]

  @@index([deckId])
  @@index([sourceId])
  @@index([frontImageUrl])
  @@index([backImageUrl])
  @@index([frontSoundUrl])
  @@index([backSoundUrl])
  @@unique([deckId, externalId])
  @@map("flashcard")
}

/// Per-user spaced-repetition state for a card (SM-2). Lets several users study
/// the same (public) deck with independent schedules.
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Set aside by the member (`manual`) or after 8 lapses (`leech`); a suspended card is in no queue or due count.
  suspendedAt   DateTime?
  suspendReason String?   @db.VarChar(8)
  /// Grades of "Again" on a card that had already been learned (repetitions > 0).
  lapses        Int       @default(0)
  /// When the member last started this card over (the schedule reset, the log kept); null when never.
  resetAt       DateTime?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
  @@map("flashcard_review")
}

/// Append-only history of every review (grade and the schedule it produced), written in the
/// same transaction as the FlashcardReview update. Feeds /study/stats. `deckId` is copied
/// from the card so a per-deck query needs no join; it is not a relation.
model FlashcardReviewLog {
  id           BigInt   @id @default(autoincrement())
  userId       String
  cardId       String
  deckId       String
  grade        Int
  intervalDays Int
  easeFactor   Float
  reviewedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([userId, deckId, reviewedAt])
  @@index([userId, cardId, reviewedAt])
  @@map("flashcard_review_log")
}

/// A member's opt-in daily "cards are due" reminder (one row per member). `nextAt` is the UTC
/// instant of the next send, precomputed from `localTime` in `timeZone` so the per-minute sweep
/// reads only due rows. `lastSentDay` (the member's local day key) is the compare-and-set that
/// keeps it to one reminder a day; after 14 reminders with no review in between the reminder
/// pauses until the member resumes it.
model FlashcardReminder {
  userId          String   @id
  enabled         Boolean  @default(false)
  /// HH:MM on a 15-minute grid, read in `timeZone`.
  localTime       String   @db.VarChar(5)
  timeZone        String   @db.VarChar(64)
  nextAt          DateTime?
  lastSentDay     String?  @db.VarChar(10)
  sentSinceReview Int      @default(0)
  paused          Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextAt])
  @@map("flashcard_reminder")
}

/// One finished practice test (/study/$deckId/test): append-only, separate from SM-2 state, so
/// a test never changes a card's schedule. `total` and `correct` count points (one per question,
/// one per pair in a matching question). `seed` rebuilds the same questions.
model FlashcardTestResult {
  id            BigInt   @id @default(autoincrement())
  userId        String
  deckId        String
  total         Int
  correct       Int
  kinds         String[]
  durationMs    Int
  missedCardIds String[]
  seed          Int
  createdAt     DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, deckId, createdAt(sort: Desc)])
  @@map("flashcard_test_result")
}

/// F5 — a request to body-double. 'now' requests queue for ten minutes; 'slot'
/// requests are matched against others for the same subject, length and slot.
model StudyBuddyRequest {
  id         String   @id @default(cuid())
  userId     String
  subjectKey String   @db.VarChar(48)
  subject    String   @db.VarChar(60)
  lengthMin  Int
  mode       String   @db.VarChar(4) // 'now' | 'slot'
  startsAt   DateTime
  expiresAt  DateTime
  status     String   @default("waiting") @db.VarChar(10) // waiting | matched | expired | canceled
  matchId    String?  @db.VarChar(40)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, subjectKey, lengthMin, startsAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("study_buddy_request")
}

/// F5 — two members paired for a session. The room is created lazily by the
/// socket hub when the first of them joins `roomCode`, and only inside the
/// session window, so a no-show costs nothing.
model StudyBuddyMatch {
  id        String   @id @default(cuid())
  roomCode  String   @unique @db.VarChar(8)
  subject   String   @db.VarChar(60)
  lengthMin Int
  startsAt  DateTime
  endsAt    DateTime
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("StudyBuddyA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("StudyBuddyB", fields: [userBId], references: [id], onDelete: Cascade)

  @@index([userAId, startsAt])
  @@index([userBId, startsAt])
  @@map("study_buddy_match")
}

// ── P21: tools — F4 exam planner, F11 calculator notebooks, F15 marathon lists ──

// A saved RMHStudy exam plan. The day-by-day view is recomputed from these
// inputs (lib/rmhstudy/exam-planner.ts), so edits never leave a stale plan.
model StudyPlan {
  id             String   @id @default(cuid())
  userId         String
  title          String   @db.VarChar(120)
  examDate       String   @db.VarChar(10)
  topics         Json
  hoursByWeekday Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("study_plan")
}

// A plain-text RMHCalculator notebook; every line is evaluated on the client.
model CalcNotebook {
  id        String   @id @default(cuid())
  userId    String
  title     String   @db.VarChar(120)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("calc_notebook")
}

/// s15-08 — a graph a member saved from RMHCalculator's Graphing tab: the functions and domain they plotted and the
/// validated `GraphResult` the model returned, so reopening it needs no model call. `result` is stored only after
/// `graphResultSchema.safeParse` on the server and is never filtered on. At most 50 per member (`CALC_GRAPH_LIMIT`).
model CalcGraph {
  id        String   @id @default(cuid())
  userId    String
  title     String   @db.VarChar(80)
  functions String[]
  domainMin Float?
  domainMax Float?
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("calc_graph")
}

/// s10-01 — the reading highlight a flashcard was made from. Private bookkeeping for the card's owner: it names a
/// private highlight, so deck copies never carry it. Deleting either side removes the link (the card stays).
/// No `User` relation: both sides already belong to the member.
model HighlightCardLink {
  id          String   @id @default(cuid())
  cardId      String   @unique
  highlightId String
  createdAt   DateTime @default(now())

  card      Flashcard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  highlight ReadingHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([highlightId])
  @@map("highlight_card_link")
}

/// s10-04 — a member's proposed correction to the text of one card of someone else's deck. Private to the suggester and
/// the deck's author; no public read path. The author's decision is a compare-and-set on `status = 'open'`.
model DeckSuggestion {
  id            String    @id @default(cuid())
  deckId        String
  cardId        String
  suggesterId   String
  front         String    @db.Text
  back          String    @db.Text
  note          String?   @db.VarChar(500)
  /// The card's hash (kind, front, back, pictures) when the suggestion was made; a different current hash means "the card changed since".
  baseHash      String    @db.VarChar(64)
  /// open | accepted | declined | withdrawn
  status        String    @default("open") @db.VarChar(10)
  declineReason String?   @db.VarChar(200)
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card      Flashcard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  suggester User          @relation("DeckSuggestions", fields: [suggesterId], references: [id], onDelete: Cascade)

  @@index([deckId, status, createdAt])
  @@index([suggesterId, createdAt])
  @@index([cardId])
  @@map("deck_suggestion")
}

/// s11-10 — a member the deck's owner invited to add, edit and study cards with them. `pending` until the invitee accepts
/// (an invitation lapses after 14 days: read at request time, never swept). Only an `accepted` row gives access; the
/// owner is never a row. `invitedById` is the deck's owner when invited.
model DeckEditor {
  deckId      String
  userId      String
  invitedById String
  /// pending | accepted
  status      String    @default("pending") @db.VarChar(10)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user      User          @relation("DeckEditorOf", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User          @relation("DeckEditorInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([deckId, userId])
  @@index([userId, status])
  @@index([invitedById, status])
  @@map("deck_editor")
}
