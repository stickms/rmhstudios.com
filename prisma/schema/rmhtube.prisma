// ─── RmhTube Models ─────────────────────────────────────────

model RmhTubeRoom {
  id               String    @id // 6-char room code
  name             String?
  hostId           String
  isPublic         Boolean   @default(true)
  password         String?
  maxMembers       Int       @default(20)
  allowMemberQueue Boolean   @default(true)
  allowMemberSkip  Boolean   @default(true)
  autoPlay         Boolean   @default(true)
  // Settings the host can set that had no column: the hub held them in memory
  // only, so every restart silently reverted them to these defaults.
  queueVoting      Boolean   @default(false)
  autoSortByVotes  Boolean   @default(false)
  loopQueue        Boolean   @default(false)
  /// Empty = the room never chose any, so the default reaction set is used.
  customReactions  String[]  @default([])
  /// Pause the room while a member is buffering instead of leaving them behind.
  waitForSlowPeers Boolean   @default(true)
  scheduledFor     DateTime?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  closedAt         DateTime?

  host     User                 @relation("RmhTubeHostedRooms", fields: [hostId], references: [id])
  members  RmhTubeRoomMember[]
  messages RmhTubeChatMessage[]
  queue    RmhTubeQueueItem[]

  @@index([isPublic, closedAt])
  @@map("rmhtube_room")
}

model RmhTubeRoomMember {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  room RmhTubeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  // The social-presence fan-out asks "which of these online users are in a room"
  // (lib/presence.server.ts) on a per-viewer ~45s poll. `userId` leads no other
  // index — the unique above is (roomId, userId) — so that was a seq scan of the
  // whole membership table, twice per poll (this table and the RMHMusic one).
  @@index([userId, leftAt])
  @@map("rmhtube_room_member")
}

model RmhTubeChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  userName  String
  content   String
  replyToId String?
  createdAt DateTime @default(now())

  room    RmhTubeRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replyTo RmhTubeChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies RmhTubeChatMessage[] @relation("ChatReplies")

  @@index([roomId, createdAt])
  @@map("rmhtube_chat_message")
}

model RmhTubeQueueItem {
  id           String    @id @default(cuid())
  roomId       String
  url          String
  mediaType    String
  title        String
  duration     Int?
  thumbnailUrl String?
  addedById    String
  addedByName  String
  position     Int
  playedAt     DateTime?
  createdAt    DateTime  @default(now())

  room    RmhTubeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy User        @relation(fields: [addedById], references: [id])

  @@index([roomId, position])
  @@map("rmhtube_queue_item")
}

/// Channel subscription — subscribe to another user's RMHTube activity (#32).
model RmhTubeSubscription {
  id           String   @id @default(cuid())
  subscriberId String
  channelId    String
  createdAt    DateTime @default(now())

  subscriber User @relation("TubeSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel    User @relation("TubeChannel", fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, channelId])
  @@index([channelId])
  @@map("rmhtube_subscription")
}

/// (Formerly marked DEAD; it is read by lib/profile/app-profiles.server.ts, so it stays.)
model RmhTubeUserStats {
  userId                String   @id
  totalWatchTimeMinutes Int      @default(0)
  videosWatched         Int      @default(0)
  roomsCreated          Int      @default(0)
  roomsJoined           Int      @default(0)
  messagesSent          Int      @default(0)
  reactionsUsed         Int      @default(0)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("rmhtube_user_stats")
}

/// A user's saved, persistent playlist of media (music tracks or videos). The
/// apps build ephemeral room queues; this is the durable personal library.
model Playlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(100)
  kind      String   @default("video") @db.VarChar(16) // "video"; legacy "music" rows (retired app) are never read
  itemCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         PlaylistItem[]
  collaborators PlaylistCollaborator[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("playlist")
}

/// A non-owner who may add/remove items in someone's playlist. The owner (Playlist.userId)
/// is never a row here and stays the only one who can rename, delete or manage collaborators.
model PlaylistCollaborator {
  id         String   @id @default(cuid())
  playlistId String
  userId     String
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@index([userId])
  @@map("playlist_collaborator")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  position   Int      @default(0)
  externalId String   @db.VarChar(255) // e.g. Spotify uri / video id or url
  title      String   @db.VarChar(300)
  subtitle   String?  @db.VarChar(300) // artist / channel
  thumbnail  String?  @db.VarChar(500)
  url        String?  @db.VarChar(1000)
  durationMs Int?
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
  @@map("playlist_item")
}

// ── P20 watch parties: F1, F17, T3, T5 ──
// Comments pinned to a media timestamp, keyed by the media URL.
model RmhTubeTimedComment {
  id        String   @id @default(cuid())
  mediaUrl  String   @db.VarChar(1024)
  userId    String
  atSec     Int
  body      String   @db.VarChar(200)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaUrl, atSec])
  @@index([userId])
  @@map("rmhtube_timed_comment")
}

// A member's personal "watch later" queue.
model RmhTubeWatchLater {
  id        String   @id @default(cuid())
  userId    String
  url       String   @db.VarChar(1024)
  title     String   @db.VarChar(256)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, createdAt])
  @@map("rmhtube_watch_later")
}

// Reactions + rewinds per 10 s bucket of a media URL (batched in from the hub).
model RmhTubeHeatBucket {
  mediaUrl String @db.VarChar(1024)
  bucket   Int
  count    Int    @default(0)

  @@id([mediaUrl, bucket])
  @@map("rmhtube_heat_bucket")
}

// A recorded text commentary track: `lines` is [{ t: seconds, text }].
model RmhTubeCommentaryTrack {
  id        String   @id @default(cuid())
  mediaUrl  String   @db.VarChar(1024)
  userId    String
  title     String   @db.VarChar(80)
  lines     Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaUrl, createdAt])
  @@index([userId])
  @@map("rmhtube_commentary_track")
}
