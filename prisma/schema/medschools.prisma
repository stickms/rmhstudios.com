// ─── RMH Med Schools: anonymized US med school admissions-cycle data ──────────
//
// ANONYMIZATION RULE: no identifier of a person is stored in this file's public
// models. No username, display name, avatar, source user id, author or post text.
// Source dedupe keys are stored only as an HMAC (`MedCycleEvent.dedupeHash`).
// `features/medschools/engine/schema.test.ts` fails on any column named like
// `user*name|author|avatar|display`. Exactly three models carry their owner's
// `userId`: `MedTrackerCycle`, `MedSchoolList` and `MedUserPrefs` (phase 4; public
// endpoints never read them). `MedTrackerApplication`, `MedTrackerMilestone` and
// `MedSchoolListItem` reach their owner only through a parent, and an anonymous
// `MedCycleEvent` (source RMH) has no column that points at any of them.
//
// CYCLE YEAR is the ENTRY year, CycleTrack's convention: the 2026-2027 cycle is 2027.

enum MedDegree {
  MD
  DO
}

enum MedProgram {
  REG
  PHD
}

/// A step in a private tracker application. Only the seven public event types are ever shared.
enum MedMilestoneType {
  SUBMITTED
  COMPLETE
  SECONDARY
  INTERVIEW
  WAITLIST
  REJECTION
  ACCEPTANCE
  WITHDRAWN
  HOLD
}

/// A saved program preference: degree-neutral, `ALL` = every program.
enum MedProgramFilter {
  ALL
  REG
  PHD
}

/// A school list item's program. `ANY` = either; a plain value so the unique key is a plain unique.
enum MedListProgram {
  ANY
  REG
  PHD
}

enum MedEventType {
  SECONDARY
  INTERVIEW
  WAITLIST
  REJECTION
  ACCEPTANCE
  WITHDRAWN
  HOLD
}

/// Which applicant population a stats row describes. GLOBAL = all applicants.
enum MedResidence {
  GLOBAL
  IN_STATE
  OUT_OF_STATE
}

/// Where a figure came from. Alias rows never use `RMH`.
enum MedSource {
  CYCLETRACK
  ADMIT
  SDN
  MDAPPLICANTS
  RMH
}

enum MedRunStatus {
  RUNNING
  OK
  PARTIAL
  FAILED
}

enum MedRunTrigger {
  CRON
  MANUAL
  BOOTSTRAP
}

/// A US medical school (MD or DO). Rows are curated, never auto-created from a
/// source name; unmatched names go to `MedSchoolAliasMiss`.
model MedSchool {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  shortName       String
  degree          MedDegree
  city            String
  /// Two-letter state code.
  state           String
  country         String    @default("US")
  website         String?
  interviewFormat String?
  interviewType   String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  aliases             MedSchoolAlias[]
  counts              MedCycleCount[]
  events              MedCycleEvent[]
  stats               MedSchoolStats[]
  interviewQuestions  MedInterviewQuestion[]
  interviewProfiles   MedInterviewProfile[]
  sdnThreads          MedSdnThread[]
  trackerApplications MedTrackerApplication[]
  listItems           MedSchoolListItem[]

  @@index([degree, state])
  @@map("med_school")
}

/// How a source names a school (CycleTrack name, Admit slug, SDN thread stem or
/// thread id). Unique per (source, sourceKey).
model MedSchoolAlias {
  id        String    @id @default(cuid())
  schoolId  String
  source    MedSource
  sourceKey String
  createdAt DateTime  @default(now())

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([source, sourceKey])
  @@index([schoolId])
  @@map("med_school_alias")
}

/// A source name that matched no alias. Surfaced to the admin, never auto-created.
model MedSchoolAliasMiss {
  id               String    @id @default(cuid())
  source           MedSource
  sourceKey        String
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  seenCount        Int       @default(1)
  resolvedSchoolId String?
  /// Admin dismissed this name (not a US MD/DO school); it stays listed as ignored, never re-prompted.
  ignored          Boolean   @default(false)

  @@unique([source, sourceKey])
  @@map("med_school_alias_miss")
}

/// One application cycle's calendar. `dayZeroOn` is the start of day-of-cycle `d`;
/// for archive years without a known date it is June 1 of the application year
/// and `dateEstimated` is true.
model MedCycle {
  /// Entry year (2026-2027 → 2027).
  cycleYear      Int       @id
  amcasOpensOn   DateTime? @db.Date
  amcasSubmitOn  DateTime? @db.Date
  aacomasOpensOn DateTime? @db.Date
  dayZeroOn      DateTime  @db.Date
  dateEstimated  Boolean

  @@map("med_cycle")
}

/// The canonical activity fact: how many `eventType` events a school had on a
/// date, per source. Sources overlap and are NEVER summed.
/// `cycleYear` is deliberately not a foreign key: archive years (1998+) have no
/// `MedCycle` row.
model MedCycleCount {
  id           String       @id @default(cuid())
  schoolId     String
  program      MedProgram
  /// Entry year (2026-2027 → 2027).
  cycleYear    Int
  date         DateTime     @db.Date
  eventType    MedEventType
  source       MedSource
  count        Int
  /// Distinct-reporter count where known; null for CycleTrack (suppressed upstream).
  contributors Int?
  /// RMH rows only: the figures the PUBLIC pages show, copied from `count` / `contributors` once a day by the
  /// `medschools.rmh-publish` job and touched by nothing else. `count` / `contributors` follow the tracker live; a public
  /// reader that read them would show who shared a moment ago. Null (never published) = absent from every public read.
  publishedCount        Int?
  publishedContributors Int?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program, cycleYear, date, eventType, source])
  @@index([schoolId, cycleYear])
  @@index([cycleYear, date])
  @@map("med_cycle_count")
}

/// One anonymous event from a per-event source. No person fields.
model MedCycleEvent {
  id         String       @id @default(cuid())
  schoolId   String
  cycleYear  Int
  /// null = the source did not report the program; never defaulted to REG.
  program    MedProgram?
  eventType  MedEventType
  occurredAt DateTime
  source     MedSource
  /// HMAC-SHA256 of source + ':' + source id. Never the raw id.
  dedupeHash String       @unique
  inState    Boolean?
  ingestedAt DateTime     @default(now())

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([schoolId, cycleYear, program])
  @@map("med_cycle_event")
}

/// Published GPA/MCAT medians and ranges per school per cycle per program
/// (already suppressed upstream).
///
/// CYCLETRACK rows are per cycle. ADMIT rows are different: Admit's school stats
/// are cumulative across all reported cycles, refreshed daily, and stored under
/// the cycle current at fetch time as a snapshot. Readers must label them
/// "Admit.org, all reported cycles", never as a single-cycle figure. Admit rows
/// carry `program = null` (the source does not report it) and `contributors`
/// from the published count the figures rest on (null when absent).
model MedSchoolStats {
  id                        String       @id @default(cuid())
  schoolId                  String
  source                    MedSource    @default(CYCLETRACK)
  residence                 MedResidence @default(GLOBAL)
  /// null = the source did not report the program; never defaulted to REG.
  program                   MedProgram?
  cycleYear                 Int
  gpaMedian                 Float?
  gpaLow                    Float?
  gpaHigh                   Float?
  mcatMedian                Int?
  mcatLow                   Int?
  mcatHigh                  Int?
  interviewToAcceptancePct  Float?
  applicationToInterviewPct Float?
  applicationCount          Int?
  interviewCount            Int?
  admittedCount             Int?
  /// Published count the medians rest on; the read-time k>=3 floor applies to splits.
  contributors              Int?
  researchHours             Float?
  clinicalHours             Float?
  nonClinicalHours          Float?
  firstSecondaryOn          DateTime?    @db.Date
  firstInterviewOn          DateTime?    @db.Date
  firstAcceptanceOn         DateTime?    @db.Date
  sourceUpdatedAt           DateTime?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program, cycleYear, source, residence])
  @@index([schoolId, cycleYear, source])
  @@map("med_school_stats")
}

/// An interview question reported anonymously. No author; `dedupeHash` is a keyed
/// HMAC of the source and the source's own question id (Admit: 'ADMIT:question:'+id)
/// so re-ingest never duplicates.
model MedInterviewQuestion {
  id         String    @id @default(cuid())
  schoolId   String
  text       String
  source     MedSource
  votes      Int?
  cycleYear  Int?
  dedupeHash String    @unique
  ingestedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, source])
  @@map("med_interview_question")
}

/// One source's aggregate interview profile for a school (format, difficulty,
/// anonymous feedback lines).
model MedInterviewProfile {
  id               String    @id @default(cuid())
  schoolId         String
  source           MedSource
  format           String?
  fileType         String?
  avgDifficulty    Float?
  interviewCount   Int?
  feedbackPositive String[]
  feedbackNegative String[]
  feedbackBefore   String[]
  fetchedAt        DateTime
  interviewStyle   String?
  interviewLength  String?
  avgStress        Float?
  /// SDN only: mean of Positively = +1, No change = 0, Negatively = -1 over a school's reports.
  avgImpression    Float?
  inStateCount     Int?
  outOfStateCount  Int?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, source])
  @@map("med_interview_profile")
}

/// A public thread id and slug, not a person; `cursorPostHash` is an HMAC, never a raw post id.
/// `cycleYear` is always set: live threads take it from the forum, archive threads from the title label.
model MedSdnThread {
  threadId       Int       @id
  slug           String
  schoolId       String
  cycleYear      Int
  degree         MedDegree
  archive        Boolean   @default(false)
  repliesSeen    Int       @default(0)
  repliesDone    Int       @default(-1)
  lastActivityAt DateTime?
  cursorPage     Int       @default(1)
  cursorPostHash String?
  postsProcessed Int       @default(0)
  parkedAt       DateTime?
  failCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([archive, cycleYear])
  @@index([schoolId, cycleYear])
  @@map("med_sdn_thread")
}

/// Observability for the med schools worker's jobs, like `HomeScrapeRun`.
model MedSourceRun {
  id         String        @id @default(cuid())
  source     MedSource
  job        String
  trigger    MedRunTrigger
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     MedRunStatus
  stats      Json?
  error      String?

  @@index([source, job, startedAt])
  @@map("med_source_run")
}

// ─── Private tracker, school lists, preferences (phase 4) ──────────────────────
// Owner only, never read by a public endpoint, never an input to a public figure
// except through `features/medschools/api/share-sync.server.ts`, the one writer.

/// One applicant's cycle. `shareAnonymously` defaults OFF everywhere it is created.
model MedTrackerCycle {
  id               String   @id @default(cuid())
  userId           String
  /// Entry year (2026-2027 → 2027).
  cycleYear        Int
  homeState        String?  @db.VarChar(2)
  shareAnonymously Boolean  @default(false)
  /// Set when sharing is first switched on, never cleared. A cycle that never shared cannot own an event, so a delete
  /// there needs no secret (share-sync `rmhEventInPossibleCells` is skipped).
  everShared       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                    @relation("UserMedTrackerCycles", fields: [userId], references: [id], onDelete: Cascade)
  applications MedTrackerApplication[]

  @@unique([userId, cycleYear])
  @@index([userId])
  @@map("med_tracker_cycle")
}

/// A school applied to in a cycle. School and program never change (remove and add instead).
model MedTrackerApplication {
  id        String     @id @default(cuid())
  cycleId   String
  schoolId  String
  program   MedProgram
  notes     String?    @db.VarChar(1000)
  createdAt DateTime   @default(now())

  cycle      MedTrackerCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  school     MedSchool             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  milestones MedTrackerMilestone[]

  @@unique([cycleId, schoolId, program])
  @@index([schoolId])
  @@map("med_tracker_application")
}

/// One dated step. No column links it to its shared event: the event's hash is recomputed from the server secret.
model MedTrackerMilestone {
  id            String           @id @default(cuid())
  applicationId String
  type          MedMilestoneType
  /// A UTC calendar day.
  date          DateTime         @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application MedTrackerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@map("med_tracker_milestone")
}

/// A named school list. One, "My schools", is created on first use; at most 20 per user.
model MedSchoolList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(60)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation("UserMedSchoolLists", fields: [userId], references: [id], onDelete: Cascade)
  items MedSchoolListItem[]

  @@index([userId, position])
  @@map("med_school_list")
}

model MedSchoolListItem {
  id       String         @id @default(cuid())
  listId   String
  schoolId String
  program  MedListProgram @default(ANY)
  position Int
  note     String?        @db.VarChar(500)
  addedAt  DateTime       @default(now())

  list   MedSchoolList @relation(fields: [listId], references: [id], onDelete: Cascade)
  school MedSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([listId, schoolId, program])
  @@index([listId, position])
  @@index([schoolId])
  @@map("med_school_list_item")
}

/// Defaults that fill in only where the URL is silent.
model MedUserPrefs {
  userId          String           @id
  programFilter   MedProgramFilter @default(ALL)
  degree          MedDegree?
  homeState       String?          @db.VarChar(2)
  chartCategories MedEventType[]   @default([])
  updatedAt       DateTime         @updatedAt

  user User @relation("UserMedPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("med_user_prefs")
}
