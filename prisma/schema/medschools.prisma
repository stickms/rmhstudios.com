// ─── RMH Med Schools: anonymized US med school admissions-cycle data ──────────
//
// ANONYMIZATION RULE: no identifier of a person is stored in this file's public
// models. No username, display name, avatar, source user id, author or post text.
// Source dedupe keys are stored only as an HMAC (`MedCycleEvent.dedupeHash`).
// `features/medschools/engine/schema.test.ts` fails on any column named like
// `user*name|author|avatar|display`. Exactly three models carry their owner's
// `userId`: `MedTrackerCycle`, `MedSchoolList` and `MedUserPrefs` (phase 4; public
// endpoints never read them). `MedTrackerApplication`, `MedTrackerMilestone` and
// `MedSchoolListItem` reach their owner only through a parent, and an anonymous
// `MedCycleEvent` (source RMH) has no column that points at any of them.
//
// `MedForecast` and `MedWaitCurve` (phase 5) are aggregate-only: derived by the `medschools.forecast` job, no person or
// per-observation column. `MedWaitCurve` exists only where at least 20 distinct members contribute.
//
// CYCLE YEAR is the ENTRY year, CycleTrack's convention: the 2026-2027 cycle is 2027.

enum MedDegree {
  MD
  DO
}

enum MedProgram {
  REG
  PHD
}

/// A step in a private tracker application. Only the seven public event types are ever shared: SUBMITTED, COMPLETE and
/// SECONDARY_SUBMITTED never leave the private tables. SECONDARY reads "Secondary received" in the UI.
enum MedMilestoneType {
  SUBMITTED
  COMPLETE
  SECONDARY
  SECONDARY_SUBMITTED
  INTERVIEW
  WAITLIST
  REJECTION
  ACCEPTANCE
  WITHDRAWN
  HOLD
}

/// A saved program preference: degree-neutral, `ALL` = every program.
enum MedProgramFilter {
  ALL
  REG
  PHD
}

/// A school list item's program. `ANY` = either; a plain value so the unique key is a plain unique.
enum MedListProgram {
  ANY
  REG
  PHD
}

enum MedEventType {
  SECONDARY
  INTERVIEW
  WAITLIST
  REJECTION
  ACCEPTANCE
  WITHDRAWN
  HOLD
}

/// Which applicant population a stats row describes. GLOBAL = all applicants.
enum MedResidence {
  GLOBAL
  IN_STATE
  OUT_OF_STATE
}

/// Where a figure came from. Alias rows never use `RMH`.
enum MedSource {
  CYCLETRACK
  ADMIT
  SDN
  MDAPPLICANTS
  RMH
}

enum MedRunStatus {
  RUNNING
  OK
  PARTIAL
  FAILED
}

enum MedRunTrigger {
  CRON
  MANUAL
  BOOTSTRAP
}

/// A US medical school (MD or DO). Rows are curated, never auto-created from a
/// source name; unmatched names go to `MedSchoolAliasMiss`.
model MedSchool {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  shortName            String
  degree               MedDegree
  city                 String
  /// Two-letter state code.
  state                String
  country              String    @default("US")
  website              String?
  interviewFormat      String?
  interviewType        String?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  aliases              MedSchoolAlias[]
  counts               MedCycleCount[]
  events               MedCycleEvent[]
  stats                MedSchoolStats[]
  interviewQuestions   MedInterviewQuestion[]
  interviewProfiles    MedInterviewProfile[]
  sdnThreads           MedSdnThread[]
  admitForumThreads    MedAdmitForumThread[]
  trackerApplications  MedTrackerApplication[]
  listItems            MedSchoolListItem[]
  forecasts            MedForecast[]
  waitCurves           MedWaitCurve[]
  secondaryPrompts     MedSecondaryPrompt[]
  secondaryChecks      MedSecondaryCheck[]
  admissionsPolicies   MedSchoolAdmissionsPolicy[]
  secondaryTurnarounds MedSecondaryTurnaround[]

  @@index([degree, state])
  @@map("med_school")
}

/// How a source names a school (CycleTrack name, Admit slug, SDN thread stem or
/// thread id). Unique per (source, sourceKey).
model MedSchoolAlias {
  id        String    @id @default(cuid())
  schoolId  String
  source    MedSource
  sourceKey String
  createdAt DateTime  @default(now())

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([source, sourceKey])
  @@index([schoolId])
  @@map("med_school_alias")
}

/// A source name that matched no alias. Surfaced to the admin, never auto-created.
model MedSchoolAliasMiss {
  id               String    @id @default(cuid())
  source           MedSource
  sourceKey        String
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  seenCount        Int       @default(1)
  resolvedSchoolId String?
  /// Admin dismissed this name (not a US MD/DO school); it stays listed as ignored, never re-prompted.
  ignored          Boolean   @default(false)

  @@unique([source, sourceKey])
  @@map("med_school_alias_miss")
}

/// One application cycle's calendar. `dayZeroOn` is the start of day-of-cycle `d`;
/// for archive years without a known date it is June 1 of the application year
/// and `dateEstimated` is true.
model MedCycle {
  /// Entry year (2026-2027 → 2027).
  cycleYear      Int       @id
  amcasOpensOn   DateTime? @db.Date
  amcasSubmitOn  DateTime? @db.Date
  aacomasOpensOn DateTime? @db.Date
  dayZeroOn      DateTime  @db.Date
  dateEstimated  Boolean

  @@map("med_cycle")
}

/// The canonical activity fact: how many `eventType` events a school had on a
/// date, per source. Sources overlap and are NEVER summed.
/// `cycleYear` is deliberately not a foreign key: archive years (1998+) have no
/// `MedCycle` row.
model MedCycleCount {
  id           String       @id @default(cuid())
  schoolId     String
  program      MedProgram
  /// Entry year (2026-2027 → 2027).
  cycleYear    Int
  date         DateTime     @db.Date
  eventType    MedEventType
  source       MedSource
  count        Int
  /// Distinct-reporter count where known; null for CycleTrack (suppressed upstream).
  contributors Int?
  /// RMH rows only: the figures the PUBLIC pages show, copied from `count` / `contributors` once a day by the
  /// `medschools.rmh-publish` job and touched by nothing else. `count` / `contributors` follow the tracker live; a public
  /// reader that read them would show who shared a moment ago. Null (never published) = absent from every public read.
  publishedCount        Int?
  publishedContributors Int?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program, cycleYear, date, eventType, source])
  @@index([schoolId, cycleYear])
  @@index([cycleYear, date])
  @@map("med_cycle_count")
}

/// One anonymous event from a per-event source. No person fields.
model MedCycleEvent {
  id         String       @id @default(cuid())
  schoolId   String
  cycleYear  Int
  /// null = the source did not report the program; never defaulted to REG.
  program    MedProgram?
  eventType  MedEventType
  occurredAt DateTime
  source     MedSource
  /// HMAC-SHA256 of source + ':' + source id. Never the raw id.
  dedupeHash String       @unique
  inState    Boolean?
  ingestedAt DateTime     @default(now())

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([schoolId, cycleYear, program])
  @@map("med_cycle_event")
}

/// Published GPA/MCAT medians and ranges per school per cycle per program
/// (already suppressed upstream).
///
/// CYCLETRACK rows are per cycle. ADMIT rows are different: Admit's school stats
/// are cumulative across all reported cycles, refreshed daily, and stored under
/// the cycle current at fetch time as a snapshot. Readers must label them
/// "Admit.org, all reported cycles", never as a single-cycle figure. Admit rows
/// carry `program = null` (the source does not report it) and `contributors`
/// from the published count the figures rest on (null when absent).
model MedSchoolStats {
  id                        String       @id @default(cuid())
  schoolId                  String
  source                    MedSource    @default(CYCLETRACK)
  residence                 MedResidence @default(GLOBAL)
  /// null = the source did not report the program; never defaulted to REG.
  program                   MedProgram?
  cycleYear                 Int
  gpaMedian                 Float?
  gpaLow                    Float?
  gpaHigh                   Float?
  mcatMedian                Int?
  mcatLow                   Int?
  mcatHigh                  Int?
  interviewToAcceptancePct  Float?
  applicationToInterviewPct Float?
  applicationCount          Int?
  interviewCount            Int?
  admittedCount             Int?
  /// Published count the medians rest on; the read-time k>=3 floor applies to splits.
  contributors              Int?
  researchHours             Float?
  clinicalHours             Float?
  nonClinicalHours          Float?
  firstSecondaryOn          DateTime?    @db.Date
  firstInterviewOn          DateTime?    @db.Date
  firstAcceptanceOn         DateTime?    @db.Date
  sourceUpdatedAt           DateTime?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program, cycleYear, source, residence])
  @@index([schoolId, cycleYear, source])
  @@map("med_school_stats")
}

/// An interview question reported anonymously. No author; `dedupeHash` is a keyed
/// HMAC of the source and the source's own question id (Admit: 'ADMIT:question:'+id)
/// so re-ingest never duplicates.
model MedInterviewQuestion {
  id         String    @id @default(cuid())
  schoolId   String
  text       String
  source     MedSource
  votes      Int?
  cycleYear  Int?
  dedupeHash String    @unique
  ingestedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, source])
  @@map("med_interview_question")
}

/// One source's aggregate interview profile for a school (format, difficulty,
/// anonymous feedback lines).
model MedInterviewProfile {
  id               String    @id @default(cuid())
  schoolId         String
  source           MedSource
  format           String?
  fileType         String?
  avgDifficulty    Float?
  interviewCount   Int?
  feedbackPositive String[]
  feedbackNegative String[]
  feedbackBefore   String[]
  fetchedAt        DateTime
  interviewStyle   String?
  interviewLength  String?
  avgStress        Float?
  /// SDN only: mean of Positively = +1, No change = 0, Negatively = -1 over a school's reports.
  avgImpression    Float?
  inStateCount     Int?
  outOfStateCount  Int?

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, source])
  @@map("med_interview_profile")
}

/// A public thread id and slug, not a person; `cursorPostHash` is an HMAC, never a raw post id.
/// `cycleYear` is always set: live threads take it from the forum, archive threads from the title label.
model MedSdnThread {
  threadId       Int       @id
  slug           String
  schoolId       String
  cycleYear      Int
  degree         MedDegree
  archive        Boolean   @default(false)
  repliesSeen    Int       @default(0)
  repliesDone    Int       @default(-1)
  lastActivityAt DateTime?
  cursorPage     Int       @default(1)
  cursorPostHash String?
  postsProcessed Int       @default(0)
  parkedAt       DateTime?
  failCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([archive, cycleYear])
  @@index([schoolId, cycleYear])
  @@map("med_sdn_thread")
}

/// Observability for the med schools worker's jobs, like `HomeScrapeRun`.
model MedSourceRun {
  id         String        @id @default(cuid())
  source     MedSource
  job        String
  trigger    MedRunTrigger
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     MedRunStatus
  stats      Json?
  error      String?

  @@index([source, job, startedAt])
  @@map("med_source_run")
}

// ─── Private tracker, school lists, preferences (phase 4) ──────────────────────
// Owner only, never read by a public endpoint, never an input to a public figure
// except through `features/medschools/api/share-sync.server.ts`, the one writer.

/// One applicant's cycle. `shareAnonymously` defaults OFF everywhere it is created.
model MedTrackerCycle {
  id               String   @id @default(cuid())
  userId           String
  /// Entry year (2026-2027 → 2027).
  cycleYear        Int
  homeState        String?  @db.VarChar(2)
  shareAnonymously Boolean  @default(false)
  /// Set when sharing is first switched on, never cleared. A cycle that never shared cannot own an event, so a delete
  /// there needs no secret (share-sync `rmhEventInPossibleCells` is skipped).
  everShared       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                    @relation("UserMedTrackerCycles", fields: [userId], references: [id], onDelete: Cascade)
  applications MedTrackerApplication[]

  @@unique([userId, cycleYear])
  @@index([userId])
  @@map("med_tracker_cycle")
}

/// A school applied to in a cycle. School and program never change (remove and add instead).
model MedTrackerApplication {
  id        String     @id @default(cuid())
  cycleId   String
  schoolId  String
  program   MedProgram
  notes     String?    @db.VarChar(1000)
  createdAt DateTime   @default(now())

  cycle      MedTrackerCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  school     MedSchool             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  milestones MedTrackerMilestone[]

  @@unique([cycleId, schoolId, program])
  @@index([schoolId])
  @@map("med_tracker_application")
}

/// One dated step. No column links it to its shared event: the event's hash is recomputed from the server secret.
model MedTrackerMilestone {
  id            String           @id @default(cuid())
  applicationId String
  type          MedMilestoneType
  /// A UTC calendar day.
  date          DateTime         @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application MedTrackerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@map("med_tracker_milestone")
}

/// A named school list. One, "My schools", is created on first use; at most 20 per user.
model MedSchoolList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(60)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation("UserMedSchoolLists", fields: [userId], references: [id], onDelete: Cascade)
  items MedSchoolListItem[]

  @@index([userId, position])
  @@map("med_school_list")
}

model MedSchoolListItem {
  id       String         @id @default(cuid())
  listId   String
  schoolId String
  program  MedListProgram @default(ANY)
  position Int
  note     String?        @db.VarChar(500)
  addedAt  DateTime       @default(now())

  list   MedSchoolList @relation(fields: [listId], references: [id], onDelete: Cascade)
  school MedSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([listId, schoolId, program])
  @@index([listId, position])
  @@index([schoolId])
  @@map("med_school_list_item")
}

/// Defaults that fill in only where the URL is silent.
model MedUserPrefs {
  userId          String           @id
  programFilter   MedProgramFilter @default(ALL)
  degree          MedDegree?
  homeState       String?          @db.VarChar(2)
  chartCategories MedEventType[]   @default([])
  /// The program set (owner 2026-11-23): any of 'md', 'md-phd', 'do', 'do-phd'; empty means "not chosen", so the older
  /// `programFilter` and `degree` columns above still answer for rows written before this column existed.
  programs        String[]         @default([])
  updatedAt       DateTime         @updatedAt

  user User @relation("UserMedPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("med_user_prefs")
}

/// Admit.org members whose profile history has been ingested (or who could not be read), keyed by a hash only.
/// `memberHash` is HMAC(MEDSCHOOLS_DEDUPE_SECRET, 'ADMIT:member:' + user id), a different input from every event key, so
/// nothing here joins to `med_cycle_event`. The raw id lives in memory for one run and is never stored. State DONE =
/// history ingested or no profile; FAILED = the lookup failed (attempts counts them; the discovery skips a member at 3
/// until a week passes). Rows older than 400 days are pruned by the history job.
model MedAdmitMember {
  memberHash String   @id
  state      String   @default("DONE")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
  @@map("med_admit_member")
}

/// One Admit school-forum thread (a school's thread for one cycle on med.admit.org): a school and a cycle, never a person.
/// `cursorPostHash` is an HMAC of the last processed post's id, never the id; `cursorOffset` counts the posts consumed
/// (the next read starts one before it, so the anchor post is checked); `remoteCount` is the thread's post count at the
/// last look, so `remoteCount > cursorOffset` is the persisted "held" state while the model is paused. No post text,
/// author, username or avatar is stored anywhere.
model MedAdmitForumThread {
  id             String    @id @default(cuid())
  schoolId       String
  cycleYear      Int
  remoteCount    Int       @default(0)
  cursorOffset   Int       @default(0)
  cursorPostHash String?
  postsProcessed Int       @default(0)
  lastPostAt     DateTime?
  parkedAt       DateTime?
  failCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, cycleYear])
  @@index([cycleYear])
  @@map("med_admit_forum_thread")
}

/// Requests made to one source host (or one job's daily quota) on one UTC day, so a restart or a deploy does not reset
/// the day's budget. `key` is a host name ('ADMIT', 'SDN_FORUMS', ...) or a job quota ('ADMIT:history'); no person data.
model MedRequestBudget {
  key      String
  day      DateTime @db.Date
  requests Int      @default(0)

  @@id([key, day])
  @@map("med_request_budget")
}

// ─── Forecasts and wait curves (phase 5) ───────────────────────────────────────
// Written only by the `medschools.forecast` job. Neither model has a user column: a forecast is a function of the
// public, floored primary series, and a wait curve is an aggregate survival step function.

enum MedForecastMode {
  FULL
  EARLY
  NONE
}

/// One band per school x program x cycle x event type: the p10/p50/p90 path of the cumulative count to the cycle's end.
model MedForecast {
  id           String          @id @default(cuid())
  schoolId     String
  program      MedProgram
  /// Entry year (2026-2027 → 2027).
  cycleYear    Int
  eventType    MedEventType
  modelVersion Int
  mode         MedForecastMode
  /// The primary source the fit used; null when there was nothing to fit.
  source       MedSource?
  /// The last UTC day the model saw (yesterday at run time).
  asOf         DateTime        @db.Date
  computedAt   DateTime        @default(now())
  /// { days: number[], p10: number[], p50: number[], p90: number[] } from asOfDay to the cycle's last day.
  curve        Json
  /// { observed, meanShare, total, halfDay, basis }.
  summary      Json

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program, cycleYear, eventType])
  @@index([cycleYear])
  @@map("med_forecast")
}

/// A Kaplan-Meier survival step function (complete -> interview invite) for one school x program, from the tracker rows
/// of members who share. Exists only when at least 20 distinct members contribute; stores counts and the curve, nothing
/// about any one contribution.
model MedWaitCurve {
  id         String     @id @default(cuid())
  schoolId   String
  program    MedProgram
  asOf       DateTime   @db.Date
  computedAt DateTime   @default(now())
  /// Distinct members behind the curve (a count).
  members    Int
  invited    Int
  maxDay     Int
  /// { t: number[], s: number[] }
  curve      Json

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program])
  @@map("med_wait_curve")
}

// ─── Q&A limit requests (phase 6, R19) ─────────────────────────────────────────
// A member's request for a higher daily Q&A limit, reviewed by an admin (the pattern of LibraryQuotaRequest). Owner
// only. It holds the applicant's optional reason (at most 500 characters) and an admin's optional reply, NEVER a
// question or an answer. An APPROVED row is the grant itself: while it exists the member is in the `approved` tier.

enum MedQaLimitStatus {
  PENDING
  APPROVED
  DECLINED
  /// An admin withdrew an approval. Like a decline, it starts the 30-day wait before the member can ask again.
  REVOKED
}

/// At most one PENDING and at most one APPROVED row per member: partial unique indexes in the migration (Prisma cannot
/// express them), so two simultaneous submissions or approvals cannot both land.
model MedQaLimitRequest {
  id        String           @id @default(cuid())
  userId    String
  status    MedQaLimitStatus @default(PENDING)
  /// The applicant's optional reason. Not a question.
  note      String           @default("") @db.VarChar(500)
  /// An admin's optional reply, shown to the applicant.
  adminNote String           @default("") @db.VarChar(500)
  createdAt DateTime         @default(now())
  decidedAt DateTime?
  /// The deciding admin's user id, nulled when that admin's account is erased.
  decidedBy String?
  /// A revoke leaves the approval above intact and is recorded here; the 30-day wait starts from `revokedAt`.
  revokedAt  DateTime?
  /// The revoking admin's user id, nulled when that admin's account is erased.
  revokedBy  String?
  /// The revoking admin's optional reply, shown to the applicant.
  revokeNote String    @default("") @db.VarChar(500)

  user User @relation("UserMedQaLimitRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("med_qa_limit_request")
}

/// Where a secondary prompt was read. A new enum, not a value on `MedSource` (every `MedSource` map is exhaustive).
/// ADMIT and SDN are the two public pages (and SDN's forum posts, which ride the SDN value); SCHOOL is the school's own
/// page, a one-time curated import from `data/medschools/`, never a scraper.
enum MedPromptSource {
  ADMIT
  SDN
  SCHOOL
}

enum MedLimitKind {
  WORDS
  CHARS
}

enum MedCheckStatus {
  OK
  EMPTY
  UNAVAILABLE
}

/// One secondary-application prompt of one school and program, one row per normalised wording. Institutional text, not
/// personal data: no author, user, post or handle column, and no draft or note field (private essay drafts are not stored).
model MedSecondaryPrompt {
  id            String     @id @default(cuid())
  schoolId      String
  program       MedProgram
  /// `secondaryKey(text)`: the wording with limits, markers, case and punctuation removed.
  key           String
  text          String
  /// Keyword theme ids (`engine/secondaries/theme-ids.ts`), `THEMES_VERSION` says which rule table tagged them.
  themes        String[]
  themesVersion Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  school       MedSchool                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  observations MedSecondaryObservation[]

  @@unique([schoolId, program, key])
  @@index([schoolId])
  @@map("med_secondary_prompt")
}

/// A prompt seen in one cycle by one source. Never deleted: the history is the product.
model MedSecondaryObservation {
  id            String          @id @default(cuid())
  promptId      String
  /// Entry year: 2027 is the 2026-2027 cycle.
  cycleYear     Int
  source        MedPromptSource
  limitKind     MedLimitKind?
  limitValue    Int?
  optional      Boolean         @default(false)
  /// A school page or thread URL, never a post.
  sourceRef     String?
  firstSeenAt   DateTime        @default(now())
  lastCheckedAt DateTime

  prompt MedSecondaryPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, cycleYear, source])
  @@index([cycleYear])
  @@map("med_secondary_observation")
}

/// When each school and source page was last read and what it gave.
model MedSecondaryCheck {
  id          String          @id @default(cuid())
  schoolId    String
  source      MedPromptSource
  checkedAt   DateTime
  status      MedCheckStatus
  promptCount Int

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, source])
  @@map("med_secondary_check")
}

/// Whether a school decides on a rolling basis, per program: a fact read once from the school's own admissions page
/// (a curated import from `data/medschools/school-pages.json`, never a scraper). One row per school and program, only
/// where the page said something; `evidence` is the page's own sentence, verified verbatim. Institutional text, no person.
model MedSchoolAdmissionsPolicy {
  id        String          @id @default(cuid())
  schoolId  String
  program   MedProgram
  /// true = rolling decisions; false = decisions on set dates.
  rolling   Boolean
  evidence  String
  url       String
  checkedOn DateTime        @db.Date
  source    MedPromptSource @default(SCHOOL)

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program])
  @@map("med_school_admissions_policy")
}

/// Secondary turnaround (secondary received -> secondary submitted) per school x program, aggregated by the worker from
/// the tracker rows of members who share. Exists only when at least 20 distinct members contribute; stores counts and
/// whole-day quantiles, nothing about any one contribution.
model MedSecondaryTurnaround {
  id         String     @id @default(cuid())
  schoolId   String
  program    MedProgram
  asOf       DateTime   @db.Date
  computedAt DateTime   @default(now())
  /// Distinct members behind the figures (a count).
  members    Int
  p25Days    Int
  medianDays Int
  p75Days    Int

  school MedSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, program])
  @@map("med_secondary_turnaround")
}
