    "_tf2_melee": {
      "clips": {
        "idle": {
          "act": "^ACT_MP_STAND_MELEE$"
        },
        "walk": [
          {
            "act": "^ACT_MP_WALK_MELEE$",
            "pose": {
              "move_x": 1,
              "move_y": 0
            }
          },
          {
            "act": "^ACT_MP_RUN_MELEE$",
            "pose": {
              "move_x": 1,
              "move_y": 0
            }
          }
        ],
        "run": {
          "act": "^ACT_MP_RUN_MELEE$",
          "pose": {
            "move_x": 1,
            "move_y": 0
          }
        },
        "jump": {
          "act": "^ACT_MP_JUMP_START_MELEE$"
        },
        "fall": {
          "act": "^ACT_MP_JUMP_FLOAT_MELEE$",
          "loop": true
        },
        "shoot": {
          "act": "^ACT_MP_ATTACK_STAND_MELEE$"
        },
        "death": {
          "match": "^(death|dying|die)"
        }
      }
    }
