#!/bin/sh
# Logs the result of the network bring-up to the serial0 log once eth0 has an
# address or has clearly not got one. Never blocks the agent (it only delays
# the rest of the "local" service). The snapshot waits for this line so the
# saved machine has finished DHCP.
n=0
while [ "$n" -lt 60 ]; do
	addr=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}')
	if [ -n "$addr" ]; then
		printf 'rmhos-net: eth0 %s\n' "$addr" > /dev/ttyS0 2>/dev/null
		exit 0
	fi
	n=$((n + 1))
	sleep 1
done
printf 'rmhos-net: eth0 has no address\n' > /dev/ttyS0 2>/dev/null
exit 0
