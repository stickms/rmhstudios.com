#!/bin/sh
# Called before the guest goes away (the poweroff/reboot/halt wrappers, and the OpenRC stop script
# as a fallback): save the home folder into the 9p share, THEN announce the shutdown on serial1.
#
#   RMHOS SAVED_ON_POWEROFF <bytes>     the home is in /sync/home.tar of the share; the host stores
#                                       it as it would a SAVE reply, with no round trip
#   RMHOS POWEROFF                      the machine is going away (always sent, saved or not)
#
# Idempotent: the first caller does the work, later ones return at once, so a wrapper followed by
# the stop script announces once. Without a session there is nothing to save.
PORT=/dev/ttyS1
SHARE=/mnt/host
[ -e /run/rmhos-poweroff ] && exit 0
: >/run/rmhos-poweroff
user=$(cat /run/rmhos-session-user 2>/dev/null)
if [ -n "$user" ] && [ -d "/home/$user" ] && grep -q " $SHARE 9p " /proc/mounts 2>/dev/null; then
	# rmhos-save-home writes to a temporary name and renames under a lock: the agent's SAVE may be
	# writing the same file right now.
	if bytes=$(/usr/local/bin/rmhos-save-home "$user"); then
		printf 'RMHOS SAVED_ON_POWEROFF %s\n' "$bytes" >"$PORT" 2>/dev/null
	else
		printf 'rmhos-poweroff-save: could not tar /home/%s\n' "$user" >/dev/ttyS0 2>/dev/null
	fi
fi
printf 'RMHOS POWEROFF\n' >"$PORT" 2>/dev/null
exit 0
