#!/bin/sh
# Save a user's home folder into the 9p share as sync/home.tar. Used by BOTH writers, the agent's SAVE
# and rmhos-poweroff-save, which can run at the same moment (a SAVE in flight while the user powers off):
#
#   rmhos-save-home <user>     prints the archive's size in bytes and exits 0, or exits 1 (saves nothing)
#
# The archive is written to a temporary name in the SAME directory (unique per process, so two writers
# never share one) and renamed into place under an exclusive flock on a lock file in /run, so a reader
# never sees a half-written home.tar. The lock covers only the rename, never the tar, and the wait for
# it is BOUNDED (30 s, a `flock -n` retry loop: this busybox's flock has no -w): a wedged writer
# (a stalled 9p write) must not hang the other one, least of all the poweroff save, which has to go on
# to announce POWEROFF. Exit status: 0 saved (the size is printed), 1 failed, 2 the lock stayed held
# (the caller says "busy" / skips the save). Temporaries of dead writers are removed.
# The paths and the wait are overridable only so a host-side test can run this script
# (features/rmhos/__tests__).
SHARE=${RMHOS_SHARE:-/mnt/host}
HOMES=${RMHOS_HOMES:-/home}
WAIT=${RMHOS_SAVE_LOCK_WAIT:-30}
DIR=$SHARE/sync
ARCHIVE=$DIR/home.tar
LOCK=${RMHOS_RUN:-/run}/rmhos-save.lock
user=$1
[ -n "$user" ] && [ -d "$HOMES/$user" ] || exit 1
mkdir -p "$DIR" || exit 1
# A temporary left by a writer that no longer exists (the name ends in its pid).
for old in "$DIR"/.home.tar.*; do
	[ -e "$old" ] || continue
	pid=${old##*.}
	kill -0 "$pid" 2>/dev/null || rm -f "$old"
done
tmp=$DIR/.home.tar.$$
# exit 1 = a file changed while it was read (the desktop is still writing): the archive is
# complete, not a failure. Only 2 or more is "not saved". No lock is held while tar runs.
tar -cpf "$tmp" -C "$HOMES/$user" . 2>/dev/null
rc=$?
if [ "$rc" -gt 1 ]; then
	rm -f "$tmp"
	exit 1
fi
set -- $(wc -c <"$tmp")
bytes=$1
exec 9>"$LOCK" || {
	rm -f "$tmp"
	exit 1
}
tries=0
while ! flock -n 9; do
	tries=$((tries + 1))
	if [ "$tries" -gt "$WAIT" ]; then
		rm -f "$tmp"
		exit 2
	fi
	sleep 1
done
mv -f "$tmp" "$ARCHIVE" || {
	rm -f "$tmp"
	exit 1
}
printf '%s\n' "$bytes"
