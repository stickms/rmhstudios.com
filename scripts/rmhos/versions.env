# Pinned upstream inputs of the rmhOS image build (scripts/rmhos/build.sh).
# Bump a version and its sha256 together; the build fails on a mismatch.

# Linux, newest 6.12.y on https://cdn.kernel.org/pub/linux/kernel/v6.x/ at the
# time of the first build. sha256 from that directory's sha256sums.asc.
KERNEL_SERIES=6.12
KERNEL_VERSION=6.12.117
KERNEL_SHA256=74e99aa5e60e242e0a165fed8cb2ea0d054bf7a401f01861d403d75733456613

# Alpine userland. The minirootfs tarball is the base the packages are added to.
ALPINE_VERSION=3.22
ALPINE_ARCH=x86
ALPINE_MINIROOTFS_VERSION=3.22.8
ALPINE_MINIROOTFS_SHA256=8e30123124a53fde96125d4c45818f1c20adfcc32c7de7bfb0e3bc7c1b4d8f6e
