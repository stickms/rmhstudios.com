#: ../../developer-api/webhooks.md:1 e0880625f9864d8cba2fe7f24e3585a7
msgid "Webhooks"
msgstr "Webhook"

#: ../../developer-api/webhooks.md:3 7dac7122704d4d4d89ddf615e051bf37
msgid ""
"Subscribe a URL to receive HMAC-signed event deliveries when things "
"happen on your account. Manage subscriptions with the `manage:webhooks` "
"scope via `/api/v1/webhooks`."
msgstr ""
"订阅一个 URL，以便在你的账户上发生事件时接收带有 HMAC 签名的事件投递。通过 `/api/v1/webhooks` 并使用 "
"`manage:webhooks` 作用域来管理订阅。"

#: ../../developer-api/webhooks.md:5 93d29d4b89e444dab2e373714bba2ed4
#, python-brace-format
msgid ""
"curl -X POST https://rmhstudios.com/api/v1/webhooks \\\n"
"  -H \"Authorization: Bearer $RMH_KEY\" -H \"Content-Type: "
"application/json\" \\\n"
"  -d "
"'{\"url\":\"https://example.com/hook\",\"events\":[\"post.created\",\"follow.created\"]}'"
"\n"
"# → 201 { \"id\": \"wh_…\", \"secret\": \"whsec_…\", ... }   (secret "
"shown once)\n"
msgstr ""
"curl -X POST https://rmhstudios.com/api/v1/webhooks \\\n"
"  -H \"Authorization: Bearer $RMH_KEY\" -H \"Content-Type: "
"application/json\" \\\n"
"  -d "
"'{\"url\":\"https://example.com/hook\",\"events\":[\"post.created\",\"follow.created\"]}'"
"\n"
"# → 201 { \"id\": \"wh_…\", \"secret\": \"whsec_…\", ... }   (secret "
"shown once)\n"

